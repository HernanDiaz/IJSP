final/seed_quality.sh:1:#!/usr/bin/env bash
final/seed_quality.sh:2:# ¿GANA MIX PORQUE SUS SEMILLAS SON MEJORES, O PORQUE SON VARIADAS?
final/seed_quality.sh:3:# Se mide la CALIDAD DE LA POBLACION INICIAL que realmente recibe cada brazo,
final/seed_quality.sh:4:# leida del paso 0 de las trazas (evaluacion del propio repositorio, no la que
final/seed_quality.sh:5:# trae el pool). Dos numeros por brazo:
final/seed_quality.sh:6:#   mejor  = E[Cmax] del mejor individuo inicial
final/seed_quality.sh:7:#   media  = E[Cmax] medio de los 250 individuos iniciales
final/seed_quality.sh:8:# Si MIX arranca IGUAL o PEOR que v2/gp y aun asi termina mejor, la ventaja no
final/seed_quality.sh:9:# es calidad de semilla: es composicion del pool.
final/seed_quality.sh:10:cd "$(dirname "$0")/.."
final/seed_quality.sh:11:algo=${1:-tsn2}
final/seed_quality.sh:12:INSTS="tai20_20_05 tai30_15_07 tai30_20_01 tai50_15_04 tai50_20_09"
final/seed_quality.sh:13:ARMS="A0 V2H V2 MOR GT GP MIX"
final/seed_quality.sh:14:printf "%-14s %-5s %12s %12s\n" instancia brazo "mejor inicial" "media inicial"
final/seed_quality.sh:15:for inst in $INSTS; do
final/seed_quality.sh:16:  for arm in $ARMS; do
final/seed_quality.sh:17:    base="final/phase2/$algo/$inst/$arm"
final/seed_quality.sh:18:    if [ -n "$(ls -d "$base"/c* 2>/dev/null)" ]; then
final/seed_quality.sh:19:      fs=$(ls "$base"/c*/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar')
final/seed_quality.sh:20:    else
final/seed_quality.sh:21:      fs=$(ls "$base"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar')
final/seed_quality.sh:22:    fi
final/seed_quality.sh:23:    [ -z "$fs" ] && continue
final/seed_quality.sh:24:    # paso 0 de cada ejecucion: col 7+r*6+4 = Best Cmax, +5 = Avg Cmax
final/seed_quality.sh:25:    read -r b a <<< "$(for f in $fs; do
final/seed_quality.sh:26:      awk -F';' '/^Step;|^Generation;/{h=1;next} h && $1 ~ /^0$/ {
final/seed_quality.sh:27:        for (r=0;r<40;r++){ c=7+r*6+4; if (c+1<=NF && $c!="") printf "%s %s\n", $c, $(c+1) } exit }' "$f"
final/seed_quality.sh:28:      done | awk '{sb+=$1; sa+=$2; n++} END{ if(n) printf "%.1f %.1f", sb/n, sa/n }')"
final/seed_quality.sh:29:    printf "%-14s %-5s %12s %12s\n" "$inst" "$arm" "$b" "$a"
final/seed_quality.sh:30:  done
final/seed_quality.sh:31:  echo ""
final/seed_quality.sh:32:done
