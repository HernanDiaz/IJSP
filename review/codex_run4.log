final/fig_anytime_paper.R:1:# FIGURA DE CONVERGENCIA para el paper: RPD medio frente al tiempo, un panel por
final/fig_anytime_paper.R:2:# algoritmo, en la clase 50x20 (donde se concentra el efecto de la siembra).
final/fig_anytime_paper.R:3:#
final/fig_anytime_paper.R:4:# Dos cuidados metodologicos, ambos aprendidos a base de equivocarse antes:
final/fig_anytime_paper.R:5:#  1) SUPERVIVENCIA: si una instancia deja de aportar puntos al final de la
final/fig_anytime_paper.R:6:#     rejilla, la media SUBE artificialmente. Cada curva se extiende con su
final/fig_anytime_paper.R:7:#     ultimo valor hasta el final de la rejilla comun.
final/fig_anytime_paper.R:8:#  2) Solo se usan instancias presentes en TODOS los brazos comparados, para que
final/fig_anytime_paper.R:9:#     la media no cambie de composicion entre curvas.
final/fig_anytime_paper.R:10:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/fig_anytime_paper.R:11:algos <- c(ga = "GA", abce3 = "ABCE3", feabcls = "fEABCLS", tsn2 = "TSN2")
final/fig_anytime_paper.R:12:arms <- c(A0="Unseeded (A0)", V2H="Learned, half (V2H)", V2="Learned (V2)", MOR="MOR-eps", GT="GT-eps", GP="GP-eps", MIX="Mixed pool (MIX)")
final/fig_anytime_paper.R:13:cols <- c(A0="#000000", V2H="#0072B2", V2="#56B4E9", MOR="#E69F00", GT="#D55E00", GP="#009E73", MIX="#CC0000")
final/fig_anytime_paper.R:14:lwds <- c(A0=3.2, V2H=1.8, V2=1.8, MOR=1.8, GT=1.8, GP=1.8, MIX=3.2)
final/fig_anytime_paper.R:15:ltys <- c(A0=1, V2H=2, V2=1, MOR=4, GT=5, GP=3, MIX=1)
final/fig_anytime_paper.R:16:CLASS <- "50x20"
final/fig_anytime_paper.R:17:insts <- sprintf("tai50_20_%02d", 1:10)
final/fig_anytime_paper.R:18:
final/fig_anytime_paper.R:19:png("final/figs/anytime_50x20.png", width = 1700, height = 1250, res = 150)
final/fig_anytime_paper.R:20:par(mfrow = c(2, 2), mar = c(4.0, 4.3, 2.6, 1.0))
final/fig_anytime_paper.R:21:for (al in names(algos)) {
final/fig_anytime_paper.R:22:  f <- sprintf("final/phase2/anytime_%s.csv", al)
final/fig_anytime_paper.R:23:  if (!file.exists(f)) { plot.new(); title(paste(algos[[al]], "- sin datos")); next }
final/fig_anytime_paper.R:24:  d <- read.csv(f, stringsAsFactors = FALSE)
final/fig_anytime_paper.R:25:  d <- d[d$inst %in% insts & d$arm %in% names(arms), ]
final/fig_anytime_paper.R:26:  if (!nrow(d)) { plot.new(); title(paste(algos[[al]], "- sin datos")); next }
final/fig_anytime_paper.R:27:  d <- merge(d, lb, by = "inst")
final/fig_anytime_paper.R:28:  d$rpd <- 100 * (d$bestcmax - d$lb) / d$lb
final/fig_anytime_paper.R:29:  ok <- Reduce(intersect, lapply(names(arms), function(a) unique(d$inst[d$arm == a])))
final/fig_anytime_paper.R:30:  d <- d[d$inst %in% ok, ]
final/fig_anytime_paper.R:31:  grid_t <- sort(unique(d$t))
final/fig_anytime_paper.R:32:  curva <- function(a) {                       # media entre instancias, con extension
final/fig_anytime_paper.R:33:    sapply(grid_t, function(tt) {
final/fig_anytime_paper.R:34:      mean(sapply(ok, function(i) {
final/fig_anytime_paper.R:35:        s <- d[d$inst == i & d$arm == a & d$t <= tt, ]
final/fig_anytime_paper.R:36:        if (!nrow(s)) NA else s$rpd[which.max(s$t)]   # mejor conocido hasta tt
final/fig_anytime_paper.R:37:      }), na.rm = TRUE)
final/fig_anytime_paper.R:38:    })
final/fig_anytime_paper.R:39:  }
final/fig_anytime_paper.R:40:  M <- sapply(names(arms), curva)
final/fig_anytime_paper.R:41:  keep <- grid_t > 0 & is.finite(rowSums(M))
final/fig_anytime_paper.R:42:  plot(NA, xlim = range(grid_t[keep]), ylim = range(M[keep, ]),
final/fig_anytime_paper.R:43:       xlab = "CPU time (s)", ylab = "Mean RPD vs. lower bound (%)",
final/fig_anytime_paper.R:44:       main = sprintf("%s  (%s, n=%d)", algos[[al]], CLASS, length(ok)))
final/fig_anytime_paper.R:45:  grid(col = "grey90")
final/fig_anytime_paper.R:46:  for (a in names(arms)) lines(grid_t[keep], M[keep, a], col = cols[[a]], lty = ltys[[a]],
final/fig_anytime_paper.R:47:                               lwd = lwds[[a]])
final/fig_anytime_paper.R:48:  # Marcar las MUESTRAS REALES cuando la traza es gruesa. La rejilla de
final/fig_anytime_paper.R:49:  # remuestreo puede ser mucho mas fina que el intervalo de muestreo del
final/fig_anytime_paper.R:50:  # framework: en ABCE3 sobre 50x20 el presupuesto es de 60 s y hay 13 muestras
final/fig_anytime_paper.R:51:  # por ejecucion, de modo que una curva escalonada dibujada sobre una rejilla
final/fig_anytime_paper.R:52:  # de 0.2 s aparenta una resolucion temporal que el dato no tiene. Los puntos
final/fig_anytime_paper.R:53:  # muestran donde se conoce el valor de verdad.
final/fig_anytime_paper.R:54:  tr <- sprintf("final/phase2/a0_traces_%s.csv", al)
final/fig_anytime_paper.R:55:  if (file.exists(tr)) {
