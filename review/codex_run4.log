final/convergence.R:7:#
final/convergence.R:8:# 1. Se usaba como valor final el ULTIMO PUNTO DE LA CURVA promediada, que es
final/convergence.R:9:#    una instantanea de poblacion. Aqui el valor final es el DEVUELTO por el
final/convergence.R:10:#    solver (results_<algo>.csv).
final/convergence.R:11:#
final/convergence.R:12:# 2. Se aplicaba la regla a la curva PROMEDIADA sobre las 30 ejecuciones, lo
final/convergence.R:13:#    que puede ocultar que un subconjunto sigue mejorando. Aqui se evalua
final/convergence.R:14:#    EJECUCION A EJECUCION y se agrega con un criterio declarado (>=90%).
final/convergence.R:15:#
final/convergence.R:16:# 3. Solo se comprobaba el CONTROL. Una instancia en la que converge A0 no es
final/convergence.R:17:#    un experimento en el que hayan convergido todos los brazos: el brazo
final/convergence.R:18:#    sembrado puede seguir mejorando, que es precisamente lo que predice la
final/convergence.R:19:#    explicacion de "consolidacion lenta" del GA. Ademas, condicionar por el
final/convergence.R:20:#    comportamiento de A0 selecciona instancias usando el resultado de uno de
final/convergence.R:21:#    los dos comparandos. Aqui se comprueba CADA BRAZO y las comparaciones
final/convergence.R:22:#    restringidas se hacen sobre la INTERSECCION: instancias donde convergen a
final/convergence.R:23:#    la vez el control y el brazo con el que se compara.
final/convergence.R:24:#
final/convergence.R:25:# SENTIDO DEL SESGO RESIDUAL. v90 es el minimo acumulado en t <= 0.9T, que es
final/convergence.R:26:# >= al incumbente real en ese instante. La mejora medida es por tanto una cota
final/convergence.R:27:# SUPERIOR de la real: la regla puede declarar "no convergida" una celda que si
final/convergence.R:28:# converge, nunca al reves.
final/convergence.R:29:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/convergence.R:30:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/convergence.R:31:clases <- c("10x10","15x15","20x20","30x15","30x20","50x15","50x20")
final/convergence.R:32:arms <- c("A0","V2H","V2","MOR","GT","GP","MIX","MIXH")
final/convergence.R:33:seeded <- setdiff(arms, "A0")
final/convergence.R:34:UMBRAL <- 0.1     # % de mejora en el ultimo 10% del presupuesto
final/convergence.R:35:FRAC   <- 0.90    # fraccion de ejecuciones que deben cumplirla
final/convergence.R:36:
final/convergence.R:37:cl <- unique(read.csv("final/phase2/results_ga.csv", stringsAsFactors = FALSE)[, c("inst","clase")])
final/convergence.R:38:
final/convergence.R:39:# mejora por ejecucion de un (solver, brazo), con el valor final DEVUELTO
final/convergence.R:40:por_ejec <- function(al, arm) {
final/convergence.R:41:  suf <- if (arm == "A0") "" else paste0("_", arm)
final/convergence.R:42:  f <- sprintf("final/phase2/conv_runs_%s%s.csv", al, suf)
final/convergence.R:43:  if (!file.exists(f)) return(NULL)
final/convergence.R:44:  cv <- read.csv(f, stringsAsFactors = FALSE)
final/convergence.R:45:  rs <- read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE)
final/convergence.R:46:  rs <- rs[rs$arm == arm, c("inst","run","ecmax")]
final/convergence.R:47:  m <- merge(cv, rs, by = c("inst","run"))
final/convergence.R:48:  m$mejora <- 100 * (m$v90 - m$ecmax) / m$ecmax
final/convergence.R:49:  m
final/convergence.R:50:}
final/convergence.R:51:# clasificacion por instancia de un (solver, brazo)
final/convergence.R:52:clasifica <- function(m, u = UMBRAL, fr = FRAC) {
final/convergence.R:53:  a <- aggregate(list(ok = m$mejora < u), by = list(inst = m$inst), FUN = mean)
final/convergence.R:54:  data.frame(inst = a$inst, frac_ok = a$ok, conv = a$ok >= fr,
final/convergence.R:55:             stringsAsFactors = FALSE)
final/convergence.R:56:}
final/convergence.R:57:
final/convergence.R:58:datos <- list(); conv <- list()
final/convergence.R:59:for (al in names(algos)) {
final/convergence.R:60:  datos[[al]] <- list(); conv[[al]] <- list()
final/convergence.R:61:  for (a in arms) {
final/convergence.R:62:    m <- por_ejec(al, a)
final/convergence.R:63:    if (is.null(m)) next
final/convergence.R:64:    datos[[al]][[a]] <- m
final/convergence.R:65:    conv[[al]][[a]] <- clasifica(m)
final/convergence.R:66:  }
final/convergence.R:67:}
final/convergence.R:68:
final/convergence.R:69:cat("=== Regla de meseta por ejecucion, CONTROL (A0) ===\n")
final/convergence.R:70:cat(sprintf("    converge si >= %.0f%% de las 30 ejecuciones mejoran < %.1f%%\n\n", 100*FRAC, UMBRAL))
final/convergence.R:71:cat(sprintf("%-8s %-8s %6s %11s %11s   %s\n", "solver","clase","n","mejora med","% ejec ok","veredicto"))
final/convergence.R:72:for (al in names(algos)) {
final/convergence.R:73:  e <- merge(conv[[al]][["A0"]], cl, by = "inst")
final/convergence.R:74:  md <- aggregate(mejora ~ inst, data = datos[[al]][["A0"]], FUN = median)
final/convergence.R:75:  e <- merge(e, md, by = "inst")
final/convergence.R:76:  for (k in clases) {
final/convergence.R:77:    x <- e[e$clase == k, ]; if (nrow(x) == 0) next
final/convergence.R:78:    nc <- sum(x$conv)
final/convergence.R:79:    cat(sprintf("%-8s %-8s %6d %10.3f%% %10.0f%%   %s\n", algos[[al]], k, nrow(x),
final/convergence.R:80:        median(x$mejora), 100*mean(x$frac_ok),
final/convergence.R:81:        if (nc == nrow(x)) "converge" else sprintf("*** %d/%d ANYTIME-ONLY ***", nrow(x)-nc, nrow(x))))
final/convergence.R:82:  }
final/convergence.R:83:  cat("\n")
final/convergence.R:84:}
final/convergence.R:85:
final/convergence.R:86:cat("=== celdas anytime-only del control ===\n")
final/convergence.R:87:tot <- 0
final/convergence.R:88:for (al in names(algos)) {
final/convergence.R:89:  n <- sum(!conv[[al]][["A0"]]$conv); tot <- tot + n
final/convergence.R:90:  cat(sprintf("  %-8s %2d de 61\n", algos[[al]], n))
final/convergence.R:91:}
final/convergence.R:92:cat(sprintf("  TOTAL: %d de %d celdas de control\n\n", tot, 4*61))
final/convergence.R:93:
final/convergence.R:94:cat("=== Convergencia de CADA BRAZO, no solo del control ===\n")
final/convergence.R:95:cat(sprintf("  %-8s %s\n", "solver", paste(sprintf("%7s", arms), collapse="")))
final/convergence.R:96:for (al in names(algos)) {
final/convergence.R:97:  v <- sapply(arms, function(a) if (is.null(conv[[al]][[a]])) NA else sum(conv[[al]][[a]]$conv))
final/convergence.R:98:  cat(sprintf("  %-8s %s\n", algos[[al]], paste(sprintf("%7s", v), collapse="")))
final/convergence.R:99:}
final/convergence.R:100:cat("  (numero de las 61 instancias en que ese brazo cumple la regla)\n\n")
final/convergence.R:101:
final/convergence.R:102:cat("=== Comparacion restringida a la INTERSECCION (convergen A0 y el brazo) ===\n")
final/convergence.R:103:inter <- data.frame()
final/convergence.R:104:for (al in names(algos)) {
final/convergence.R:105:  r <- merge(read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE),
final/convergence.R:106:             lb, by = "inst")
final/convergence.R:107:  r$rpd <- 100*(r$ecmax - r$lb)/r$lb
final/convergence.R:108:  cA <- conv[[al]][["A0"]]
final/convergence.R:109:  cat(sprintf("\n  %s\n", algos[[al]]))
final/convergence.R:110:  cat(sprintf("    %-5s %6s %10s %10s %9s\n", "brazo", "n ambos", "A0", "brazo", "dif"))
final/convergence.R:111:  for (a in seeded) {
final/convergence.R:112:    cb <- conv[[al]][[a]]; if (is.null(cb)) next
final/convergence.R:113:    ok <- intersect(cA$inst[cA$conv], cb$inst[cb$conv])
final/convergence.R:114:    if (!length(ok)) { cat(sprintf("    %-5s %6d %10s\n", a, 0, "---")); next }
final/convergence.R:115:    v0 <- mean(r$rpd[r$arm == "A0" & r$inst %in% ok])
final/convergence.R:116:    v1 <- mean(r$rpd[r$arm == a    & r$inst %in% ok])
final/convergence.R:117:    cat(sprintf("    %-5s %6d %10.2f %10.2f %+9.2f\n", a, length(ok), v0, v1, v1-v0))
final/convergence.R:118:    inter <- rbind(inter, data.frame(algo=al, arm=a, n=length(ok), a0=v0, brazo=v1, dif=v1-v0))
final/convergence.R:119:  }
final/convergence.R:120:}
final/convergence.R:121:write.csv(inter, "final/convergencia_interseccion.csv", row.names = FALSE)
final/convergence.R:122:
final/convergence.R:123:cat("\n\n=== Sensibilidad del RESULTADO, no solo del recuento ===\n")
final/convergence.R:124:cat("    mejor brazo sobre el subconjunto convergido del control, por criterio\n")
final/convergence.R:125:cat(sprintf("  %-8s %-12s %s\n", "solver", "umbral", paste(sprintf("%10s", paste0("frac>=", c(0.5,0.8,0.9,1.0))), collapse="")))
final/convergence.R:126:for (al in names(algos)) {
final/convergence.R:127:  r <- merge(read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE),
final/convergence.R:128:             lb, by = "inst")
final/convergence.R:129:  r$rpd <- 100*(r$ecmax - r$lb)/r$lb
final/convergence.R:130:  for (u in c(0.05, 0.1, 0.25)) {
final/convergence.R:131:    fila <- sapply(c(0.5,0.8,0.9,1.0), function(fr) {
final/convergence.R:132:      cc <- clasifica(datos[[al]][["A0"]], u, fr)
final/convergence.R:133:      ok <- cc$inst[cc$conv]
final/convergence.R:134:      if (length(ok) < 2) return("--")
final/convergence.R:135:      m <- sapply(arms, function(a) mean(r$rpd[r$arm == a & r$inst %in% ok]))
final/convergence.R:136:      sprintf("%s(%d)", arms[which.min(m)], length(ok))
final/convergence.R:137:    })
final/convergence.R:138:    cat(sprintf("  %-8s %-12s %s\n", if (u == 0.05) algos[[al]] else "",
final/convergence.R:139:                sprintf("%.2f%%", u), paste(sprintf("%10s", fila), collapse="")))
final/convergence.R:140:  }
final/convergence.R:141:}
final/convergence.R:142:
final/convergence.R:143:cat("\n=== Aviso: mejoras negativas ===\n")
final/convergence.R:144:for (al in names(algos)) {
final/convergence.R:145:  m <- datos[[al]][["A0"]]
final/convergence.R:146:  n <- sum(m$mejora < 0)
final/convergence.R:147:  if (n > 0) cat(sprintf("  %-8s %4d de %d ejecuciones con mejora NEGATIVA (min %.2f%%)\n",
final/convergence.R:148:                         algos[[al]], n, nrow(m), min(m$mejora)))
final/convergence.R:149:}
final/convergence.R:150:cat("  Causa: StatisticsIJSP toma el mejor con isBetterThan, que en TS-N2 es\n")
final/convergence.R:151:cat("  LEX2. La traza guarda su incumbente en LEX2, cuyo midpoint no es\n")
final/convergence.R:152:cat("  monotono, asi que la 'mejora' medida en E[Cmax] puede salir negativa.\n")
final/convergence.R:153:cat("  Esas ejecuciones satisfacen trivialmente una regla que pide mejora\n")
final/convergence.R:154:cat("  < 0.1%, por una razon ajena a la convergencia. Se declara en el texto.\n")
final/convergence.R:155:
final/convergence.R:156:out <- do.call(rbind, lapply(names(conv), function(al)
final/convergence.R:157:  do.call(rbind, lapply(names(conv[[al]]), function(a)
final/convergence.R:158:    data.frame(algo = al, arm = a, conv[[al]][[a]])))))
final/convergence.R:159:out <- merge(out, cl, by = "inst")
final/convergence.R:160:write.csv(out, "final/convergencia.csv", row.names = FALSE)
final/convergence.R:161:cat(sprintf("\nescrito: final/convergencia.csv (%d filas) y final/convergencia_interseccion.csv\n", nrow(out)))
final/stats_robusto.R:1:# REANALISIS ESTADISTICO segun las objeciones del revisor 2.
final/stats_robusto.R:2:#
final/stats_robusto.R:3:# Problema del analisis anterior: se hacian 6 contrastes por instancia con
final/stats_robusto.R:4:# correccion de Holm SOLO dentro de cada instancia (244 familias separadas,
final/stats_robusto.R:5:# hasta 1464 contrastes elementales), y despues se contaban "victorias" sin
final/stats_robusto.R:6:# controlar el error global ni cuantificar si ese recuento excede lo esperable
final/stats_robusto.R:7:# bajo la hipotesis nula.
final/stats_robusto.R:8:#
final/stats_robusto.R:9:# Aqui la UNIDAD EXPERIMENTAL es la instancia, de forma consistente:
final/stats_robusto.R:10:#   1. por instancia se resume cada brazo con la media de sus 30 ejecuciones;
final/stats_robusto.R:11:#   2. la diferencia brazo - control por instancia es el dato (n = 61);
final/stats_robusto.R:12:#   3. un unico contraste por (solver, brazo) sobre esas 61 diferencias, con
final/stats_robusto.R:13:#      Holm sobre los 6 brazos de cada solver;
final/stats_robusto.R:14:#   4. intervalo de confianza por bootstrap remuestreando INSTANCIAS.
final/stats_robusto.R:15:# Asi no se mezcla la variabilidad entre ejecuciones con la variabilidad entre
final/stats_robusto.R:16:# instancias, que es la que sostiene las conclusiones.
final/stats_robusto.R:17:suppressPackageStartupMessages(library(boot))
final/stats_robusto.R:18:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/stats_robusto.R:19:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/stats_robusto.R:20:seeded <- c("V2H","V2","MOR","GT","GP","MIX","MIXH")
final/stats_robusto.R:21:set.seed(20260825)
final/stats_robusto.R:22:B <- 10000
final/stats_robusto.R:23:
final/stats_robusto.R:24:cat("=== Efecto de la siembra por instancia: diferencia de RPD frente al control ===\n")
final/stats_robusto.R:25:cat("    (n=61 instancias; IC 95% por bootstrap percentil remuestreando instancias;\n")
final/stats_robusto.R:26:cat("     p de Wilcoxon de rangos con signo sobre las 61 diferencias, Holm por solver)\n\n")
final/stats_robusto.R:27:res_all <- list()
final/stats_robusto.R:28:for (al in names(algos)) {
final/stats_robusto.R:29:  d <- merge(read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE),
final/stats_robusto.R:30:             lb, by = "inst")
final/stats_robusto.R:31:  d$rpd <- 100 * (d$ecmax - d$lb) / d$lb
final/stats_robusto.R:32:  m <- aggregate(rpd ~ inst + arm, data = d, FUN = mean)
final/stats_robusto.R:33:  w <- reshape(m, idvar = "inst", timevar = "arm", direction = "wide")
final/stats_robusto.R:34:  base <- w[["rpd.A0"]]
final/stats_robusto.R:35:  difs <- sapply(seeded, function(a) w[[paste0("rpd.", a)]] - base)
final/stats_robusto.R:36:  p <- apply(difs, 2, function(x) suppressWarnings(wilcox.test(x)$p.value))
final/stats_robusto.R:37:  ph <- p.adjust(p, method = "holm")
final/stats_robusto.R:38:  cat(sprintf("%s  (n = %d instancias)\n", algos[[al]], nrow(w)))
final/stats_robusto.R:39:  cat(sprintf("  %-5s %9s %20s %10s %10s  %s\n",
final/stats_robusto.R:40:              "brazo", "dif media", "IC 95%", "p", "p (Holm)", ""))
final/stats_robusto.R:41:  fila <- data.frame()
final/stats_robusto.R:42:  for (a in seeded) {
final/stats_robusto.R:43:    x <- difs[, a]
final/stats_robusto.R:44:    bt <- boot(x, function(v, i) mean(v[i]), R = B)
final/stats_robusto.R:45:    ci <- boot.ci(bt, type = "perc")$percent[4:5]
final/stats_robusto.R:46:    sig <- if (ph[a] < 0.001) "***" else if (ph[a] < 0.01) "**" else if (ph[a] < 0.05) "*" else ""
final/stats_robusto.R:47:    cat(sprintf("  %-5s %+9.3f   [%+7.3f, %+7.3f] %10.4f %10.4f  %s\n",
final/stats_robusto.R:48:                a, mean(x), ci[1], ci[2], p[a], ph[a], sig))
final/stats_robusto.R:49:    fila <- rbind(fila, data.frame(algo = al, arm = a, dif = mean(x),
final/stats_robusto.R:50:                                   lo = ci[1], hi = ci[2], p = p[a], p_holm = ph[a]))
final/stats_robusto.R:51:  }
final/stats_robusto.R:52:  res_all[[al]] <- fila
final/stats_robusto.R:53:  cat("\n")
final/stats_robusto.R:54:}
final/stats_robusto.R:55:write.csv(do.call(rbind, res_all), "final/efectos_ic.csv", row.names = FALSE)
final/stats_robusto.R:56:
final/stats_robusto.R:57:cat("=== Control de multiplicidad a nivel de estudio ===\n")
final/stats_robusto.R:58:todo <- do.call(rbind, res_all)
final/stats_robusto.R:59:todo$p_global <- p.adjust(todo$p, method = "holm")          # 24 contrastes
final/stats_robusto.R:60:sig_solver <- sum(todo$p_holm < 0.05)
final/stats_robusto.R:61:sig_global <- sum(todo$p_global < 0.05)
final/stats_robusto.R:62:cat(sprintf("  contrastes: %d (%d solvers x %d brazos sembrados)\n", nrow(todo), length(algos), length(seeded)))
final/stats_robusto.R:63:cat(sprintf("  significativos con Holm por solver (familia de %d): %d\n", length(seeded), sig_solver))
final/stats_robusto.R:64:cat(sprintf("  significativos con Holm sobre los %d contrastes:    %d\n", nrow(todo), sig_global))
final/stats_robusto.R:65:cat("  brazos que pierden significacion al corregir globalmente:")
final/stats_robusto.R:66:perd <- todo[todo$p_holm < 0.05 & todo$p_global >= 0.05, ]
final/stats_robusto.R:67:if (nrow(perd)) cat(sprintf(" %s/%s", perd$algo, perd$arm), "\n") else cat(" ninguno\n")
final/stats_robusto.R:68:write.csv(todo, "final/efectos_ic.csv", row.names = FALSE)
final/stats_robusto.R:69:cat("\nescrito: final/efectos_ic.csv\n")
final/mixh_vs_mix.R:1:# ¿SON DOS EFECTOS O UNO?
final/mixh_vs_mix.R:2:#
final/mixh_vs_mix.R:3:# El articulo tiene dos afirmaciones de mecanismo medidas sobre pools distintos:
final/mixh_vs_mix.R:4:#   - composicion: MIX (mezcla) frente a los generadores unicos, a fraccion 100%
final/mixh_vs_mix.R:5:#   - fraccion:    V2H (media poblacion) frente a V2, sobre el pool v2
final/mixh_vs_mix.R:6:# MIXH combina ambas. Si mejora sobre MIX, los efectos se suman; si no, la
final/mixh_vs_mix.R:7:# composicion ya estaba haciendo el trabajo de la aleatoriedad retenida.
final/mixh_vs_mix.R:8:#
final/mixh_vs_mix.R:9:# Contrastes emparejados por instancia (n=61), negativo = el primero es mejor.
final/mixh_vs_mix.R:10:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/mixh_vs_mix.R:11:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/mixh_vs_mix.R:12:set.seed(20260828)
final/mixh_vs_mix.R:13:B <- 10000
final/mixh_vs_mix.R:14:
final/mixh_vs_mix.R:15:par <- list(c("MIXH","MIX"),    # ¿anade algo retener aleatorio sobre el mixto?
final/mixh_vs_mix.R:16:            c("MIXH","V2H"),    # ¿anade algo componer sobre media poblacion?
final/mixh_vs_mix.R:17:            c("MIXH","A0"))     # ¿mejora al control?
final/mixh_vs_mix.R:18:
final/mixh_vs_mix.R:19:cat("=== MIXH frente a los brazos que combina ===\n")
final/mixh_vs_mix.R:20:cat("    diferencia media por instancia, IC bootstrap sobre instancias,\n")
final/mixh_vs_mix.R:21:cat("    p de Wilcoxon emparejado. Negativo = MIXH mejor.\n\n")
final/mixh_vs_mix.R:22:res <- data.frame()
final/mixh_vs_mix.R:23:for (al in names(algos)) {
final/mixh_vs_mix.R:24:  d <- merge(read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE),
final/mixh_vs_mix.R:25:             lb, by = "inst")
final/mixh_vs_mix.R:26:  d$rpd <- 100 * (d$ecmax - d$lb) / d$lb
final/mixh_vs_mix.R:27:  m <- aggregate(rpd ~ inst + arm, d, mean)
final/mixh_vs_mix.R:28:  w <- reshape(m, idvar = "inst", timevar = "arm", direction = "wide")
final/mixh_vs_mix.R:29:  cat(sprintf("%s\n", algos[[al]]))
final/mixh_vs_mix.R:30:  cat(sprintf("  %-12s %9s %20s %9s\n", "contraste", "dif", "IC 95%", "p"))
final/mixh_vs_mix.R:31:  for (p in par) {
final/mixh_vs_mix.R:32:    a <- w[[paste0("rpd.", p[1])]]; b <- w[[paste0("rpd.", p[2])]]
final/mixh_vs_mix.R:33:    if (is.null(a) || is.null(b)) next
final/mixh_vs_mix.R:34:    x <- a - b
final/mixh_vs_mix.R:35:    M <- matrix(sample(x, length(x)*B, TRUE), nrow = length(x))
final/mixh_vs_mix.R:36:    ci <- quantile(colMeans(M), c(.025, .975))
