final/pool_blocks.R:1:# ¿Se ve estructura de 3 bloques (342/341/341) en el pool v2, y no en los otros?
final/pool_blocks.R:2:lee <- function(f) {
final/pool_blocks.R:3:  x <- readLines(f)
final/pool_blocks.R:4:  as.numeric(sub("^.*, *([0-9.]+)\\]$", "\\1", x))     # extremo superior
final/pool_blocks.R:5:}
final/pool_blocks.R:6:prueba <- function(inst, gen) {
final/pool_blocks.R:7:  f <- sprintf("pools_test/corrected/int__%s_%s_repo_pool.csv", inst, gen)
final/pool_blocks.R:8:  if (!file.exists(f)) return(invisible(NULL))
final/pool_blocks.R:9:  up <- lee(f)
final/pool_blocks.R:10:  if (any(is.na(up))) { cat(sprintf("%-14s %-9s parseo fallido\n", inst, gen)); return(invisible(NULL)) }
final/pool_blocks.R:11:  b <- c(rep(1,342), rep(2,341), rep(3,341))[seq_along(up)]
final/pool_blocks.R:12:  m <- tapply(up, b, mean)
final/pool_blocks.R:13:  p <- kruskal.test(up ~ factor(b))$p.value
final/pool_blocks.R:14:  cat(sprintf("%-14s %-9s %.1f / %.1f / %.1f   p=%.2e %s\n",
final/pool_blocks.R:15:      inst, gen, m[1], m[2], m[3], p,
final/pool_blocks.R:16:      ifelse(p < 0.001, "<- BLOQUES DISTINTOS", "")))
final/pool_blocks.R:17:}
final/pool_blocks.R:18:cat("Media del extremo superior por tercio del fichero (342/341/341)\n")
final/pool_blocks.R:19:cat("Si el pool son 3 bloques de checkpoints distintos, los tercios difieren.\n\n")
final/pool_blocks.R:20:for (inst in c("tai30_20_01","tai50_20_01","tai15_15_05","tai20_20_07")) {
final/pool_blocks.R:21:  for (gen in c("v2","gp","gtmwkr")) prueba(inst, gen)
final/pool_blocks.R:22:  cat("\n")
final/pool_blocks.R:23:}
