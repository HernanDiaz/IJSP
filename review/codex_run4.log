final/build_mix_pools.sh:1:#!/usr/bin/env bash
final/build_mix_pools.sh:2:# Reconstruye los 61 pools MIX con ENTRELAZADO FINO y 1024 entradas, el mismo
final/build_mix_pools.sh:3:# tamano que los pools de un solo generador.
final/build_mix_pools.sh:4:#
final/build_mix_pools.sh:5:# Por que: el MIX anterior estaba ordenado en BLOQUES de 84 v2 + 83 GT + 83 gp
final/build_mix_pools.sh:6:# con periodo 250. Los bloques que usa el experimento empiezan en 250r mod L, y
final/build_mix_pools.sh:7:# los que dan la vuelta rompian la composicion (108/83/59 en vez de 84/83/83).
final/build_mix_pools.sh:8:# Entrelazando v2, GT, gp uno a uno, CUALQUIER ventana de 250 queda equilibrada
final/build_mix_pools.sh:9:# y el tamano del pool deja de condicionar la composicion.
final/build_mix_pools.sh:10:#
final/build_mix_pools.sh:11:# No se genera ninguna solucion nueva: se reordenan las de los pools existentes.
final/build_mix_pools.sh:12:# Los MIX antiguos se conservan en pools_test/mix_bloques_original/.
final/build_mix_pools.sh:13:set -e
final/build_mix_pools.sh:14:cd "$(dirname "$0")/.."
final/build_mix_pools.sh:15:P=pools_test/corrected
final/build_mix_pools.sh:16:BK=pools_test/mix_bloques_original
final/build_mix_pools.sh:17:mkdir -p "$BK"
final/build_mix_pools.sh:18:INSTS="ft10"
final/build_mix_pools.sh:19:for c in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/build_mix_pools.sh:20:  for i in $(seq -w 1 10); do INSTS="$INSTS ${c}_${i}"; done
final/build_mix_pools.sh:21:done
final/build_mix_pools.sh:22:N=1024
final/build_mix_pools.sh:23:per=$(( (N + 2) / 3 ))     # 342 de cada uno; se recorta a N al final
final/build_mix_pools.sh:24:n=0
final/build_mix_pools.sh:25:for inst in $INSTS; do
final/build_mix_pools.sh:26:  mix="$P/int__${inst}_mix_repo_pool.csv"
final/build_mix_pools.sh:27:  [ -f "$mix" ] || { echo "  (sin mix: $inst)"; continue; }
final/build_mix_pools.sh:28:  [ -f "$BK/$(basename "$mix")" ] || cp "$mix" "$BK/"
final/build_mix_pools.sh:29:  for g in v2 gtmwkr gp; do
final/build_mix_pools.sh:30:    head -"$per" "$P/int__${inst}_${g}_repo_pool.csv" > "/tmp/mp_$g"
final/build_mix_pools.sh:31:  done
final/build_mix_pools.sh:32:  paste -d'\n' /tmp/mp_v2 /tmp/mp_gtmwkr /tmp/mp_gp | head -"$N" > "$mix"
final/build_mix_pools.sh:33:  l=$(wc -l < "$mix")
final/build_mix_pools.sh:34:  [ "$l" -eq "$N" ] || { echo "  ERROR $inst: $l lineas"; exit 1; }
final/build_mix_pools.sh:35:  n=$((n+1))
final/build_mix_pools.sh:36:done
final/build_mix_pools.sh:37:echo "pools MIX reconstruidos: $n  (1024 entradas, entrelazado v2/GT/gp)"
final/build_mix_pools.sh:38:echo "originales por bloques conservados en: $BK"

