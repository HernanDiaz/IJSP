final/resample_anytime.sh:27:out="$BASEDIR/anytime_${algo}.csv"
final/resample_anytime.sh:28:case "$algo" in
final/resample_anytime.sh:29:  ga)      STEP=2   ;;
final/resample_anytime.sh:30:  abce3)   STEP=0.2 ;;
final/resample_anytime.sh:31:  feabcls) STEP=5   ;;
final/resample_anytime.sh:32:  tsn2)    STEP=5   ;;
final/resample_anytime.sh:33:  *)       STEP=5   ;;
final/resample_anytime.sh:34:esac
final/resample_anytime.sh:35:if [ -n "$INSTS_OVERRIDE" ]; then INSTS="$INSTS_OVERRIDE"; else
final/resample_anytime.sh:36:INSTS="ft10"
final/resample_anytime.sh:37:for cls in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/resample_anytime.sh:38:  for i in $(seq -w 1 10); do INSTS="$INSTS ${cls}_${i}"; done
final/resample_anytime.sh:39:done
final/resample_anytime.sh:40:fi
final/resample_anytime.sh:41:
final/resample_anytime.sh:42:# Extrae "run_global tiempo mejor_acumulado" de un fichero de trazas.
final/resample_anytime.sh:43:# $2 = desplazamiento de numeracion de ejecucion (para no mezclar trozos).
final/resample_anytime.sh:44:trace_runs() {
final/resample_anytime.sh:45:  awk -F';' -v off="$2" '
final/resample_anytime.sh:46:    # La columna Step es la generacion PROMEDIADA sobre las ejecuciones del
final/resample_anytime.sh:47:    # trozo, asi que casi siempre es decimal (135.6, 266.8, ...) y en la ultima
final/resample_anytime.sh:48:    # fila esta vacia. Filtrar por /^[0-9]+$/ descartaba el 45-78% de las filas
final/resample_anytime.sh:49:    # segun el solver, incluida la fila final. Se delimita el bloque por sus
final/resample_anytime.sh:50:    # cabeceras y se acepta toda fila de datos.
final/resample_anytime.sh:51:    /^Evolution/ { e=1; next }
final/resample_anytime.sh:52:    e && /^Step;/ { h=1; next }
final/resample_anytime.sh:53:    h && NF > 6 {
final/resample_anytime.sh:54:      for (r=0; r<40; r++) {
final/resample_anytime.sh:55:        ct = 7 + r*6 + 1        # Runtime de la ejecucion r
final/resample_anytime.sh:56:        cv = 7 + r*6 + 2        # Best de la ejecucion r
final/resample_anytime.sh:57:        if (cv > NF || $cv == "" || $ct == "") continue
final/resample_anytime.sh:58:        v = $cv + 0
final/resample_anytime.sh:59:        if (v <= 0) continue
final/resample_anytime.sh:60:        key = off + r
final/resample_anytime.sh:61:        if (!(key in mn) || v < mn[key]) mn[key] = v    # minimo acumulado
final/resample_anytime.sh:62:        printf "%d %.3f %.3f\n", key, $ct, mn[key]
final/resample_anytime.sh:63:      }
final/resample_anytime.sh:64:    }' "$1"
final/resample_anytime.sh:65:}
final/resample_anytime.sh:66:
final/resample_anytime.sh:67:echo "algo,inst,arm,t,bestcmax" > "$out"
final/resample_anytime.sh:68:for inst in $INSTS; do
final/resample_anytime.sh:69:  for arm in A0 V2H V2 MOR GT GP MIX MIXH; do
final/resample_anytime.sh:70:    base="$BASEDIR/$algo/$inst/$arm"
final/resample_anytime.sh:71:    tmp=$(mktemp)
final/resample_anytime.sh:72:    if [ -n "$(ls -d "$base"/c* 2>/dev/null)" ]; then
final/resample_anytime.sh:73:      off=0
final/resample_anytime.sh:74:      for d in $(ls -d "$base"/c* 2>/dev/null | sort -V); do
final/resample_anytime.sh:75:        c=$(ls "$d"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/resample_anytime.sh:76:        [ -n "$c" ] && { trace_runs "$c" "$off" >> "$tmp"; off=$((off+5)); }
final/resample_anytime.sh:77:      done
final/resample_anytime.sh:78:    else
final/resample_anytime.sh:79:      c=$(ls "$base"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/resample_anytime.sh:80:      [ -n "$c" ] && trace_runs "$c" 0 >> "$tmp"
final/resample_anytime.sh:81:    fi
final/resample_anytime.sh:82:    [ -s "$tmp" ] || { rm -f "$tmp"; continue; }
final/resample_anytime.sh:83:    # Rejilla comun: para cada t, media sobre ejecuciones del ultimo valor <= t,
final/resample_anytime.sh:84:    # extendiendo con el ultimo conocido las que ya terminaron.
final/resample_anytime.sh:85:    sort -k1,1n -k2,2n "$tmp" | awk -v st="$STEP" -v a="$algo" -v i="$inst" -v ar="$arm" '
final/resample_anytime.sh:86:      { run[$1]=1; n=++cnt[$1]; T[$1,n]=$2; V[$1,n]=$3; if ($2>tmax) tmax=$2 }
final/resample_anytime.sh:87:      END {
final/resample_anytime.sh:88:        nrun=0; for (r in run) nrun++
final/resample_anytime.sh:89:        for (t=st; t<=tmax+st/2; t+=st) {
final/resample_anytime.sh:90:          s=0; k=0
final/resample_anytime.sh:91:          for (r in run) {
final/resample_anytime.sh:92:            m=cnt[r]; cur=""
final/resample_anytime.sh:93:            for (j=1; j<=m; j++) { if (T[r,j] <= t) cur=V[r,j]; else break }
final/resample_anytime.sh:94:            if (cur=="") continue            # esa ejecucion aun no ha reportado
final/resample_anytime.sh:95:            s+=cur; k++
final/resample_anytime.sh:96:          }
final/resample_anytime.sh:97:          # COMPOSICION ESTABLE: solo se emite el punto si TODAS las ejecuciones
final/resample_anytime.sh:98:          # han reportado ya. Si no, la media cambia de composicion al ir
final/resample_anytime.sh:99:          # incorporandose ejecuciones y la curva puede subir aunque cada
final/resample_anytime.sh:100:          # ejecucion sea monotona.
final/resample_anytime.sh:101:          if (k == nrun) printf "%s,%s,%s,%.2f,%.2f\n", a, i, ar, t, s/k
final/resample_anytime.sh:102:        }
final/resample_anytime.sh:103:      }' >> "$out"
final/resample_anytime.sh:104:    rm -f "$tmp"
final/resample_anytime.sh:105:  done
final/resample_anytime.sh:106:done
final/resample_anytime.sh:107:echo "$out : $(( $(wc -l < "$out") - 1 )) filas  (rejilla ${STEP}s, minimo acumulado por ejecucion)"
final/extract_phase2c.sh:1:#!/usr/bin/env bash
final/extract_phase2c.sh:2:# Extrae E[Cmax] por run de la Fase 2 soportando AMBOS formatos:
final/extract_phase2c.sh:3:#   - monolitico:  <arm>/*_Sols.csv         (runs 1..30 en un fichero)
final/extract_phase2c.sh:4:#   - chunked:     <arm>/c<j>/*_Sols.csv    (se concatenan y renumeran a 1..30)
final/extract_phase2c.sh:5:# Uso: extract_phase2c.sh <algo>   -> final/phase2/results_<algo>.csv
final/extract_phase2c.sh:6:cd "$(dirname "$0")/.."
final/extract_phase2c.sh:7:algo=${1:?uso: extract_phase2c.sh <algo>}
final/extract_phase2c.sh:8:BASEDIR=${OUT_OVERRIDE:-final/phase2}
final/extract_phase2c.sh:9:out="$BASEDIR/results_${algo}.csv"
final/extract_phase2c.sh:10:clase() { case "$1" in
final/extract_phase2c.sh:11:  ft10) echo 10x10 ;; tai15_15_*) echo 15x15 ;; tai20_20_*) echo 20x20 ;; tai30_15_*) echo 30x15 ;;
final/extract_phase2c.sh:12:  tai30_20_*) echo 30x20 ;; tai50_15_*) echo 50x15 ;; tai50_20_*) echo 50x20 ;;
final/extract_phase2c.sh:13:esac; }
final/extract_phase2c.sh:14:if [ -n "$INSTS_OVERRIDE" ]; then INSTS="$INSTS_OVERRIDE"; else
final/extract_phase2c.sh:15:INSTS="ft10"
final/extract_phase2c.sh:16:for cls in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/extract_phase2c.sh:17:  for i in $(seq -w 1 10); do INSTS="$INSTS ${cls}_${i}"; done
final/extract_phase2c.sh:18:done
final/extract_phase2c.sh:19:fi
final/extract_phase2c.sh:20:echo "algo,inst,clase,arm,run,ecmax" > "$out"
final/extract_phase2c.sh:21:for inst in $INSTS; do
final/extract_phase2c.sh:22:  cls=$(clase "$inst")
final/extract_phase2c.sh:23:  for arm in A0 V2H V2 MOR GT GP MIX MIXH; do
final/extract_phase2c.sh:24:    base="$BASEDIR/$algo/$inst/$arm"
final/extract_phase2c.sh:25:    # PRIORIDAD A LOS CHUNKS. Las corridas monoliticas abortadas del 26-jul
final/extract_phase2c.sh:26:    # dejaron <arm>/*_Sols.csv con runs incompletos (p.ej. 21 en vez de 30);
final/extract_phase2c.sh:27:    # si existen chunks, ellos son la corrida buena y completa.
final/extract_phase2c.sh:28:    mono=$(ls "$base"/*_Sols.csv 2>/dev/null | head -1)
final/extract_phase2c.sh:29:    [ -n "$(ls -d "$base"/c* 2>/dev/null)" ] && mono=""
final/extract_phase2c.sh:30:    if [ -n "$mono" ]; then
final/extract_phase2c.sh:31:      awk -F';' -v a=$algo -v i=$inst -v c=$cls -v ar=$arm \
final/extract_phase2c.sh:32:        'NR>1&&$3~/\(/{gsub(/[()]/,"",$3);split($3,ab,",");printf "%s,%s,%s,%s,%d,%.1f\n",a,i,c,ar,$1,(ab[1]+ab[2])/2}' "$mono" >> "$out"
final/extract_phase2c.sh:33:    else
final/extract_phase2c.sh:34:      # chunked: concatena c1,c2,... renumerando runs de forma global
final/extract_phase2c.sh:35:      r=0
final/extract_phase2c.sh:36:      for d in $(ls -d "$base"/c* 2>/dev/null | sort -V); do
final/extract_phase2c.sh:37:        s=$(ls "$d"/*_Sols.csv 2>/dev/null | head -1); [ -z "$s" ] && continue
final/extract_phase2c.sh:38:        while IFS= read -r line; do
final/extract_phase2c.sh:39:          r=$((r+1))
final/extract_phase2c.sh:40:          echo "$line" | awk -F';' -v a=$algo -v i=$inst -v c=$cls -v ar=$arm -v rr=$r \
final/extract_phase2c.sh:41:            '$3~/\(/{gsub(/[()]/,"",$3);split($3,ab,",");printf "%s,%s,%s,%s,%d,%.1f\n",a,i,c,ar,rr,(ab[1]+ab[2])/2}'
final/extract_phase2c.sh:42:        done < <(tail -n +2 "$s")
final/extract_phase2c.sh:43:      done >> "$out"
final/extract_phase2c.sh:44:    fi
final/extract_phase2c.sh:45:  done
final/extract_phase2c.sh:46:done
final/extract_phase2c.sh:47:echo "$out : $(( $(wc -l < "$out") - 1 )) filas"
final/run_phase2c.sh:1:#!/usr/bin/env bash
final/run_phase2c.sh:2:# FASE 2 (version CHUNKED) — igual que run_phase2.sh pero partiendo los 30 runs de
final/run_phase2c.sh:3:# cada configuracion en trozos independientes, para acotar la FUGA DE MEMORIA del
final/run_phase2c.sh:4:# solver (medida 2026-07-26: ~400MB -> ~1GB por proceso a lo largo de 30 runs).
final/run_phase2c.sh:5:#
final/run_phase2c.sh:6:# Cada trozo es un proceso nuevo (muere y libera). Semillas: el framework usa
final/run_phase2c.sh:7:# seed+run, asi que trozo j con seed=1+j*CH y runs=CH reproduce EXACTAMENTE las
final/run_phase2c.sh:8:# mismas 30 semillas (1..30) que un unico runs=30 -> identico estadisticamente.
final/run_phase2c.sh:9:#
final/run_phase2c.sh:10:# Salida: final/phase2/<algo>/<inst>/<arm>/c<j>/   (un subdir por trozo)
final/run_phase2c.sh:11:# Una configuracion se considera terminada cuando TODOS sus trozos tienen stats CSV.
final/run_phase2c.sh:12:# Idempotente a nivel de trozo (se puede cortar y reanudar sin perder nada).
final/run_phase2c.sh:13:#
final/run_phase2c.sh:14:# Variables: PAR (default 10), CH (runs por trozo; default 5 para ga/abce3,
final/run_phase2c.sh:15:#            3 para feabcls/tsn2 que consumen mas por run).
final/run_phase2c.sh:16:cd "$(dirname "$0")/.."
final/run_phase2c.sh:17:RUNS=30
final/run_phase2c.sh:18:PAR=${PAR:-10}
final/run_phase2c.sh:19:CAP=900
final/run_phase2c.sh:20:OUT=${OUT_OVERRIDE:-final/phase2}
final/run_phase2c.sh:21:mkdir -p "$OUT"
final/run_phase2c.sh:22:
final/run_phase2c.sh:23:declare -A BGA=(  [15x15]=60  [20x20]=60  [30x15]=109 [30x20]=154 [50x15]=233 [50x20]=321 )
final/run_phase2c.sh:24:declare -A BAB=(  [15x15]=60  [20x20]=60  [30x15]=60  [30x20]=60  [50x15]=60  [50x20]=60 )
final/run_phase2c.sh:25:declare -A BFL=(  [15x15]=60  [20x20]=67  [30x15]=371 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:26:declare -A BTS=(  [15x15]=60  [20x20]=486 [30x15]=630 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:27:# FORCEBUD: presupuesto forzado, SOLO para el smoke test. Permite recorrer el
final/run_phase2c.sh:28:# pipeline completo en minutos por el MISMO camino de codigo que la corrida real.
final/run_phase2c.sh:29:budget() { if [ -n "$FORCEBUD" ]; then echo "$FORCEBUD"; return; fi
final/run_phase2c.sh:30:  case "$1" in ga) echo "${BGA[$2]}";; abce3) echo "${BAB[$2]}";; feabcls) echo "${BFL[$2]}";; tsn2) echo "${BTS[$2]}";; esac; }
final/run_phase2c.sh:31:chunk_size() { echo "${CH:-5}"; }   # 5 runs por trozo -> pico ~325 MB/worker (medido)
final/run_phase2c.sh:32:clase() { case "$1" in
final/run_phase2c.sh:33:  ft10|tai15_15_*) echo 15x15 ;; tai20_20_*) echo 20x20 ;; tai30_15_*) echo 30x15 ;;
final/run_phase2c.sh:34:  tai30_20_*) echo 30x20 ;; tai50_15_*) echo 50x15 ;; tai50_20_*) echo 50x20 ;;
final/run_phase2c.sh:35:esac; }
final/run_phase2c.sh:36:instfile() { if [ "$1" = "ft10" ]; then echo "SelectosYTaillardIntervalos/F0.15.0.ft10_10.txt";
final/run_phase2c.sh:37:  else echo "SelectosYTaillardIntervalos/$1.F.15_01.txt"; fi }
final/run_phase2c.sh:38:armspec() { case "$1" in
final/run_phase2c.sh:39:  A0) echo ", 0";; V2H) echo "v2, 125";; V2) echo "v2, 250";; MOR) echo "graspmor, 250";;
final/run_phase2c.sh:40:  GT) echo "gtmwkr, 250";; GP) echo "gp, 250";; MIX) echo "mix, 250";;
final/run_phase2c.sh:41:  MIXH) echo "mix, 125";;
final/run_phase2c.sh:42:esac; }
final/run_phase2c.sh:43:
final/run_phase2c.sh:44:# INSTS_OVERRIDE y OUT_OVERRIDE: para el smoke test, mismo codigo pero
final/run_phase2c.sh:45:# pocas instancias y directorio aparte, sin tocar los datos reales.
final/run_phase2c.sh:46:if [ -n "$INSTS_OVERRIDE" ]; then
final/run_phase2c.sh:47:  INSTS="$INSTS_OVERRIDE"
final/run_phase2c.sh:48:else
final/run_phase2c.sh:49:INSTS="ft10"
final/run_phase2c.sh:50:for cls in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/run_phase2c.sh:51:  for i in $(seq -w 1 10); do INSTS="$INSTS ${cls}_${i}"; done
final/run_phase2c.sh:52:done
final/run_phase2c.sh:53:fi
final/run_phase2c.sh:54:# ARMS_OVERRIDE permite anadir un brazo sin retocar el resto: los trozos ya
final/run_phase2c.sh:55:# completos se saltan de todos modos, pero limitar la lista hace explicito que
final/run_phase2c.sh:56:# la corrida no puede tocar celdas existentes.
final/run_phase2c.sh:57:ARMS=${ARMS_OVERRIDE:-"A0 V2H V2 MOR GT GP MIX"}
final/run_phase2c.sh:58:ALGOS=${ALGOS:-"ga feabcls tsn2"}   # abce3 ya completo; ga parcialmente
final/run_phase2c.sh:59:
final/run_phase2c.sh:60:# En DRYRUN la lista va a un temporal: un ensayo no debe tocar ni siquiera el
final/run_phase2c.sh:61:# fichero de trabajos del experimento.
final/run_phase2c.sh:62:JOB="$OUT/joblist_chunk.txt"
final/run_phase2c.sh:63:[ "${DRYRUN:-0}" = "1" ] && JOB="${DRYJOB:-$(mktemp)}"
final/run_phase2c.sh:64:: > "$JOB"; skipc=0; skipm=0; todo=0
final/run_phase2c.sh:65:for algo in $ALGOS; do
final/run_phase2c.sh:66:  ch=$(chunk_size "$algo")
final/run_phase2c.sh:67:  nch=$(( (RUNS + ch - 1) / ch ))
final/run_phase2c.sh:68:  for inst in $INSTS; do
final/run_phase2c.sh:69:    cls=$(clase "$inst"); bud=$(budget "$algo" "$cls"); f=$(instfile "$inst")
final/run_phase2c.sh:70:    for arm in $ARMS; do
final/run_phase2c.sh:71:      base="$OUT/$algo/$inst/$arm"
final/run_phase2c.sh:72:      # si la config ya se completo en el formato antiguo (runs=30 monolitico), saltar
final/run_phase2c.sh:73:      mono=$(ls "$base"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:74:      [ -n "$mono" ] && { skipm=$((skipm+1)); continue; }
final/run_phase2c.sh:75:      spec=$(armspec "$arm"); g=${spec%%,*}; k=$(echo "${spec##*,}" | tr -d ' ')
final/run_phase2c.sh:76:      for j in $(seq 1 $nch); do
final/run_phase2c.sh:77:        d="$base/c$j"
final/run_phase2c.sh:78:        csv=$(ls "$d"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:79:        [ -n "$csv" ] && { skipc=$((skipc+1)); continue; }
final/run_phase2c.sh:80:        todo=$((todo+1))
final/run_phase2c.sh:81:        seed=$(( 1 + (j-1)*ch ))
final/run_phase2c.sh:82:        pool=""
final/run_phase2c.sh:83:        if [ "$k" -gt 0 ]; then
final/run_phase2c.sh:84:          pool="pools_test/corrected/int__${inst}_${g}_repo_pool.csv"
final/run_phase2c.sh:85:          [ -f "$pool" ] || { echo "FALTA pool: $pool"; exit 1; }
final/run_phase2c.sh:86:        fi
final/run_phase2c.sh:87:        # DRYRUN no debe TOCAR EL DISCO. Antes creaba el directorio y escribia
final/run_phase2c.sh:88:        # setup.txt antes de comprobar la variable, de modo que un "ensayo"
final/run_phase2c.sh:89:        # dejaba miles de ficheros y ensuciaba el arbol del experimento.
final/run_phase2c.sh:90:        if [ "${DRYRUN:-0}" != "1" ]; then
final/run_phase2c.sh:91:        rm -rf "$d"; mkdir -p "$d"
final/run_phase2c.sh:92:        sed -e "s/^runs = .*/runs = $ch/" -e "s/^seed = .*/seed = $seed/" "repro/setup_${algo}.txt" > "$d/setup.txt"
final/run_phase2c.sh:93:        sed -i "s/^noimprovement = .*/generations = 100000/" "$d/setup.txt"
final/run_phase2c.sh:94:        if grep -q '^timelimit' "$d/setup.txt"; then sed -i "s/^timelimit = .*/timelimit = $bud/" "$d/setup.txt"
final/run_phase2c.sh:95:        else echo "timelimit = $bud" >> "$d/setup.txt"; fi
final/run_phase2c.sh:96:        if [ -n "$pool" ]; then
final/run_phase2c.sh:97:          sed -i "s/^creation = ijsp.random/creation = ijsp.seeded/" "$d/setup.txt"
final/run_phase2c.sh:98:          # INDICE GLOBAL de la primera ejecucion de este trozo. Sin el, cada
final/run_phase2c.sh:99:          # proceso reinicia su contador y los 6 trozos repiten los mismos
final/run_phase2c.sh:100:          # bloques del pool: 5 poblaciones iniciales en vez de 30.
final/run_phase2c.sh:101:          { echo ""; echo "creation.seed.pool = $pool"; echo "creation.seed.count = $k";
final/run_phase2c.sh:102:            echo "creation.seed.offset = $(( (j-1)*ch ))"; } >> "$d/setup.txt"
final/run_phase2c.sh:103:        fi
final/run_phase2c.sh:104:        fi
final/run_phase2c.sh:105:        echo "./FuzzyFW '$d/setup.txt' '$f' '$d' > '$d/log.txt' 2>&1" >> "$JOB"
final/run_phase2c.sh:106:      done
final/run_phase2c.sh:107:    done
final/run_phase2c.sh:108:  done
final/run_phase2c.sh:109:done
final/run_phase2c.sh:110:echo "configs ya completas (monoliticas): $skipm | trozos ya hechos: $skipc | trozos pendientes: $todo"
final/run_phase2c.sh:111:if [ "${DRYRUN:-0}" = "1" ]; then echo "DRYRUN: nada lanzado."; exit 0; fi
final/run_phase2c.sh:112:echo "Inicio PHASE2C: $(date) | $todo trozos, <=$PAR, chunk ga/abce3=${CH:-5} feabcls/tsn2=${CH:-3}" | tee -a "$OUT/run.log"
final/run_phase2c.sh:113:cat "$JOB" | xargs -I CMD -P "$PAR" bash -c CMD
final/run_phase2c.sh:114:echo "PHASE2C DONE: $(date)" | tee -a "$OUT/run.log"
final/run_mixh.sh:1:#!/usr/bin/env bash
final/run_mixh.sh:2:# BRAZO MIXH: pool mixto sembrando SOLO LA MITAD de la poblacion (125 de 250).
final/run_mixh.sh:3:#
final/run_mixh.sh:4:# Por que este brazo. El diseno tiene el pool v2 a dos fracciones (V2 al 100%,
final/run_mixh.sh:5:# V2H al 50%) pero el pool mixto solo al 100%. Las dos afirmaciones de
final/run_mixh.sh:6:# mecanismo del articulo se miden por tanto sobre pools distintos:
final/run_mixh.sh:7:#   - la composicion manda sobre la calidad  -> medido a fraccion 100%
final/run_mixh.sh:8:#   - la fraccion interactua con el solver   -> medido sobre v2 puro
final/run_mixh.sh:9:# Falta saber si son EL MISMO mecanismo o dos. En el GA retener material
final/run_mixh.sh:10:# aleatorio ayuda (V2H mejor que V2, -0.39 pp) y componer tambien (MIX no dana,
final/run_mixh.sh:11:# los generadores unicos si). Si MIXH mejora sobre MIX, son dos efectos que se
final/run_mixh.sh:12:# suman; si no, la composicion ya estaba haciendo el trabajo de la aleatoriedad.
final/run_mixh.sh:13:#
final/run_mixh.sh:14:# NO HACEN FALTA POOLS NUEVOS: MIXH usa el mismo pool mixto que MIX, igual que
final/run_mixh.sh:15:# V2H usa el mismo pool que V2. Solo cambia creation.seed.count.
final/run_mixh.sh:16:#
final/run_mixh.sh:17:# HOMOGENEIDAD. Este brazo debe correr en condiciones identicas a los otros
final/run_mixh.sh:18:# siete o la comparacion no vale. Se reutiliza run_phase2c.sh sin tocar su
final/run_mixh.sh:19:# logica, de modo que hereda los mismos presupuestos por (solver, clase), el
final/run_mixh.sh:20:# mismo troceado en 6 x 5 ejecuciones, el mismo offset global de semillas y los
final/run_mixh.sh:21:# mismos setups de repro/. La lista de brazos se restringe a MIXH: los trozos ya
final/run_mixh.sh:22:# hechos se saltarian igualmente, pero restringirla hace imposible tocarlos.
final/run_mixh.sh:23:#
final/run_mixh.sh:24:# CONSECUENCIA ESTADISTICA que hay que declarar en el articulo: la correccion de
final/run_mixh.sh:25:# Holm pasa de 6 a 7 contrastes por solver, asi que TODOS los p-valores se
final/run_mixh.sh:26:# mueven. Hay que recalcular las tablas afectadas, no solo anadir una fila.
final/run_mixh.sh:27:#
final/run_mixh.sh:28:# Uso:   bash final/run_mixh.sh            (lanza)
final/run_mixh.sh:29:#        DRYRUN=1 bash final/run_mixh.sh   (solo cuenta trabajos)
final/run_mixh.sh:30:cd "$(dirname "$0")/.."
final/run_mixh.sh:31:
final/run_mixh.sh:32:export ARMS_OVERRIDE="MIXH"
final/run_mixh.sh:33:export ALGOS="ga abce3 feabcls tsn2"
final/run_mixh.sh:34:export PAR=${PAR:-14}
final/run_mixh.sh:35:
final/run_mixh.sh:36:echo "=== MIXH: comprobaciones previas ==="
final/run_mixh.sh:37:
final/run_mixh.sh:38:# 1. binario presente y mas nuevo que las fuentes que le afectan.
final/run_mixh.sh:39:# El bit de ejecucion no se comprueba: sobre un montaje de Windows no aparece
final/run_mixh.sh:40:# aunque el binario corra sin problemas desde WSL.
final/run_mixh.sh:41:[ -s ./FuzzyFW ] || { echo "  FALLO: no existe ./FuzzyFW"; exit 1; }
final/run_mixh.sh:42:for src in CreationIJSP.cpp CreationIJSP.h Creation.cpp; do
final/run_mixh.sh:43:  [ -f "$src" ] || continue
final/run_mixh.sh:44:  [ "$src" -nt ./FuzzyFW ] && { echo "  FALLO: $src es mas reciente que el binario;"; \
final/run_mixh.sh:45:    echo "         recompila antes de lanzar o el brazo no sera homogeneo"; exit 1; }
final/run_mixh.sh:46:done
final/run_mixh.sh:47:echo "  binario: presente y posterior a las fuentes de siembra"
final/run_mixh.sh:48:
final/run_mixh.sh:49:# 2. los 61 pools mixtos existen y tienen 1024 lineas
final/run_mixh.sh:50:n=0; bad=0
final/run_mixh.sh:51:INSTS="ft10"
final/run_mixh.sh:52:for c in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/run_mixh.sh:53:  for i in $(seq -w 1 10); do INSTS="$INSTS ${c}_${i}"; done
final/run_mixh.sh:54:done
final/run_mixh.sh:55:for inst in $INSTS; do
final/run_mixh.sh:56:  p="pools_test/corrected/int__${inst}_mix_repo_pool.csv"
final/run_mixh.sh:57:  if [ ! -f "$p" ]; then echo "  FALTA $p"; bad=$((bad+1)); continue; fi
final/run_mixh.sh:58:  l=$(wc -l < "$p"); [ "$l" -eq 1024 ] || { echo "  $p tiene $l lineas"; bad=$((bad+1)); }
final/run_mixh.sh:59:  n=$((n+1))
final/run_mixh.sh:60:done
final/run_mixh.sh:61:[ "$bad" -eq 0 ] || { echo "  FALLO: $bad pools defectuosos"; exit 1; }
final/run_mixh.sh:62:echo "  pools mixtos: $n de 61, todos con 1024 entradas"
final/run_mixh.sh:63:
final/run_mixh.sh:64:# 3. ninguna celda MIXH previa: esta corrida debe crear, nunca sobrescribir
final/run_mixh.sh:65:prev=$(ls -d final/phase2/*/*/MIXH 2>/dev/null | wc -l)
final/run_mixh.sh:66:[ "$prev" -eq 0 ] || { echo "  FALLO: ya existen $prev celdas MIXH"; exit 1; }
final/run_mixh.sh:67:echo "  celdas MIXH previas: 0"
final/run_mixh.sh:68:
final/run_mixh.sh:69:# 4. los otros brazos estan completos, para que el nuevo no compita por CPU.
final/run_mixh.sh:70:# Un solo recorrido del arbol: 1708 celdas con ls una a una tarda minutos sobre
final/run_mixh.sh:71:# un montaje de Windows.
final/run_mixh.sh:72:comp=$(find final/phase2 -mindepth 3 -maxdepth 3 -type d 2>/dev/null | wc -l)
final/run_mixh.sh:73:esp=$((4*61*7))
final/run_mixh.sh:74:echo "  celdas originales con datos: $comp de $esp"
final/run_mixh.sh:75:[ "$comp" -ge "$esp" ] || echo "  AVISO: faltan $((esp-comp)); MIXH competiria por CPU con ellas"
final/run_mixh.sh:76:
final/run_mixh.sh:77:# 5. cuantos trabajos va a generar
final/run_mixh.sh:78:echo ""
final/run_mixh.sh:79:echo "=== trabajos a generar ==="
final/run_mixh.sh:80:DRYRUN=1 bash final/run_phase2c.sh 2>&1 | tail -2
final/run_mixh.sh:81:
final/run_mixh.sh:82:if [ "${DRYRUN:-0}" = "1" ]; then
final/run_mixh.sh:83:  echo ""
final/run_mixh.sh:84:  echo "DRYRUN: nada lanzado. Para ejecutar: bash final/run_mixh.sh"
final/run_mixh.sh:85:  exit 0
final/run_mixh.sh:86:fi
final/run_mixh.sh:87:
final/run_mixh.sh:88:echo ""
final/run_mixh.sh:89:echo "=== lanzando MIXH con $PAR workers ==="
final/run_mixh.sh:90:echo "  coste estimado: ~50 h de CPU / 14 workers = ~2.1 dias"
final/run_mixh.sh:91:bash final/run_phase2c.sh
final/run_phase2c.sh:1:#!/usr/bin/env bash
final/run_phase2c.sh:2:# FASE 2 (version CHUNKED) — igual que run_phase2.sh pero partiendo los 30 runs de
final/run_phase2c.sh:3:# cada configuracion en trozos independientes, para acotar la FUGA DE MEMORIA del
final/run_phase2c.sh:4:# solver (medida 2026-07-26: ~400MB -> ~1GB por proceso a lo largo de 30 runs).
final/run_phase2c.sh:5:#
final/run_phase2c.sh:6:# Cada trozo es un proceso nuevo (muere y libera). Semillas: el framework usa
final/run_phase2c.sh:7:# seed+run, asi que trozo j con seed=1+j*CH y runs=CH reproduce EXACTAMENTE las
final/run_phase2c.sh:8:# mismas 30 semillas (1..30) que un unico runs=30 -> identico estadisticamente.
final/run_phase2c.sh:9:#
final/run_phase2c.sh:10:# Salida: final/phase2/<algo>/<inst>/<arm>/c<j>/   (un subdir por trozo)
final/run_phase2c.sh:11:# Una configuracion se considera terminada cuando TODOS sus trozos tienen stats CSV.
final/run_phase2c.sh:12:# Idempotente a nivel de trozo (se puede cortar y reanudar sin perder nada).
final/run_phase2c.sh:13:#
final/run_phase2c.sh:14:# Variables: PAR (default 10), CH (runs por trozo; default 5 para ga/abce3,
final/run_phase2c.sh:15:#            3 para feabcls/tsn2 que consumen mas por run).
final/run_phase2c.sh:16:cd "$(dirname "$0")/.."
final/run_phase2c.sh:17:RUNS=30
final/run_phase2c.sh:18:PAR=${PAR:-10}
final/run_phase2c.sh:19:CAP=900
final/run_phase2c.sh:20:OUT=${OUT_OVERRIDE:-final/phase2}
final/run_phase2c.sh:21:mkdir -p "$OUT"
final/run_phase2c.sh:22:
final/run_phase2c.sh:23:declare -A BGA=(  [15x15]=60  [20x20]=60  [30x15]=109 [30x20]=154 [50x15]=233 [50x20]=321 )
final/run_phase2c.sh:24:declare -A BAB=(  [15x15]=60  [20x20]=60  [30x15]=60  [30x20]=60  [50x15]=60  [50x20]=60 )
final/run_phase2c.sh:25:declare -A BFL=(  [15x15]=60  [20x20]=67  [30x15]=371 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:26:declare -A BTS=(  [15x15]=60  [20x20]=486 [30x15]=630 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:27:# FORCEBUD: presupuesto forzado, SOLO para el smoke test. Permite recorrer el
final/run_phase2c.sh:28:# pipeline completo en minutos por el MISMO camino de codigo que la corrida real.
final/run_phase2c.sh:29:budget() { if [ -n "$FORCEBUD" ]; then echo "$FORCEBUD"; return; fi
final/run_phase2c.sh:30:  case "$1" in ga) echo "${BGA[$2]}";; abce3) echo "${BAB[$2]}";; feabcls) echo "${BFL[$2]}";; tsn2) echo "${BTS[$2]}";; esac; }
final/run_phase2c.sh:31:chunk_size() { echo "${CH:-5}"; }   # 5 runs por trozo -> pico ~325 MB/worker (medido)
final/run_phase2c.sh:32:clase() { case "$1" in
final/run_phase2c.sh:33:  ft10|tai15_15_*) echo 15x15 ;; tai20_20_*) echo 20x20 ;; tai30_15_*) echo 30x15 ;;
final/run_phase2c.sh:34:  tai30_20_*) echo 30x20 ;; tai50_15_*) echo 50x15 ;; tai50_20_*) echo 50x20 ;;
final/run_phase2c.sh:35:esac; }
final/run_phase2c.sh:36:instfile() { if [ "$1" = "ft10" ]; then echo "SelectosYTaillardIntervalos/F0.15.0.ft10_10.txt";
final/run_phase2c.sh:37:  else echo "SelectosYTaillardIntervalos/$1.F.15_01.txt"; fi }
final/run_phase2c.sh:38:armspec() { case "$1" in
final/run_phase2c.sh:39:  A0) echo ", 0";; V2H) echo "v2, 125";; V2) echo "v2, 250";; MOR) echo "graspmor, 250";;
final/run_phase2c.sh:40:  GT) echo "gtmwkr, 250";; GP) echo "gp, 250";; MIX) echo "mix, 250";;
final/run_phase2c.sh:41:  MIXH) echo "mix, 125";;
final/run_phase2c.sh:42:esac; }
final/run_phase2c.sh:43:
final/run_phase2c.sh:44:# INSTS_OVERRIDE y OUT_OVERRIDE: para el smoke test, mismo codigo pero
final/run_phase2c.sh:45:# pocas instancias y directorio aparte, sin tocar los datos reales.
final/run_phase2c.sh:46:if [ -n "$INSTS_OVERRIDE" ]; then
final/run_phase2c.sh:47:  INSTS="$INSTS_OVERRIDE"
final/run_phase2c.sh:48:else
final/run_phase2c.sh:49:INSTS="ft10"
final/run_phase2c.sh:50:for cls in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/run_phase2c.sh:51:  for i in $(seq -w 1 10); do INSTS="$INSTS ${cls}_${i}"; done
final/run_phase2c.sh:52:done
final/run_phase2c.sh:53:fi
final/run_phase2c.sh:54:# ARMS_OVERRIDE permite anadir un brazo sin retocar el resto: los trozos ya
final/run_phase2c.sh:55:# completos se saltan de todos modos, pero limitar la lista hace explicito que
final/run_phase2c.sh:56:# la corrida no puede tocar celdas existentes.
final/run_phase2c.sh:57:ARMS=${ARMS_OVERRIDE:-"A0 V2H V2 MOR GT GP MIX"}
final/run_phase2c.sh:58:ALGOS=${ALGOS:-"ga feabcls tsn2"}   # abce3 ya completo; ga parcialmente
final/run_phase2c.sh:59:
final/run_phase2c.sh:60:# En DRYRUN la lista va a un temporal: un ensayo no debe tocar ni siquiera el
final/run_phase2c.sh:61:# fichero de trabajos del experimento.
final/run_phase2c.sh:62:JOB="$OUT/joblist_chunk.txt"
final/run_phase2c.sh:63:[ "${DRYRUN:-0}" = "1" ] && JOB="${DRYJOB:-$(mktemp)}"
final/run_phase2c.sh:64:: > "$JOB"; skipc=0; skipm=0; todo=0
final/run_phase2c.sh:65:for algo in $ALGOS; do
final/run_phase2c.sh:66:  ch=$(chunk_size "$algo")
final/run_phase2c.sh:67:  nch=$(( (RUNS + ch - 1) / ch ))
final/run_phase2c.sh:68:  for inst in $INSTS; do
final/run_phase2c.sh:69:    cls=$(clase "$inst"); bud=$(budget "$algo" "$cls"); f=$(instfile "$inst")
final/run_phase2c.sh:70:    for arm in $ARMS; do
final/run_phase2c.sh:71:      base="$OUT/$algo/$inst/$arm"
final/run_phase2c.sh:72:      # si la config ya se completo en el formato antiguo (runs=30 monolitico), saltar
final/run_phase2c.sh:73:      mono=$(ls "$base"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:74:      [ -n "$mono" ] && { skipm=$((skipm+1)); continue; }
final/run_phase2c.sh:75:      spec=$(armspec "$arm"); g=${spec%%,*}; k=$(echo "${spec##*,}" | tr -d ' ')
final/run_phase2c.sh:76:      for j in $(seq 1 $nch); do
final/run_phase2c.sh:77:        d="$base/c$j"
final/run_phase2c.sh:78:        csv=$(ls "$d"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:79:        [ -n "$csv" ] && { skipc=$((skipc+1)); continue; }
final/run_phase2c.sh:80:        todo=$((todo+1))
final/run_phase2c.sh:81:        seed=$(( 1 + (j-1)*ch ))
final/run_phase2c.sh:82:        pool=""
final/run_phase2c.sh:83:        if [ "$k" -gt 0 ]; then
final/run_phase2c.sh:84:          pool="pools_test/corrected/int__${inst}_${g}_repo_pool.csv"
final/run_phase2c.sh:85:          [ -f "$pool" ] || { echo "FALTA pool: $pool"; exit 1; }
final/run_phase2c.sh:86:        fi
final/run_phase2c.sh:87:        # DRYRUN no debe TOCAR EL DISCO. Antes creaba el directorio y escribia
final/run_phase2c.sh:88:        # setup.txt antes de comprobar la variable, de modo que un "ensayo"
final/run_phase2c.sh:89:        # dejaba miles de ficheros y ensuciaba el arbol del experimento.
final/run_phase2c.sh:90:        if [ "${DRYRUN:-0}" != "1" ]; then
final/run_phase2c.sh:91:        rm -rf "$d"; mkdir -p "$d"
final/run_phase2c.sh:92:        sed -e "s/^runs = .*/runs = $ch/" -e "s/^seed = .*/seed = $seed/" "repro/setup_${algo}.txt" > "$d/setup.txt"
final/run_phase2c.sh:93:        sed -i "s/^noimprovement = .*/generations = 100000/" "$d/setup.txt"
final/run_phase2c.sh:94:        if grep -q '^timelimit' "$d/setup.txt"; then sed -i "s/^timelimit = .*/timelimit = $bud/" "$d/setup.txt"
final/run_phase2c.sh:95:        else echo "timelimit = $bud" >> "$d/setup.txt"; fi
final/run_phase2c.sh:96:        if [ -n "$pool" ]; then
final/run_phase2c.sh:97:          sed -i "s/^creation = ijsp.random/creation = ijsp.seeded/" "$d/setup.txt"
final/run_phase2c.sh:98:          # INDICE GLOBAL de la primera ejecucion de este trozo. Sin el, cada
final/run_phase2c.sh:99:          # proceso reinicia su contador y los 6 trozos repiten los mismos
final/run_phase2c.sh:100:          # bloques del pool: 5 poblaciones iniciales en vez de 30.
final/run_phase2c.sh:101:          { echo ""; echo "creation.seed.pool = $pool"; echo "creation.seed.count = $k";
final/run_phase2c.sh:102:            echo "creation.seed.offset = $(( (j-1)*ch ))"; } >> "$d/setup.txt"
final/run_phase2c.sh:103:        fi
final/run_phase2c.sh:104:        fi
final/run_phase2c.sh:105:        echo "./FuzzyFW '$d/setup.txt' '$f' '$d' > '$d/log.txt' 2>&1" >> "$JOB"
final/run_phase2c.sh:106:      done
final/run_phase2c.sh:107:    done
final/run_phase2c.sh:108:  done
final/run_phase2c.sh:109:done
final/run_phase2c.sh:110:echo "configs ya completas (monoliticas): $skipm | trozos ya hechos: $skipc | trozos pendientes: $todo"
final/run_phase2c.sh:111:if [ "${DRYRUN:-0}" = "1" ]; then echo "DRYRUN: nada lanzado."; exit 0; fi
final/run_phase2c.sh:112:echo "Inicio PHASE2C: $(date) | $todo trozos, <=$PAR, chunk ga/abce3=${CH:-5} feabcls/tsn2=${CH:-3}" | tee -a "$OUT/run.log"
final/run_phase2c.sh:113:cat "$JOB" | xargs -I CMD -P "$PAR" bash -c CMD
final/run_phase2c.sh:114:echo "PHASE2C DONE: $(date)" | tee -a "$OUT/run.log"
final/build_mix_interleaved.sh:1:#!/usr/bin/env bash
final/build_mix_interleaved.sh:2:# PROTOTIPO: pool MIX de 1024 entradas ENTRELAZADO FINO (v2, GT, gp, v2, GT, gp...)
final/build_mix_interleaved.sh:3:# en lugar de por bloques de 84/83/83.
final/build_mix_interleaved.sh:4:#
final/build_mix_interleaved.sh:5:# El problema del MIX actual no es el tamano sino el ORDEN: al estar en bloques
final/build_mix_interleaved.sh:6:# con periodo 250, las ventanas que dan la vuelta quedan descompensadas
final/build_mix_interleaved.sh:7:# (108/83/59 en vez de 84/83/83). Con entrelazado fino, CUALQUIER ventana de 250
final/build_mix_interleaved.sh:8:# contiene ~83 de cada generador, sea cual sea el desplazamiento, y el tamano del
final/build_mix_interleaved.sh:9:# pool deja de importar para la composicion.
final/build_mix_interleaved.sh:10:#
final/build_mix_interleaved.sh:11:# No genera soluciones nuevas: reutiliza las que ya hay en los pools simples.
final/build_mix_interleaved.sh:12:cd "$(dirname "$0")/.."
final/build_mix_interleaved.sh:13:inst=${1:-tai30_20_01}; N=${2:-1024}
final/build_mix_interleaved.sh:14:P=pools_test/corrected
final/build_mix_interleaved.sh:15:out="/tmp/mix_interleaved_${inst}_${N}.csv"
final/build_mix_interleaved.sh:16:: > "$out"
final/build_mix_interleaved.sh:17:per=$(( (N + 2) / 3 ))          # cuantas de cada generador
final/build_mix_interleaved.sh:18:for ((i=1; i<=per; i++)); do
final/build_mix_interleaved.sh:19:  for g in v2 gtmwkr gp; do
final/build_mix_interleaved.sh:20:    [ "$(wc -l < "$out")" -ge "$N" ] && break 2
final/build_mix_interleaved.sh:21:    sed -n "${i}p" "$P/int__${inst}_${g}_repo_pool.csv" >> "$out"
final/build_mix_interleaved.sh:22:  done
final/build_mix_interleaved.sh:23:done
final/build_mix_interleaved.sh:24:echo "generado: $out  ($(wc -l < "$out") entradas)"
final/build_mix_interleaved.sh:25:
final/build_mix_interleaved.sh:26:# --- validacion: composicion de las 30 ventanas que realmente se usan ---
final/build_mix_interleaved.sh:27:for g in v2 gtmwkr gp; do
final/build_mix_interleaved.sh:28:  cut -d';' -f1 "$P/int__${inst}_${g}_repo_pool.csv" | sed 's/[[:space:]]*$//' | sort -u > "/tmp/v_$g.txt"
final/build_mix_interleaved.sh:29:done
final/build_mix_interleaved.sh:30:L=$(wc -l < "$out")
final/build_mix_interleaved.sh:31:echo ""
final/build_mix_interleaved.sh:32:echo "=== composicion (v2/GT/gp) de los 30 bloques que usaria el experimento ==="
final/build_mix_interleaved.sh:33:peor=0
final/build_mix_interleaved.sh:34:for r in $(seq 0 29); do
final/build_mix_interleaved.sh:35:  s=$(( (r*250) % L ))
final/build_mix_interleaved.sh:36:  { for ((i=0;i<250;i++)); do echo $(( (s+i) % L + 1 )); done; } | sort -n | \
final/build_mix_interleaved.sh:37:    while read -r ln; do sed -n "${ln}p" "$out"; done | cut -d';' -f1 | sed 's/[[:space:]]*$//' | sort -u > /tmp/vb.txt
final/build_mix_interleaved.sh:38:  c=""
final/build_mix_interleaved.sh:39:  for g in v2 gtmwkr gp; do c="$c $(comm -12 /tmp/vb.txt "/tmp/v_$g.txt" | wc -l)"; done
final/build_mix_interleaved.sh:40:  set -- $c
final/build_mix_interleaved.sh:41:  d=$(( $1 > $2 ? $1 - $2 : $2 - $1 )); e=$(( $1 > $3 ? $1 - $3 : $3 - $1 ))
final/build_mix_interleaved.sh:42:  [ "$e" -gt "$d" ] && d=$e
final/build_mix_interleaved.sh:43:  [ "$d" -gt "$peor" ] && peor=$d
final/build_mix_interleaved.sh:44:  [ "$r" -lt 3 ] || [ "$r" -gt 27 ] && printf "  bloque %2d (inicio %4d) ->%s\n" "$r" "$s" "$c"
final/build_mix_interleaved.sh:45:done
final/build_mix_interleaved.sh:46:echo ""
final/build_mix_interleaved.sh:47:echo "  maximo desequilibrio entre generadores en cualquier bloque: $peor"
final/build_mix_interleaved.sh:48:echo "  (con el MIX actual truncado a 1024 el desequilibrio llegaba a 49: 108 vs 59)"
final/check_mix_layout.sh:1:#!/usr/bin/env bash
final/check_mix_layout.sh:2:# ¿Como esta ORDENADO el pool MIX? Critico: con ejecucion por trozos solo se usan
final/check_mix_layout.sh:3:# las primeras 1250 entradas. Si el pool esta por BLOQUES de generador, el brazo
final/check_mix_layout.sh:4:# MIX de fEABCLS y TSN2 no habria sido mixto en absoluto, sino un solo generador.
final/check_mix_layout.sh:5:# Si esta intercalado, las primeras 1250 son una muestra mixta representativa.
final/check_mix_layout.sh:6:cd "$(dirname "$0")/.."
final/check_mix_layout.sh:7:inst=${1:-tai30_20_01}
final/check_mix_layout.sh:8:P=pools_test/corrected
final/check_mix_layout.sh:9:mix="$P/int__${inst}_mix_repo_pool.csv"
final/check_mix_layout.sh:10:
final/check_mix_layout.sh:11:# firma de una solucion = su permutacion (sin el makespan)
final/check_mix_layout.sh:12:sig() { cut -d';' -f1 "$1" | sed 's/[[:space:]]*$//'; }
final/check_mix_layout.sh:13:
