final/ttt_null.R:1:# ¿CONTROLA EL TEST DE SIGNOS EL ERROR DE TIPO I CON UN OBJETIVO ENDOGENO?
final/ttt_null.R:2:#
final/ttt_null.R:3:# Objecion (valida) a ttt_paired.R: el objetivo de cada instancia se construye a
final/ttt_null.R:4:# partir del endpoint del PROPIO control, de modo que A0 se evalua contra una
final/ttt_null.R:5:# diana extraida de su propia realizacion y el brazo sembrado no. Que la
final/ttt_null.R:6:# truncatura no invierta signos no basta para justificar el nulo binomial
final/ttt_null.R:7:# P(antes) = P(despues) = 0.5: hay que demostrar la intercambiabilidad, o
final/ttt_null.R:8:# medirla.
final/ttt_null.R:9:#
final/ttt_null.R:10:# Aqui se mide, sin suponer nada, y REPRODUCIENDO LA ESTRUCTURA DEL ANALISIS
final/ttt_null.R:11:# REAL: alli se comparan dos curvas promediadas sobre ejecuciones, no dos
final/ttt_null.R:12:# ejecuciones sueltas, y el promediado cambia el ruido.
final/ttt_null.R:13:#
final/ttt_null.R:14:#   por instancia: las 30 ejecuciones de A0 se parten al azar en dos mitades de
final/ttt_null.R:15:#   15; cada mitad se promedia sobre la misma rejilla; una hace de "control" y
final/ttt_null.R:16:#   fija el objetivo endpoint*1.005 en makespan, la otra de "brazo". Se forma la
final/ttt_null.R:17:#   diferencia emparejada y se aplica el test de signos sobre las 61 instancias.
final/ttt_null.R:18:#
final/ttt_null.R:19:# Ambas mitades proceden del MISMO proceso, luego H0 es cierta por construccion.
final/ttt_null.R:20:# Si el procedimiento es valido, la proporcion de "antes" debe rondar 0.5 y el
final/ttt_null.R:21:# test debe rechazar el 5% de las veces a alfa = 0.05. Toda desviacion es sesgo
final/ttt_null.R:22:# del objetivo endogeno, no efecto de la siembra.
final/ttt_null.R:23:set.seed(20260826)
final/ttt_null.R:24:B <- 400            # replicas
final/ttt_null.R:25:NG <- 200           # puntos de rejilla por instancia
final/ttt_null.R:26:ALPHA <- 0.05
final/ttt_null.R:27:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/ttt_null.R:28:
final/ttt_null.R:29:cat("=== Error de tipo I del test de signos bajo objetivo endogeno ===\n")
final/ttt_null.R:30:cat(sprintf("    %d replicas; cada una parte las 30 ejecuciones de A0 en 15+15 y promedia\n", B))
final/ttt_null.R:31:cat("    H0 cierta por construccion: ambas mitades salen del mismo proceso\n")
final/ttt_null.R:32:cat("    esperado si el procedimiento es valido: antes = 50%, rechazo = 5%\n\n")
final/ttt_null.R:33:cat(sprintf("  %-8s %7s %15s %14s %11s\n",
final/ttt_null.R:34:            "solver", "n inst", "P(antes) media", "rechazo a 5%", "veredicto"))
final/ttt_null.R:35:
final/ttt_null.R:36:res <- data.frame()
final/ttt_null.R:37:for (al in names(algos)) {
final/ttt_null.R:38:  d <- read.csv(sprintf("final/phase2/a0_traces_%s.csv", al), stringsAsFactors = FALSE)
final/ttt_null.R:39:  insts <- unique(d$inst)
final/ttt_null.R:40:
final/ttt_null.R:41:  # Por instancia: matriz V de 30 ejecuciones x NG puntos de rejilla, con el
final/ttt_null.R:42:  # mejor-hasta-ahora de cada ejecucion evaluado en la rejilla. La rejilla
final/ttt_null.R:43:  # empieza cuando TODAS las ejecuciones han reportado, para que la media no
final/ttt_null.R:44:  # cambie de composicion (mismo criterio que resample_anytime.sh).
final/ttt_null.R:45:  mats <- list()
final/ttt_null.R:46:  for (i in insts) {
final/ttt_null.R:47:    x <- d[d$inst == i, ]
final/ttt_null.R:48:    rs <- split(x[, c("t","v")], x$run)
final/ttt_null.R:49:    if (length(rs) < 4) next
final/ttt_null.R:50:    t0 <- max(sapply(rs, function(z) min(z$t)))
final/ttt_null.R:51:    t1 <- max(sapply(rs, function(z) max(z$t)))
final/ttt_null.R:52:    if (!(t1 > t0)) next
final/ttt_null.R:53:    G <- seq(t0, t1, length.out = NG)
final/ttt_null.R:54:    V <- t(sapply(rs, function(z) {
final/ttt_null.R:55:      z <- z[order(z$t), ]
final/ttt_null.R:56:      z$v[pmax(1, findInterval(G, z$t))]
final/ttt_null.R:57:    }))
final/ttt_null.R:58:    mats[[i]] <- V
final/ttt_null.R:59:  }
final/ttt_null.R:60:  ok_inst <- names(mats)
final/ttt_null.R:61:
final/ttt_null.R:62:  antes_tot <- 0; desp_tot <- 0; rech <- 0; usadas <- 0
final/ttt_null.R:63:  for (b in 1:B) {
final/ttt_null.R:64:    dif <- numeric(0)
final/ttt_null.R:65:    for (i in ok_inst) {
final/ttt_null.R:66:      V <- mats[[i]]; n <- nrow(V)
final/ttt_null.R:67:      idx <- sample(n); h1 <- idx[1:floor(n/2)]; h2 <- idx[(floor(n/2)+1):n]
final/ttt_null.R:68:      c1 <- colMeans(V[h1, , drop = FALSE])       # "control"
final/ttt_null.R:69:      c2 <- colMeans(V[h2, , drop = FALSE])       # "brazo"
final/ttt_null.R:70:      obj <- c1[NG] * 1.005
final/ttt_null.R:71:      j1 <- which(c1 <= obj); j2 <- which(c2 <= obj)
final/ttt_null.R:72:      T1 <- if (length(j1)) j1[1]/NG else 1.0
final/ttt_null.R:73:      T2 <- if (length(j2)) j2[1]/NG else 1.0
final/ttt_null.R:74:      dif <- c(dif, T2 - T1)
final/ttt_null.R:75:    }
final/ttt_null.R:76:    a <- sum(dif < 0); p <- sum(dif > 0)
final/ttt_null.R:77:    antes_tot <- antes_tot + a; desp_tot <- desp_tot + p
final/ttt_null.R:78:    if (a + p > 0) {
final/ttt_null.R:79:      usadas <- usadas + 1
final/ttt_null.R:80:      if (binom.test(a, a + p)$p.value < ALPHA) rech <- rech + 1
final/ttt_null.R:81:    }
final/ttt_null.R:82:  }
final/ttt_null.R:83:  pa <- antes_tot / (antes_tot + desp_tot)
final/ttt_null.R:84:  tr <- rech / usadas
final/ttt_null.R:85:  ver <- if (abs(pa - 0.5) < 0.03 && tr < 0.10) "calibrado" else "SESGADO"
final/ttt_null.R:86:  cat(sprintf("  %-8s %7d %14.1f%% %13.1f%% %11s\n",
final/ttt_null.R:87:              algos[[al]], length(ok_inst), 100*pa, 100*tr, ver))
final/ttt_null.R:88:  res <- rbind(res, data.frame(algo = al, n_inst = length(ok_inst),
final/ttt_null.R:89:                               p_antes_nulo = pa, tipo_I = tr))
final/ttt_null.R:90:}
final/ttt_null.R:91:write.csv(res, "final/ttt_null.csv", row.names = FALSE)
final/ttt_null.R:92:cat("\nescrito: final/ttt_null.csv\n")

