              median(iccs), mean(iccs), min(iccs), max(iccs)))
  cat(sprintf("  n efectivo de las 30 ejecuciones:  mediana %.1f   media %.1f   rango [%.1f, %.1f]\n\n",
              median(nef), mean(nef), min(nef), max(nef)))
}
