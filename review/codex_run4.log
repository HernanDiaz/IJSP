\label{tab:tsn2class}
\begin{tabular}{lccccc}
\toprule
Class & $n$ & $\mathbb{E}[C_{\max}]$ A0 & $\mathbb{E}[C_{\max}]$ MIX & $\Delta$ (\%) & Share \\
\midrule
$10\times10$ & 1  & 937.1  & 944.5  & $+0.78$ & --- \\
