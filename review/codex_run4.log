final/fig_anytime_paper.R:57:    z <- z[z$inst %in% ok, ]
final/fig_anytime_paper.R:58:    if (nrow(z)) {
final/fig_anytime_paper.R:59:      dt <- median(unlist(lapply(split(z, paste(z$inst, z$run)),
final/fig_anytime_paper.R:60:                                 function(x) diff(sort(x$t)))), na.rm = TRUE)
final/fig_anytime_paper.R:61:      span <- diff(range(grid_t[keep]))
final/fig_anytime_paper.R:62:      if (is.finite(dt) && dt > span / 40) {          # menos de ~40 muestras
final/fig_anytime_paper.R:63:        st <- sort(unique(round(z$t / dt) * dt))
final/fig_anytime_paper.R:64:        st <- st[st >= min(grid_t[keep]) & st <= max(grid_t[keep])]
final/fig_anytime_paper.R:65:        idx <- sapply(st, function(tt) which.min(abs(grid_t[keep] - tt)))
final/fig_anytime_paper.R:66:        for (a in c("A0", "MIX"))
final/fig_anytime_paper.R:67:          points(grid_t[keep][idx], M[keep, a][idx], bg = cols[[a]],
final/fig_anytime_paper.R:68:                 col = "white", pch = 21, cex = 0.9, lwd = 1.1)
final/fig_anytime_paper.R:69:      }
final/fig_anytime_paper.R:70:    }
final/fig_anytime_paper.R:71:  }
final/fig_anytime_paper.R:72:  legend("topright", legend = unname(arms), col = cols[names(arms)], lty = ltys[names(arms)],
final/fig_anytime_paper.R:73:         lwd = lwds[names(arms)], bty = "n", cex = 0.72)
final/fig_anytime_paper.R:74:}
final/fig_anytime_paper.R:75:dev.off()
final/fig_anytime_paper.R:76:cat("figura: final/figs/anytime_50x20.png\n")
final/pool_blocks.R:1:# ¿Se ve estructura de 3 bloques (342/341/341) en el pool v2, y no en los otros?
final/pool_blocks.R:2:lee <- function(f) {
final/pool_blocks.R:3:  x <- readLines(f)
final/pool_blocks.R:4:  as.numeric(sub("^.*, *([0-9.]+)\\]$", "\\1", x))     # extremo superior
final/pool_blocks.R:5:}
final/pool_blocks.R:6:prueba <- function(inst, gen) {
final/pool_blocks.R:7:  f <- sprintf("pools_test/corrected/int__%s_%s_repo_pool.csv", inst, gen)
final/pool_blocks.R:8:  if (!file.exists(f)) return(invisible(NULL))
final/pool_blocks.R:9:  up <- lee(f)
final/pool_blocks.R:10:  if (any(is.na(up))) { cat(sprintf("%-14s %-9s parseo fallido\n", inst, gen)); return(invisible(NULL)) }
final/pool_blocks.R:11:  b <- c(rep(1,342), rep(2,341), rep(3,341))[seq_along(up)]
final/pool_blocks.R:12:  m <- tapply(up, b, mean)
final/pool_blocks.R:13:  p <- kruskal.test(up ~ factor(b))$p.value
final/pool_blocks.R:14:  cat(sprintf("%-14s %-9s %.1f / %.1f / %.1f   p=%.2e %s\n",
final/pool_blocks.R:15:      inst, gen, m[1], m[2], m[3], p,
final/pool_blocks.R:16:      ifelse(p < 0.001, "<- BLOQUES DISTINTOS", "")))
final/pool_blocks.R:17:}
final/pool_blocks.R:18:cat("Media del extremo superior por tercio del fichero (342/341/341)\n")
final/pool_blocks.R:19:cat("Si el pool son 3 bloques de checkpoints distintos, los tercios difieren.\n\n")
final/pool_blocks.R:20:for (inst in c("tai30_20_01","tai50_20_01","tai15_15_05","tai20_20_07")) {
final/pool_blocks.R:21:  for (gen in c("v2","gp","gtmwkr")) prueba(inst, gen)
final/pool_blocks.R:22:  cat("\n")
final/pool_blocks.R:23:}
final/gen_cost.R:1:# Coste de generar las 250 semillas de UNA ejecucion frente al presupuesto.
final/gen_cost.R:2:# GP y GT: medidos (log del 13 de julio, 1024 soluciones por pool, 1 hilo).
final/gen_cost.R:3:# v2: EXTRAPOLADO desde tiempos de inferencia por rollout. No es una medida.
final/gen_cost.R:4:cls  <- c("15x15","20x20","30x15","30x20","50x15","50x20")
final/gen_cost.R:5:gp   <- c(91,205,301,486,834,1255)/1024      # s por solucion
final/gen_cost.R:6:gt   <- c(89,257,299,489,1052,1500)/1024
final/gen_cost.R:7:v2   <- c(0.60,  NA, NA, 1.86, NA, 3.98)     # medidos solo en 4 clases
final/gen_cost.R:8:bud  <- list(GA=c(60,60,109,154,233,321), ABCE3=rep(60,6),
final/gen_cost.R:9:             fEABCLS=c(60,67,371,900,900,900), TSN2=c(60,486,630,900,900,900))
final/gen_cost.R:10:
final/gen_cost.R:11:cat("Coste de las 250 semillas de UNA ejecucion (s), un hilo:\n\n")
final/gen_cost.R:12:cat(sprintf("%-8s %8s %8s %8s\n","clase","GP","GT","v2*"))
final/gen_cost.R:13:for (i in seq_along(cls))
final/gen_cost.R:14:  cat(sprintf("%-8s %8.0f %8.0f %8s\n", cls[i], 250*gp[i], 250*gt[i],
final/gen_cost.R:15:      ifelse(is.na(v2[i]), "--", sprintf("%.0f", 250*v2[i]))))
final/gen_cost.R:16:
final/gen_cost.R:17:cat("\nFrente al 10% del presupuesto de cada solver (razon coste/presupuesto):\n\n")
final/gen_cost.R:18:cat(sprintf("%-8s %10s %10s %10s %10s\n","clase","GA","ABCE3","fEABCLS","TSN2"))
final/gen_cost.R:19:for (i in seq_along(cls)) {
final/gen_cost.R:20:  r <- sapply(names(bud), function(s) 250*gp[i] / (0.10*bud[[s]][i]))
final/gen_cost.R:21:  cat(sprintf("%-8s %9.0fx %9.0fx %9.0fx %9.0fx\n", cls[i], r[1], r[2], r[3], r[4]))
final/gen_cost.R:22:}
final/gen_cost.R:23:cat("  (GP, el mas barato de los tres; con v2 multiplica por ~3)\n")
final/gen_cost.R:24:
final/gen_cost.R:25:cat("\nAmortizado sobre las 30 ejecuciones que comparten el pool:\n\n")
final/gen_cost.R:26:cat(sprintf("%-8s %10s %10s %10s %10s\n","clase","GA","ABCE3","fEABCLS","TSN2"))
final/gen_cost.R:27:for (i in seq_along(cls)) {
final/gen_cost.R:28:  r <- sapply(names(bud), function(s) (1024*gp[i]/30) / (0.10*bud[[s]][i]))
final/gen_cost.R:29:  cat(sprintf("%-8s %9.1fx %9.1fx %9.1fx %9.1fx\n", cls[i], r[1], r[2], r[3], r[4]))
final/gen_cost.R:30:}
final/ttt_paired.R:1:# TIME-TO-TARGET EMPAREJADO POR INSTANCIA.
final/ttt_paired.R:2:#
final/ttt_paired.R:3:# Sustituye al analisis log-rank anterior (ttt_survival.R), que era invalido
final/ttt_paired.R:4:# para este diseno por DOS motivos, no uno:
final/ttt_paired.R:5:#
final/ttt_paired.R:6:#   1. Emparejamiento. survdiff() trata el brazo sembrado y el control como dos
final/ttt_paired.R:7:#      muestras independientes. No lo son: comparten instancia, presupuesto y
final/ttt_paired.R:8:#      objetivo, y se ejecutan sobre las mismas 61 instancias.
final/ttt_paired.R:9:#
final/ttt_paired.R:10:#   2. Asimetria estructural del grupo de referencia. El objetivo de cada
final/ttt_paired.R:11:#      instancia se define como el endpoint del PROPIO control (+0.5%), luego
final/ttt_paired.R:12:#      A0 lo alcanza en 61 de 61 instancias por construccion: su muestra NO
final/ttt_paired.R:13:#      PUEDE censurarse. Los brazos sembrados si. Un log-rank contrasta
final/ttt_paired.R:14:#      entonces una muestra censurada contra otra que es incensurable por
final/ttt_paired.R:15:#      definicion, y su p-valor no significa lo que aparenta.
final/ttt_paired.R:16:#
final/ttt_paired.R:17:# Dato base: T_brazo(i) = fraccion del presupuesto en que el brazo alcanza el
final/ttt_paired.R:18:# objetivo en la instancia i, restringida en 1.0 si no lo alcanza. La diferencia
final/ttt_paired.R:19:# emparejada es
final/ttt_paired.R:20:#
final/ttt_paired.R:21:#     d_i = T_brazo(i) - T_A0(i),   i = 1..61     (negativo = el brazo llega antes)
final/ttt_paired.R:22:#
final/ttt_paired.R:23:# QUE CONTRASTE ES VALIDO AQUI.
final/ttt_paired.R:24:#
final/ttt_paired.R:25:#   - El estimando de la media es explicitamente el TIEMPO MEDIO RESTRINGIDO
final/ttt_paired.R:26:#     E[min(T,1)]. Registrar al no alcanzador en 1.0 no es un sesgo: es la
final/ttt_paired.R:27:#     definicion de ese estimando. Lo que subestima es la media SIN restringir,
final/ttt_paired.R:28:#     que es otra cosa y no se reporta.
final/ttt_paired.R:29:#   - El signo de d nunca se invierte por la restriccion, pero si puede EMPATAR
final/ttt_paired.R:30:#     cuando A0 tambien llega en 1.0; los empates se descartan, como es habitual
final/ttt_paired.R:31:#     en el test de signos.
final/ttt_paired.R:32:#   - El objetivo es ENDOGENO: se extrae del endpoint del propio A0, de modo que
final/ttt_paired.R:33:#     A0 se evalua contra una diana sacada de su realizacion y el brazo no. Eso
final/ttt_paired.R:34:#     no garantiza el nulo binomial en 0.5, y no se supone: ttt_null.R lo MIDE
final/ttt_paired.R:35:#     partiendo las 30 ejecuciones de A0 en dos mitades bajo H0 cierta. El
final/ttt_paired.R:36:#     resultado es que el procedimiento esta casi calibrado (error de tipo I
final/ttt_paired.R:37:#     3.2%-6.8% frente al 5% nominal) pero con un ligero sesgo en contra del
final/ttt_paired.R:38:#     brazo: bajo H0 cuenta como "antes" solo el 45-49% de las veces. El test de
final/ttt_paired.R:39:#     signos se contrasta por tanto CONTRA ESA PROPORCION NULA, no contra 0.5.
final/ttt_paired.R:40:#
final/ttt_paired.R:41:# Inferencia, toda emparejada por instancia:
final/ttt_paired.R:42:#   - PRINCIPAL: test de signos exacto sobre las 61 diferencias (binomial),
final/ttt_paired.R:43:#     equivalente a contar en cuantas instancias el brazo llega antes que su
final/ttt_paired.R:44:#     control. Holm sobre los 6 brazos de cada solver.
final/ttt_paired.R:45:#   - SECUNDARIO: diferencia de tiempo medio restringido (RMTT) con IC 95% por
final/ttt_paired.R:46:#     bootstrap percentil remuestreando INSTANCIAS (B=10000) y p por permutacion
final/ttt_paired.R:47:#     de signos (B=20000).
final/ttt_paired.R:48:#   - Cuando principal y secundario discrepan, el efecto no es un desplazamiento
final/ttt_paired.R:49:#     general sino una mejora concentrada en un subconjunto de instancias. Se
final/ttt_paired.R:50:#     reporta explicitamente.
final/ttt_paired.R:51:#
final/ttt_paired.R:52:# Las curvas de Kaplan-Meier se conservan SOLO como descripcion.
final/ttt_paired.R:53:suppressPackageStartupMessages(library(survival))
final/ttt_paired.R:54:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/ttt_paired.R:55:nulo <- read.csv("final/ttt_null.csv", stringsAsFactors = FALSE)   # proporcion nula por solver
final/ttt_paired.R:56:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/ttt_paired.R:57:arms <- c("A0","V2H","V2","MOR","GT","GP","MIX","MIXH")
final/ttt_paired.R:58:seeded <- setdiff(arms, "A0")
final/ttt_paired.R:59:set.seed(20260825)
final/ttt_paired.R:60:BPERM <- 20000
final/ttt_paired.R:61:BBOOT <- 10000
final/ttt_paired.R:62:
final/ttt_paired.R:63:# p de permutacion de signos sobre las diferencias emparejadas (bilateral)
final/ttt_paired.R:64:perm_p <- function(x, B = BPERM) {
final/ttt_paired.R:65:  n <- length(x); obs <- abs(mean(x))
final/ttt_paired.R:66:  S <- matrix(sample(c(-1, 1), n * B, replace = TRUE), nrow = n)
final/ttt_paired.R:67:  (1 + sum(abs(colMeans(S * x)) >= obs - 1e-12)) / (B + 1)
final/ttt_paired.R:68:}
final/ttt_paired.R:69:# IC percentil remuestreando instancias
final/ttt_paired.R:70:boot_ci <- function(x, B = BBOOT) {
final/ttt_paired.R:71:  n <- length(x)
final/ttt_paired.R:72:  M <- matrix(sample(x, n * B, replace = TRUE), nrow = n)
final/ttt_paired.R:73:  unname(quantile(colMeans(M), c(0.025, 0.975)))
final/ttt_paired.R:74:}
final/ttt_paired.R:75:
final/ttt_paired.R:76:cat("=== Tiempo hasta la calidad final del control (+0.5%), EMPAREJADO ===\n")
final/ttt_paired.R:77:cat("    T = fraccion del presupuesto de la celda; no alcanzadores restringidos en 1.0\n")
final/ttt_paired.R:78:cat("    dif = RMTT(brazo) - RMTT(A0); negativo = el brazo llega antes\n")
final/ttt_paired.R:79:cat("    p = permutacion de signos (B=20000), Holm sobre los 6 brazos de cada solver\n\n")
final/ttt_paired.R:80:
final/ttt_paired.R:81:todo <- data.frame()
final/ttt_paired.R:82:for (al in names(algos)) {
final/ttt_paired.R:83:  d <- read.csv(sprintf("final/phase2/anytime_%s.csv", al), stringsAsFactors = FALSE)
final/ttt_paired.R:84:  d <- merge(d, lb, by = "inst"); d$rpd <- 100 * (d$bestcmax - d$lb) / d$lb
final/ttt_paired.R:85:  p0 <- nulo$p_antes_nulo[nulo$algo == al]; if (!length(p0)) p0 <- 0.5
final/ttt_paired.R:86:  insts <- Reduce(intersect, lapply(arms, function(a) unique(d$inst[d$arm == a])))
final/ttt_paired.R:87:
final/ttt_paired.R:88:  # Objetivo por instancia: el endpoint del control mas un 0.5%, EN MAKESPAN.
final/ttt_paired.R:89:  # Aplicar el 1.005 al RPD no es equivalente y es mucho mas estricto:
final/ttt_paired.R:90:  #   RPD_s <= 1.005*RPD_A0   <=>   C_s <= 1.005*C_A0 - 0.005*LB
final/ttt_paired.R:91:  # es decir, en RPD el objetivo correcto es 1.005*RPD_A0 + 0.5. Con RPD del
final/ttt_paired.R:92:  # orden del 10%, multiplicar el RPD da un umbral de 10.05% donde el declarado
final/ttt_paired.R:93:  # es 10.55%: una tolerancia veinte veces menor. Se usa el makespan crudo.
final/ttt_paired.R:94:  fin <- function(a, i) { s <- d[d$inst == i & d$arm == a, ]; s$bestcmax[which.max(s$t)] }
final/ttt_paired.R:95:  ctl <- sapply(insts, function(i) fin("A0", i)); names(ctl) <- insts
final/ttt_paired.R:96:
final/ttt_paired.R:97:  # T por (brazo, instancia), restringido en 1.0
final/ttt_paired.R:98:  Tm <- matrix(NA_real_, nrow = length(insts), ncol = length(arms),
final/ttt_paired.R:99:               dimnames = list(insts, arms))
final/ttt_paired.R:100:  Rm <- Tm                                            # 1 si alcanza, 0 si no
final/ttt_paired.R:101:  for (a in arms) for (i in insts) {
final/ttt_paired.R:102:    s <- d[d$inst == i & d$arm == a, ]; s <- s[order(s$t), ]
final/ttt_paired.R:103:    if (nrow(s) < 3) next
final/ttt_paired.R:104:    Tmax <- max(s$t); j <- which(s$bestcmax <= ctl[[i]] * 1.005)
final/ttt_paired.R:105:    if (length(j)) { Tm[i, a] <- s$t[j[1]] / Tmax; Rm[i, a] <- 1 }
final/ttt_paired.R:106:    else           { Tm[i, a] <- 1.0;              Rm[i, a] <- 0 }
final/ttt_paired.R:107:  }
final/ttt_paired.R:108:  ok <- stats::complete.cases(Tm)
final/ttt_paired.R:109:  Tm <- Tm[ok, , drop = FALSE]; Rm <- Rm[ok, , drop = FALSE]
final/ttt_paired.R:110:  n <- nrow(Tm)
final/ttt_paired.R:111:
final/ttt_paired.R:112:  cat(sprintf("%s  (n = %d instancias emparejadas)\n", algos[[al]], n))
final/ttt_paired.R:113:  cat(sprintf("  A0: alcanza %.0f%% (por construccion), RMTT = %.3f\n",
final/ttt_paired.R:114:              100 * mean(Rm[, "A0"]), mean(Tm[, "A0"])))
final/ttt_paired.R:115:  cat(sprintf("  %-5s %7s %9s %10s %8s %17s %9s\n",
final/ttt_paired.R:116:              "brazo", "alcanza", "antes/desp", "p signos", "RMTT", "dif RMTT IC95%", "p perm"))
final/ttt_paired.R:117:
final/ttt_paired.R:118:  psig <- numeric(0); pperm <- numeric(0); filas <- list()
final/ttt_paired.R:119:  for (a in seeded) {
final/ttt_paired.R:120:    dif <- Tm[, a] - Tm[, "A0"]
final/ttt_paired.R:121:    antes <- sum(dif < 0); desp <- sum(dif > 0); emp <- sum(dif == 0)
final/ttt_paired.R:122:    # Test de signos CALIBRADO: la hipotesis nula no es 0.5 sino la proporcion
final/ttt_paired.R:123:    # que produce el propio diseno bajo H0 cierta, medida en ttt_null.R.
final/ttt_paired.R:124:    psig[a] <- if (antes + desp > 0) binom.test(antes, antes + desp, p = p0)$p.value else 1
final/ttt_paired.R:125:    pperm[a] <- perm_p(dif); ci <- boot_ci(dif)
final/ttt_paired.R:126:    filas[[a]] <- data.frame(algo = al, arm = a, n = n,
final/ttt_paired.R:127:                             reach = mean(Rm[, a]), antes = antes, desp = desp, emp = emp,
final/ttt_paired.R:128:                             med_dif = median(dif), rmtt = mean(Tm[, a]),
final/ttt_paired.R:129:                             rmtt_a0 = mean(Tm[, "A0"]), dif = mean(dif),
final/ttt_paired.R:130:                             lo = ci[1], hi = ci[2],
final/ttt_paired.R:131:                             p_signos = psig[a], p_perm = pperm[a])
final/ttt_paired.R:132:  }
final/ttt_paired.R:133:  hsig <- p.adjust(psig, method = "holm"); hperm <- p.adjust(pperm, method = "holm")
final/ttt_paired.R:134:  for (a in seeded) {
final/ttt_paired.R:135:    f <- filas[[a]]; f$p_signos_holm <- hsig[a]; f$p_perm_holm <- hperm[a]
final/ttt_paired.R:136:    st <- function(p) if (p < 0.001) "***" else if (p < 0.01) "**" else if (p < 0.05) "*" else ""
final/ttt_paired.R:137:    cat(sprintf("  %-5s %6.0f%% %5d/%-4d %7.4f%-3s %8.3f  [%+6.3f,%+6.3f] %7.4f%-3s\n",
final/ttt_paired.R:138:                a, 100 * f$reach, f$antes, f$desp, hsig[a], st(hsig[a]),
final/ttt_paired.R:139:                f$rmtt, f$lo, f$hi, hperm[a], st(hperm[a])))
final/ttt_paired.R:140:    todo <- rbind(todo, f)
final/ttt_paired.R:141:  }
final/ttt_paired.R:142:
final/ttt_paired.R:143:  # Kaplan-Meier, SOLO descriptivo (sin contraste)
final/ttt_paired.R:144:  ev <- do.call(rbind, lapply(arms, function(a)
final/ttt_paired.R:145:    data.frame(arm = a, t = Tm[, a], ok = Rm[, a])))
final/ttt_paired.R:146:  ev$arm <- factor(ev$arm, levels = arms)
final/ttt_paired.R:147:  km <- summary(survfit(Surv(t, ok) ~ arm, data = ev))$table
final/ttt_paired.R:148:  cat("  mediana KM (descriptiva):")
final/ttt_paired.R:149:  for (a in arms) {
final/ttt_paired.R:150:    m <- km[paste0("arm=", a), "median"]
final/ttt_paired.R:151:    cat(sprintf("  %s=%s", a, ifelse(is.na(m), "n.a.", sprintf("%.2f", m))))
final/ttt_paired.R:152:  }
final/ttt_paired.R:153:  cat("\n\n")
final/ttt_paired.R:154:}
final/ttt_paired.R:155:write.csv(todo, "final/ttt_paired.csv", row.names = FALSE)
final/ttt_paired.R:156:
final/ttt_paired.R:157:cat("=== Principal (signos) frente a secundario (RMTT): donde discrepan ===\n")
final/ttt_paired.R:158:cat("    discrepancia = la media dice aceleracion y el signo no la respalda:\n")
final/ttt_paired.R:159:cat("    la mejora esta concentrada en un subconjunto, no es un desplazamiento general\n\n")
final/ttt_paired.R:160:for (al in names(algos)) {
final/ttt_paired.R:161:  s <- todo[todo$algo == al, ]
final/ttt_paired.R:162:  a <- s$p_signos_holm < 0.05; b <- s$p_perm_holm < 0.05
final/ttt_paired.R:163:  disc <- s$arm[b & !a]
final/ttt_paired.R:164:  cat(sprintf("  %-8s signos %d/6 | RMTT %d/6   %s\n", algos[[al]], sum(a), sum(b),
final/ttt_paired.R:165:              ifelse(length(disc), paste("concentrado en:", paste(disc, collapse=" ")),
final/ttt_paired.R:166:                     "(coinciden)")))
final/ttt_paired.R:167:}
final/ttt_paired.R:168:cat("\nescrito: final/ttt_paired.csv\n")
final/fig_anytime_all.R:1:# FIGURA ANYTIME GENERAL: las 61 instancias y los 7 BRAZOS, un panel por algoritmo.
final/fig_anytime_all.R:2:#
final/fig_anytime_all.R:3:# El presupuesto va de 60 s a 900 s segun clase y algoritmo, asi que el tiempo
final/fig_anytime_all.R:4:# absoluto no es comparable entre instancias. Se normaliza cada traza a FRACCION
final/fig_anytime_all.R:5:# DE PRESUPUESTO CONSUMIDO (t / t_max de esa instancia) y se promedia sobre las 61
final/fig_anytime_all.R:6:# instancias en una rejilla comun, de modo que ninguna instancia entra o sale a
final/fig_anytime_all.R:7:# mitad de curva (el sesgo de supervivencia que ya nos mordio antes).
final/fig_anytime_all.R:8:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/fig_anytime_all.R:9:algos <- c(ga = "GA", abce3 = "ABCE3", feabcls = "fEABCLS", tsn2 = "TSN2")
final/fig_anytime_all.R:10:arms <- c(A0 = "Unseeded (A0)", V2H = "Learned, half (V2H)", V2 = "Learned (V2)",
final/fig_anytime_all.R:11:          MOR = "MOR-eps", GT = "GT-eps", GP = "GP-eps", MIX = "Mixed pool (MIX)")
final/fig_anytime_all.R:12:cols <- c(A0 = "#000000", V2H = "#0072B2", V2 = "#56B4E9", MOR = "#E69F00",
final/fig_anytime_all.R:13:          GT = "#D55E00", GP = "#009E73", MIX = "#CC0000")
final/fig_anytime_all.R:14:lwds <- c(A0 = 3.2, V2H = 1.8, V2 = 1.8, MOR = 1.8, GT = 1.8, GP = 1.8, MIX = 3.2)
final/fig_anytime_all.R:15:ltys <- c(A0 = 1, V2H = 2, V2 = 1, MOR = 4, GT = 5, GP = 3, MIX = 1)
final/fig_anytime_all.R:16:fr <- seq(0.02, 1, by = 0.02)
final/fig_anytime_all.R:17:
final/fig_anytime_all.R:18:png("final/figs/anytime_all.png", width = 1800, height = 1350, res = 145)
final/fig_anytime_all.R:19:par(mfrow = c(2, 2), mar = c(4.0, 4.3, 2.6, 1.0))
final/fig_anytime_all.R:20:resumen <- list()
final/fig_anytime_all.R:21:for (al in names(algos)) {
final/fig_anytime_all.R:22:  d <- read.csv(sprintf("final/phase2/anytime_%s.csv", al), stringsAsFactors = FALSE)
final/fig_anytime_all.R:23:  d <- d[d$arm %in% names(arms), ]
final/fig_anytime_all.R:24:  d <- merge(d, lb, by = "inst")
final/fig_anytime_all.R:25:  d$rpd <- 100 * (d$bestcmax - d$lb) / d$lb
final/fig_anytime_all.R:26:  ok <- Reduce(intersect, lapply(names(arms), function(a) unique(d$inst[d$arm == a])))
final/fig_anytime_all.R:27:  M <- sapply(names(arms), function(a) {
final/fig_anytime_all.R:28:    curvas <- sapply(ok, function(i) {
final/fig_anytime_all.R:29:      s <- d[d$inst == i & d$arm == a, ]; s <- s[order(s$t), ]
final/fig_anytime_all.R:30:      if (nrow(s) < 2) return(rep(NA, length(fr)))
final/fig_anytime_all.R:31:      tn <- s$t / max(s$t)
final/fig_anytime_all.R:32:      sapply(fr, function(f) { j <- which(tn <= f); if (!length(j)) s$rpd[1] else s$rpd[max(j)] })
final/fig_anytime_all.R:33:    })
final/fig_anytime_all.R:34:    rowMeans(curvas, na.rm = TRUE)
final/fig_anytime_all.R:35:  })
final/fig_anytime_all.R:36:  resumen[[al]] <- M
final/fig_anytime_all.R:37:  plot(NA, xlim = c(0, 1), ylim = range(M), xlab = "Fraction of budget consumed",
final/fig_anytime_all.R:38:       ylab = "Mean RPD vs. lower bound (%)",
final/fig_anytime_all.R:39:       main = sprintf("%s  (all 61 instances)", algos[[al]]))
final/fig_anytime_all.R:40:  grid(col = "grey90")
final/fig_anytime_all.R:41:  for (a in names(arms)) lines(fr, M[, a], col = cols[[a]], lwd = lwds[[a]], lty = ltys[[a]])
final/fig_anytime_all.R:42:  legend("topright", legend = unname(arms), col = cols[names(arms)],
final/fig_anytime_all.R:43:         lwd = lwds[names(arms)], lty = ltys[names(arms)], bty = "n", cex = 0.72)
final/fig_anytime_all.R:44:}
final/fig_anytime_all.R:45:dev.off()
final/fig_anytime_all.R:46:
final/fig_anytime_all.R:47:cat("=== RPD medio (%) sobre las 61 instancias, por fraccion de presupuesto ===\n")
final/fig_anytime_all.R:48:cat(sprintf("%-8s %-4s %7s %7s %7s %7s %7s\n", "algo","arm","10%","25%","50%","75%","100%"))
final/fig_anytime_all.R:49:idx <- sapply(c(.10,.25,.50,.75,1.0), function(f) which.min(abs(fr - f)))
final/fig_anytime_all.R:50:for (al in names(algos)) { for (a in names(arms)) {
final/fig_anytime_all.R:51:  v <- resumen[[al]][idx, a]
final/fig_anytime_all.R:52:  cat(sprintf("%-8s %-4s %7.2f %7.2f %7.2f %7.2f %7.2f\n", algos[[al]], a, v[1],v[2],v[3],v[4],v[5]))
final/fig_anytime_all.R:53:} ; cat("\n") }
final/fig_anytime_all.R:54:cat("figura: final/figs/anytime_all.png\n")
final/run_phase2c.sh:1:#!/usr/bin/env bash
final/run_phase2c.sh:2:# FASE 2 (version CHUNKED) — igual que run_phase2.sh pero partiendo los 30 runs de
final/run_phase2c.sh:3:# cada configuracion en trozos independientes, para acotar la FUGA DE MEMORIA del
final/run_phase2c.sh:4:# solver (medida 2026-07-26: ~400MB -> ~1GB por proceso a lo largo de 30 runs).
final/run_phase2c.sh:5:#
final/run_phase2c.sh:6:# Cada trozo es un proceso nuevo (muere y libera). Semillas: el framework usa
final/run_phase2c.sh:7:# seed+run, asi que trozo j con seed=1+j*CH y runs=CH reproduce EXACTAMENTE las
final/run_phase2c.sh:8:# mismas 30 semillas (1..30) que un unico runs=30 -> identico estadisticamente.
final/run_phase2c.sh:9:#
final/run_phase2c.sh:10:# Salida: final/phase2/<algo>/<inst>/<arm>/c<j>/   (un subdir por trozo)
final/run_phase2c.sh:11:# Una configuracion se considera terminada cuando TODOS sus trozos tienen stats CSV.
final/run_phase2c.sh:12:# Idempotente a nivel de trozo (se puede cortar y reanudar sin perder nada).
final/run_phase2c.sh:13:#
final/run_phase2c.sh:14:# Variables: PAR (default 10), CH (runs por trozo; default 5 para ga/abce3,
final/run_phase2c.sh:15:#            3 para feabcls/tsn2 que consumen mas por run).
final/run_phase2c.sh:16:cd "$(dirname "$0")/.."
final/run_phase2c.sh:17:RUNS=30
final/run_phase2c.sh:18:PAR=${PAR:-10}
final/run_phase2c.sh:19:CAP=900
final/run_phase2c.sh:20:OUT=${OUT_OVERRIDE:-final/phase2}
final/run_phase2c.sh:21:mkdir -p "$OUT"
final/run_phase2c.sh:22:
final/run_phase2c.sh:23:declare -A BGA=(  [15x15]=60  [20x20]=60  [30x15]=109 [30x20]=154 [50x15]=233 [50x20]=321 )
final/run_phase2c.sh:24:declare -A BAB=(  [15x15]=60  [20x20]=60  [30x15]=60  [30x20]=60  [50x15]=60  [50x20]=60 )
final/run_phase2c.sh:25:declare -A BFL=(  [15x15]=60  [20x20]=67  [30x15]=371 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:26:declare -A BTS=(  [15x15]=60  [20x20]=486 [30x15]=630 [30x20]=$CAP [50x15]=$CAP [50x20]=$CAP )
final/run_phase2c.sh:27:# FORCEBUD: presupuesto forzado, SOLO para el smoke test. Permite recorrer el
final/run_phase2c.sh:28:# pipeline completo en minutos por el MISMO camino de codigo que la corrida real.
final/run_phase2c.sh:29:budget() { if [ -n "$FORCEBUD" ]; then echo "$FORCEBUD"; return; fi
final/run_phase2c.sh:30:  case "$1" in ga) echo "${BGA[$2]}";; abce3) echo "${BAB[$2]}";; feabcls) echo "${BFL[$2]}";; tsn2) echo "${BTS[$2]}";; esac; }
final/run_phase2c.sh:31:chunk_size() { echo "${CH:-5}"; }   # 5 runs por trozo -> pico ~325 MB/worker (medido)
final/run_phase2c.sh:32:clase() { case "$1" in
final/run_phase2c.sh:33:  ft10|tai15_15_*) echo 15x15 ;; tai20_20_*) echo 20x20 ;; tai30_15_*) echo 30x15 ;;
final/run_phase2c.sh:34:  tai30_20_*) echo 30x20 ;; tai50_15_*) echo 50x15 ;; tai50_20_*) echo 50x20 ;;
final/run_phase2c.sh:35:esac; }
final/run_phase2c.sh:36:instfile() { if [ "$1" = "ft10" ]; then echo "SelectosYTaillardIntervalos/F0.15.0.ft10_10.txt";
final/run_phase2c.sh:37:  else echo "SelectosYTaillardIntervalos/$1.F.15_01.txt"; fi }
final/run_phase2c.sh:38:armspec() { case "$1" in
final/run_phase2c.sh:39:  A0) echo ", 0";; V2H) echo "v2, 125";; V2) echo "v2, 250";; MOR) echo "graspmor, 250";;
final/run_phase2c.sh:40:  GT) echo "gtmwkr, 250";; GP) echo "gp, 250";; MIX) echo "mix, 250";;
final/run_phase2c.sh:41:  MIXH) echo "mix, 125";;
final/run_phase2c.sh:42:esac; }
final/run_phase2c.sh:43:
final/run_phase2c.sh:44:# INSTS_OVERRIDE y OUT_OVERRIDE: para el smoke test, mismo codigo pero
final/run_phase2c.sh:45:# pocas instancias y directorio aparte, sin tocar los datos reales.
final/run_phase2c.sh:46:if [ -n "$INSTS_OVERRIDE" ]; then
final/run_phase2c.sh:47:  INSTS="$INSTS_OVERRIDE"
final/run_phase2c.sh:48:else
final/run_phase2c.sh:49:INSTS="ft10"
final/run_phase2c.sh:50:for cls in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/run_phase2c.sh:51:  for i in $(seq -w 1 10); do INSTS="$INSTS ${cls}_${i}"; done
final/run_phase2c.sh:52:done
final/run_phase2c.sh:53:fi
final/run_phase2c.sh:54:# ARMS_OVERRIDE permite anadir un brazo sin retocar el resto: los trozos ya
final/run_phase2c.sh:55:# completos se saltan de todos modos, pero limitar la lista hace explicito que
final/run_phase2c.sh:56:# la corrida no puede tocar celdas existentes.
final/run_phase2c.sh:57:ARMS=${ARMS_OVERRIDE:-"A0 V2H V2 MOR GT GP MIX"}
final/run_phase2c.sh:58:ALGOS=${ALGOS:-"ga feabcls tsn2"}   # abce3 ya completo; ga parcialmente
final/run_phase2c.sh:59:
final/run_phase2c.sh:60:# En DRYRUN la lista va a un temporal: un ensayo no debe tocar ni siquiera el
final/run_phase2c.sh:61:# fichero de trabajos del experimento.
final/run_phase2c.sh:62:JOB="$OUT/joblist_chunk.txt"
final/run_phase2c.sh:63:[ "${DRYRUN:-0}" = "1" ] && JOB="${DRYJOB:-$(mktemp)}"
final/run_phase2c.sh:64:: > "$JOB"; skipc=0; skipm=0; todo=0
final/run_phase2c.sh:65:for algo in $ALGOS; do
final/run_phase2c.sh:66:  ch=$(chunk_size "$algo")
final/run_phase2c.sh:67:  nch=$(( (RUNS + ch - 1) / ch ))
final/run_phase2c.sh:68:  for inst in $INSTS; do
final/run_phase2c.sh:69:    cls=$(clase "$inst"); bud=$(budget "$algo" "$cls"); f=$(instfile "$inst")
final/run_phase2c.sh:70:    for arm in $ARMS; do
final/run_phase2c.sh:71:      base="$OUT/$algo/$inst/$arm"
final/run_phase2c.sh:72:      # si la config ya se completo en el formato antiguo (runs=30 monolitico), saltar
final/run_phase2c.sh:73:      mono=$(ls "$base"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:74:      [ -n "$mono" ] && { skipm=$((skipm+1)); continue; }
final/run_phase2c.sh:75:      spec=$(armspec "$arm"); g=${spec%%,*}; k=$(echo "${spec##*,}" | tr -d ' ')
final/run_phase2c.sh:76:      for j in $(seq 1 $nch); do
final/run_phase2c.sh:77:        d="$base/c$j"
final/run_phase2c.sh:78:        csv=$(ls "$d"/*.csv 2>/dev/null | grep -v -E 'Sols|Robust|Scenar' | head -1)
final/run_phase2c.sh:79:        [ -n "$csv" ] && { skipc=$((skipc+1)); continue; }
final/run_phase2c.sh:80:        todo=$((todo+1))
final/run_phase2c.sh:81:        seed=$(( 1 + (j-1)*ch ))
final/run_phase2c.sh:82:        pool=""
final/run_phase2c.sh:83:        if [ "$k" -gt 0 ]; then
final/run_phase2c.sh:84:          pool="pools_test/corrected/int__${inst}_${g}_repo_pool.csv"
final/run_phase2c.sh:85:          [ -f "$pool" ] || { echo "FALTA pool: $pool"; exit 1; }
final/run_phase2c.sh:86:        fi
final/run_phase2c.sh:87:        # DRYRUN no debe TOCAR EL DISCO. Antes creaba el directorio y escribia
final/run_phase2c.sh:88:        # setup.txt antes de comprobar la variable, de modo que un "ensayo"
final/run_phase2c.sh:89:        # dejaba miles de ficheros y ensuciaba el arbol del experimento.
final/run_phase2c.sh:90:        if [ "${DRYRUN:-0}" != "1" ]; then
final/run_phase2c.sh:91:        rm -rf "$d"; mkdir -p "$d"
final/run_phase2c.sh:92:        sed -e "s/^runs = .*/runs = $ch/" -e "s/^seed = .*/seed = $seed/" "repro/setup_${algo}.txt" > "$d/setup.txt"
final/run_phase2c.sh:93:        sed -i "s/^noimprovement = .*/generations = 100000/" "$d/setup.txt"
final/run_phase2c.sh:94:        if grep -q '^timelimit' "$d/setup.txt"; then sed -i "s/^timelimit = .*/timelimit = $bud/" "$d/setup.txt"
final/run_phase2c.sh:95:        else echo "timelimit = $bud" >> "$d/setup.txt"; fi
final/run_phase2c.sh:96:        if [ -n "$pool" ]; then
final/run_phase2c.sh:97:          sed -i "s/^creation = ijsp.random/creation = ijsp.seeded/" "$d/setup.txt"
final/run_phase2c.sh:98:          # INDICE GLOBAL de la primera ejecucion de este trozo. Sin el, cada
final/run_phase2c.sh:99:          # proceso reinicia su contador y los 6 trozos repiten los mismos
final/run_phase2c.sh:100:          # bloques del pool: 5 poblaciones iniciales en vez de 30.
final/run_phase2c.sh:101:          { echo ""; echo "creation.seed.pool = $pool"; echo "creation.seed.count = $k";
final/run_phase2c.sh:102:            echo "creation.seed.offset = $(( (j-1)*ch ))"; } >> "$d/setup.txt"
final/run_phase2c.sh:103:        fi
final/run_phase2c.sh:104:        fi
final/run_phase2c.sh:105:        echo "./FuzzyFW '$d/setup.txt' '$f' '$d' > '$d/log.txt' 2>&1" >> "$JOB"
final/run_phase2c.sh:106:      done
final/run_phase2c.sh:107:    done
final/run_phase2c.sh:108:  done
final/run_phase2c.sh:109:done
final/run_phase2c.sh:110:echo "configs ya completas (monoliticas): $skipm | trozos ya hechos: $skipc | trozos pendientes: $todo"
final/run_phase2c.sh:111:if [ "${DRYRUN:-0}" = "1" ]; then echo "DRYRUN: nada lanzado."; exit 0; fi
final/run_phase2c.sh:112:echo "Inicio PHASE2C: $(date) | $todo trozos, <=$PAR, chunk ga/abce3=${CH:-5} feabcls/tsn2=${CH:-3}" | tee -a "$OUT/run.log"
final/run_phase2c.sh:113:cat "$JOB" | xargs -I CMD -P "$PAR" bash -c CMD
final/run_phase2c.sh:114:echo "PHASE2C DONE: $(date)" | tee -a "$OUT/run.log"
final/ttt_null.R:1:# ¿CONTROLA EL TEST DE SIGNOS EL ERROR DE TIPO I CON UN OBJETIVO ENDOGENO?
final/ttt_null.R:2:#
final/ttt_null.R:3:# Objecion (valida) a ttt_paired.R: el objetivo de cada instancia se construye a
final/ttt_null.R:4:# partir del endpoint del PROPIO control, de modo que A0 se evalua contra una
final/ttt_null.R:5:# diana extraida de su propia realizacion y el brazo sembrado no. Que la
final/ttt_null.R:6:# truncatura no invierta signos no basta para justificar el nulo binomial
final/ttt_null.R:7:# P(antes) = P(despues) = 0.5: hay que demostrar la intercambiabilidad, o
final/ttt_null.R:8:# medirla.
final/ttt_null.R:9:#
final/ttt_null.R:10:# Aqui se mide, sin suponer nada, y REPRODUCIENDO LA ESTRUCTURA DEL ANALISIS
final/ttt_null.R:11:# REAL: alli se comparan dos curvas promediadas sobre ejecuciones, no dos
final/ttt_null.R:12:# ejecuciones sueltas, y el promediado cambia el ruido.
final/ttt_null.R:13:#
final/ttt_null.R:14:#   por instancia: las 30 ejecuciones de A0 se parten al azar en dos mitades de
final/ttt_null.R:15:#   15; cada mitad se promedia sobre la misma rejilla; una hace de "control" y
final/ttt_null.R:16:#   fija el objetivo endpoint*1.005 en makespan, la otra de "brazo". Se forma la
final/ttt_null.R:17:#   diferencia emparejada y se aplica el test de signos sobre las 61 instancias.
final/ttt_null.R:18:#
final/ttt_null.R:19:# Ambas mitades proceden del MISMO proceso, luego H0 es cierta por construccion.
final/ttt_null.R:20:# Si el procedimiento es valido, la proporcion de "antes" debe rondar 0.5 y el
final/ttt_null.R:21:# test debe rechazar el 5% de las veces a alfa = 0.05. Toda desviacion es sesgo
final/ttt_null.R:22:# del objetivo endogeno, no efecto de la siembra.
final/ttt_null.R:23:set.seed(20260826)
final/ttt_null.R:24:B <- 400            # replicas
final/ttt_null.R:25:NG <- 200           # puntos de rejilla por instancia
final/ttt_null.R:26:ALPHA <- 0.05
final/ttt_null.R:27:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/ttt_null.R:28:
final/ttt_null.R:29:cat("=== Error de tipo I del test de signos bajo objetivo endogeno ===\n")
final/ttt_null.R:30:cat(sprintf("    %d replicas; cada una parte las 30 ejecuciones de A0 en 15+15 y promedia\n", B))
final/ttt_null.R:31:cat("    H0 cierta por construccion: ambas mitades salen del mismo proceso\n")
final/ttt_null.R:32:cat("    esperado si el procedimiento es valido: antes = 50%, rechazo = 5%\n\n")
final/ttt_null.R:33:cat(sprintf("  %-8s %7s %15s %14s %11s\n",
final/ttt_null.R:34:            "solver", "n inst", "P(antes) media", "rechazo a 5%", "veredicto"))
final/ttt_null.R:35:
final/ttt_null.R:36:res <- data.frame()
final/ttt_null.R:37:for (al in names(algos)) {
final/ttt_null.R:38:  d <- read.csv(sprintf("final/phase2/a0_traces_%s.csv", al), stringsAsFactors = FALSE)
final/ttt_null.R:39:  insts <- unique(d$inst)
final/ttt_null.R:40:
final/ttt_null.R:41:  # Por instancia: matriz V de 30 ejecuciones x NG puntos de rejilla, con el
final/ttt_null.R:42:  # mejor-hasta-ahora de cada ejecucion evaluado en la rejilla. La rejilla
final/ttt_null.R:43:  # empieza cuando TODAS las ejecuciones han reportado, para que la media no
final/ttt_null.R:44:  # cambie de composicion (mismo criterio que resample_anytime.sh).
final/ttt_null.R:45:  mats <- list()
final/ttt_null.R:46:  for (i in insts) {
final/ttt_null.R:47:    x <- d[d$inst == i, ]
final/ttt_null.R:48:    rs <- split(x[, c("t","v")], x$run)
final/ttt_null.R:49:    if (length(rs) < 4) next
final/ttt_null.R:50:    t0 <- max(sapply(rs, function(z) min(z$t)))
final/ttt_null.R:51:    t1 <- max(sapply(rs, function(z) max(z$t)))
final/ttt_null.R:52:    if (!(t1 > t0)) next
final/ttt_null.R:53:    G <- seq(t0, t1, length.out = NG)
final/ttt_null.R:54:    V <- t(sapply(rs, function(z) {
final/ttt_null.R:55:      z <- z[order(z$t), ]
final/ttt_null.R:56:      z$v[pmax(1, findInterval(G, z$t))]
final/ttt_null.R:57:    }))
final/ttt_null.R:58:    mats[[i]] <- V
final/ttt_null.R:59:  }
final/ttt_null.R:60:  ok_inst <- names(mats)
final/ttt_null.R:61:
final/ttt_null.R:62:  antes_tot <- 0; desp_tot <- 0; rech <- 0; usadas <- 0
final/ttt_null.R:63:  for (b in 1:B) {
final/ttt_null.R:64:    dif <- numeric(0)
final/ttt_null.R:65:    for (i in ok_inst) {
final/ttt_null.R:66:      V <- mats[[i]]; n <- nrow(V)
final/ttt_null.R:67:      idx <- sample(n); h1 <- idx[1:floor(n/2)]; h2 <- idx[(floor(n/2)+1):n]
final/ttt_null.R:68:      c1 <- colMeans(V[h1, , drop = FALSE])       # "control"
final/ttt_null.R:69:      c2 <- colMeans(V[h2, , drop = FALSE])       # "brazo"
final/ttt_null.R:70:      obj <- c1[NG] * 1.005
final/ttt_null.R:71:      j1 <- which(c1 <= obj); j2 <- which(c2 <= obj)
final/ttt_null.R:72:      T1 <- if (length(j1)) j1[1]/NG else 1.0
final/ttt_null.R:73:      T2 <- if (length(j2)) j2[1]/NG else 1.0
final/ttt_null.R:74:      dif <- c(dif, T2 - T1)
final/ttt_null.R:75:    }
final/ttt_null.R:76:    a <- sum(dif < 0); p <- sum(dif > 0)
final/ttt_null.R:77:    antes_tot <- antes_tot + a; desp_tot <- desp_tot + p
final/ttt_null.R:78:    if (a + p > 0) {
final/ttt_null.R:79:      usadas <- usadas + 1
final/ttt_null.R:80:      if (binom.test(a, a + p)$p.value < ALPHA) rech <- rech + 1
final/ttt_null.R:81:    }
final/ttt_null.R:82:  }
final/ttt_null.R:83:  pa <- antes_tot / (antes_tot + desp_tot)
final/ttt_null.R:84:  tr <- rech / usadas
final/ttt_null.R:85:  ver <- if (abs(pa - 0.5) < 0.03 && tr < 0.10) "calibrado" else "SESGADO"
final/ttt_null.R:86:  cat(sprintf("  %-8s %7d %14.1f%% %13.1f%% %11s\n",
final/ttt_null.R:87:              algos[[al]], length(ok_inst), 100*pa, 100*tr, ver))
final/ttt_null.R:88:  res <- rbind(res, data.frame(algo = al, n_inst = length(ok_inst),
final/ttt_null.R:89:                               p_antes_nulo = pa, tipo_I = tr))
final/ttt_null.R:90:}
final/ttt_null.R:91:write.csv(res, "final/ttt_null.csv", row.names = FALSE)
final/ttt_null.R:92:cat("\nescrito: final/ttt_null.csv\n")
final/mixh_vs_mix.R:1:# ¿SON DOS EFECTOS O UNO?
final/mixh_vs_mix.R:2:#
final/mixh_vs_mix.R:3:# El articulo tiene dos afirmaciones de mecanismo medidas sobre pools distintos:
final/mixh_vs_mix.R:4:#   - composicion: MIX (mezcla) frente a los generadores unicos, a fraccion 100%
final/mixh_vs_mix.R:5:#   - fraccion:    V2H (media poblacion) frente a V2, sobre el pool v2
final/mixh_vs_mix.R:6:# MIXH combina ambas. Si mejora sobre MIX, los efectos se suman; si no, la
final/mixh_vs_mix.R:7:# composicion ya estaba haciendo el trabajo de la aleatoriedad retenida.
final/mixh_vs_mix.R:8:#
final/mixh_vs_mix.R:9:# Contrastes emparejados por instancia (n=61), negativo = el primero es mejor.
final/mixh_vs_mix.R:10:lb <- read.csv("final/ta_lb.csv", stringsAsFactors = FALSE)[, c("inst","lb")]
final/mixh_vs_mix.R:11:algos <- c(ga="GA", abce3="ABCE3", feabcls="fEABCLS", tsn2="TSN2")
final/mixh_vs_mix.R:12:set.seed(20260828)
final/mixh_vs_mix.R:13:B <- 10000
final/mixh_vs_mix.R:14:
final/mixh_vs_mix.R:15:par <- list(c("MIXH","MIX"),    # ¿anade algo retener aleatorio sobre el mixto?
final/mixh_vs_mix.R:16:            c("MIXH","V2H"),    # ¿anade algo componer sobre media poblacion?
final/mixh_vs_mix.R:17:            c("MIXH","A0"))     # ¿mejora al control?
final/mixh_vs_mix.R:18:
final/mixh_vs_mix.R:19:cat("=== MIXH frente a los brazos que combina ===\n")
final/mixh_vs_mix.R:20:cat("    diferencia media por instancia, IC bootstrap sobre instancias,\n")
final/mixh_vs_mix.R:21:cat("    p de Wilcoxon emparejado. Negativo = MIXH mejor.\n\n")
final/mixh_vs_mix.R:22:res <- data.frame()
final/mixh_vs_mix.R:23:for (al in names(algos)) {
final/mixh_vs_mix.R:24:  d <- merge(read.csv(sprintf("final/phase2/results_%s.csv", al), stringsAsFactors = FALSE),
final/mixh_vs_mix.R:25:             lb, by = "inst")
final/mixh_vs_mix.R:26:  d$rpd <- 100 * (d$ecmax - d$lb) / d$lb
final/mixh_vs_mix.R:27:  m <- aggregate(rpd ~ inst + arm, d, mean)
final/mixh_vs_mix.R:28:  w <- reshape(m, idvar = "inst", timevar = "arm", direction = "wide")
final/mixh_vs_mix.R:29:  cat(sprintf("%s\n", algos[[al]]))
final/mixh_vs_mix.R:30:  cat(sprintf("  %-12s %9s %20s %9s\n", "contraste", "dif", "IC 95%", "p"))
final/mixh_vs_mix.R:31:  for (p in par) {
final/mixh_vs_mix.R:32:    a <- w[[paste0("rpd.", p[1])]]; b <- w[[paste0("rpd.", p[2])]]
final/mixh_vs_mix.R:33:    if (is.null(a) || is.null(b)) next
final/mixh_vs_mix.R:34:    x <- a - b
final/mixh_vs_mix.R:35:    M <- matrix(sample(x, length(x)*B, TRUE), nrow = length(x))
final/mixh_vs_mix.R:36:    ci <- quantile(colMeans(M), c(.025, .975))
final/mixh_vs_mix.R:37:    pv <- suppressWarnings(wilcox.test(x)$p.value)
final/mixh_vs_mix.R:38:    cat(sprintf("  %-12s %+9.3f   [%+7.3f, %+7.3f] %9.4f%s\n",
final/mixh_vs_mix.R:39:                paste(p, collapse = " vs "), mean(x), ci[1], ci[2], pv,
final/mixh_vs_mix.R:40:                ifelse(pv < 0.05, " *", "")))
final/mixh_vs_mix.R:41:    res <- rbind(res, data.frame(algo = al, a = p[1], b = p[2],
final/mixh_vs_mix.R:42:                                 dif = mean(x), lo = ci[1], hi = ci[2], p = pv))
final/mixh_vs_mix.R:43:  }
final/mixh_vs_mix.R:44:  cat("\n")
final/mixh_vs_mix.R:45:}
final/mixh_vs_mix.R:46:write.csv(res, "final/mixh_contrastes.csv", row.names = FALSE)
final/mixh_vs_mix.R:47:cat("escrito: final/mixh_contrastes.csv\n")
final/run_mixh.sh:1:#!/usr/bin/env bash
final/run_mixh.sh:2:# BRAZO MIXH: pool mixto sembrando SOLO LA MITAD de la poblacion (125 de 250).
final/run_mixh.sh:3:#
final/run_mixh.sh:4:# Por que este brazo. El diseno tiene el pool v2 a dos fracciones (V2 al 100%,
final/run_mixh.sh:5:# V2H al 50%) pero el pool mixto solo al 100%. Las dos afirmaciones de
final/run_mixh.sh:6:# mecanismo del articulo se miden por tanto sobre pools distintos:
final/run_mixh.sh:7:#   - la composicion manda sobre la calidad  -> medido a fraccion 100%
final/run_mixh.sh:8:#   - la fraccion interactua con el solver   -> medido sobre v2 puro
final/run_mixh.sh:9:# Falta saber si son EL MISMO mecanismo o dos. En el GA retener material
final/run_mixh.sh:10:# aleatorio ayuda (V2H mejor que V2, -0.39 pp) y componer tambien (MIX no dana,
final/run_mixh.sh:11:# los generadores unicos si). Si MIXH mejora sobre MIX, son dos efectos que se
final/run_mixh.sh:12:# suman; si no, la composicion ya estaba haciendo el trabajo de la aleatoriedad.
final/run_mixh.sh:13:#
final/run_mixh.sh:14:# NO HACEN FALTA POOLS NUEVOS: MIXH usa el mismo pool mixto que MIX, igual que
final/run_mixh.sh:15:# V2H usa el mismo pool que V2. Solo cambia creation.seed.count.
final/run_mixh.sh:16:#
final/run_mixh.sh:17:# HOMOGENEIDAD. Este brazo debe correr en condiciones identicas a los otros
final/run_mixh.sh:18:# siete o la comparacion no vale. Se reutiliza run_phase2c.sh sin tocar su
final/run_mixh.sh:19:# logica, de modo que hereda los mismos presupuestos por (solver, clase), el
final/run_mixh.sh:20:# mismo troceado en 6 x 5 ejecuciones, el mismo offset global de semillas y los
final/run_mixh.sh:21:# mismos setups de repro/. La lista de brazos se restringe a MIXH: los trozos ya
final/run_mixh.sh:22:# hechos se saltarian igualmente, pero restringirla hace imposible tocarlos.
final/run_mixh.sh:23:#
final/run_mixh.sh:24:# CONSECUENCIA ESTADISTICA que hay que declarar en el articulo: la correccion de
final/run_mixh.sh:25:# Holm pasa de 6 a 7 contrastes por solver, asi que TODOS los p-valores se
final/run_mixh.sh:26:# mueven. Hay que recalcular las tablas afectadas, no solo anadir una fila.
final/run_mixh.sh:27:#
final/run_mixh.sh:28:# Uso:   bash final/run_mixh.sh            (lanza)
final/run_mixh.sh:29:#        DRYRUN=1 bash final/run_mixh.sh   (solo cuenta trabajos)
final/run_mixh.sh:30:cd "$(dirname "$0")/.."
final/run_mixh.sh:31:
final/run_mixh.sh:32:export ARMS_OVERRIDE="MIXH"
final/run_mixh.sh:33:export ALGOS="ga abce3 feabcls tsn2"
final/run_mixh.sh:34:export PAR=${PAR:-14}
final/run_mixh.sh:35:
final/run_mixh.sh:36:echo "=== MIXH: comprobaciones previas ==="
final/run_mixh.sh:37:
final/run_mixh.sh:38:# 1. binario presente y mas nuevo que las fuentes que le afectan.
final/run_mixh.sh:39:# El bit de ejecucion no se comprueba: sobre un montaje de Windows no aparece
final/run_mixh.sh:40:# aunque el binario corra sin problemas desde WSL.
final/run_mixh.sh:41:[ -s ./FuzzyFW ] || { echo "  FALLO: no existe ./FuzzyFW"; exit 1; }
final/run_mixh.sh:42:for src in CreationIJSP.cpp CreationIJSP.h Creation.cpp; do
final/run_mixh.sh:43:  [ -f "$src" ] || continue
final/run_mixh.sh:44:  [ "$src" -nt ./FuzzyFW ] && { echo "  FALLO: $src es mas reciente que el binario;"; \
final/run_mixh.sh:45:    echo "         recompila antes de lanzar o el brazo no sera homogeneo"; exit 1; }
final/run_mixh.sh:46:done
final/run_mixh.sh:47:echo "  binario: presente y posterior a las fuentes de siembra"
final/run_mixh.sh:48:
final/run_mixh.sh:49:# 2. los 61 pools mixtos existen y tienen 1024 lineas
final/run_mixh.sh:50:n=0; bad=0
final/run_mixh.sh:51:INSTS="ft10"
final/run_mixh.sh:52:for c in tai15_15 tai20_20 tai30_15 tai30_20 tai50_15 tai50_20; do
final/run_mixh.sh:53:  for i in $(seq -w 1 10); do INSTS="$INSTS ${c}_${i}"; done
final/run_mixh.sh:54:done
final/run_mixh.sh:55:for inst in $INSTS; do
final/run_mixh.sh:56:  p="pools_test/corrected/int__${inst}_mix_repo_pool.csv"
final/run_mixh.sh:57:  if [ ! -f "$p" ]; then echo "  FALTA $p"; bad=$((bad+1)); continue; fi
final/run_mixh.sh:58:  l=$(wc -l < "$p"); [ "$l" -eq 1024 ] || { echo "  $p tiene $l lineas"; bad=$((bad+1)); }
final/run_mixh.sh:59:  n=$((n+1))
final/run_mixh.sh:60:done
final/run_mixh.sh:61:[ "$bad" -eq 0 ] || { echo "  FALLO: $bad pools defectuosos"; exit 1; }
final/run_mixh.sh:62:echo "  pools mixtos: $n de 61, todos con 1024 entradas"
final/run_mixh.sh:63:
final/run_mixh.sh:64:# 3. ninguna celda MIXH previa: esta corrida debe crear, nunca sobrescribir
final/run_mixh.sh:65:prev=$(ls -d final/phase2/*/*/MIXH 2>/dev/null | wc -l)
final/run_mixh.sh:66:[ "$prev" -eq 0 ] || { echo "  FALLO: ya existen $prev celdas MIXH"; exit 1; }
final/run_mixh.sh:67:echo "  celdas MIXH previas: 0"
final/run_mixh.sh:68:
final/run_mixh.sh:69:# 4. los otros brazos estan completos, para que el nuevo no compita por CPU.
final/run_mixh.sh:70:# Un solo recorrido del arbol: 1708 celdas con ls una a una tarda minutos sobre
final/run_mixh.sh:71:# un montaje de Windows.
final/run_mixh.sh:72:comp=$(find final/phase2 -mindepth 3 -maxdepth 3 -type d 2>/dev/null | wc -l)
final/run_mixh.sh:73:esp=$((4*61*7))
final/run_mixh.sh:74:echo "  celdas originales con datos: $comp de $esp"
final/run_mixh.sh:75:[ "$comp" -ge "$esp" ] || echo "  AVISO: faltan $((esp-comp)); MIXH competiria por CPU con ellas"
final/run_mixh.sh:76:
final/run_mixh.sh:77:# 5. cuantos trabajos va a generar
final/run_mixh.sh:78:echo ""
final/run_mixh.sh:79:echo "=== trabajos a generar ==="
final/run_mixh.sh:80:DRYRUN=1 bash final/run_phase2c.sh 2>&1 | tail -2
final/run_mixh.sh:81:
final/run_mixh.sh:82:if [ "${DRYRUN:-0}" = "1" ]; then
final/run_mixh.sh:83:  echo ""
final/run_mixh.sh:84:  echo "DRYRUN: nada lanzado. Para ejecutar: bash final/run_mixh.sh"
final/run_mixh.sh:85:  exit 0
final/run_mixh.sh:86:fi
final/run_mixh.sh:87:
final/run_mixh.sh:88:echo ""
final/run_mixh.sh:89:echo "=== lanzando MIXH con $PAR workers ==="
final/run_mixh.sh:90:echo "  coste estimado: ~50 h de CPU / 14 workers = ~2.1 dias"
final/run_mixh.sh:91:bash final/run_phase2c.sh

