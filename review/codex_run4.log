  for (a in arms) {
    L <- if (a == "MIX") "7500 (disjunto)" else "1024 (solape 22%)"
    cat(sprintf("%-5s %8.3f %8.3f   %s\n", a, median(cv[[a]]), mean(cv[[a]]), L))
