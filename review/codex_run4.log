final/pool_quality.sh:23:      END{ if(n){ m=sum/n; sd=sqrt(sq/n - m*m); printf "%s,%s,%.2f,%.2f,%.2f\n", i, g, m, b, sd } }' >> "$out"
final/pool_quality.sh:24:  done
