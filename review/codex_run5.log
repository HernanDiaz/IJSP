CreationIJSP.cpp:128:FuzzyFW::Individual * CreationSRTIntervalMkSchedule::createIndividual(
CreationIJSP.cpp:129:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:130:	int rand;
CreationIJSP.cpp:131:	/*rand = svars->rng->getInteger(0, 100) +1;
CreationIJSP.cpp:132:	rand = svars->rng->getInteger(0, 100);
CreationIJSP.cpp:133:	if (rand < this->randomRatio * 100) {
CreationIJSP.cpp:134:		return this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:135:	}
CreationIJSP.cpp:136:	else {
CreationIJSP.cpp:137:		return this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:138:	}*/
CreationIJSP.cpp:139:	if (this->randomRatio > 0 ) {
CreationIJSP.cpp:140:		rand = svars->rng->getInteger(0, 100);
CreationIJSP.cpp:141:		if (rand < this->randomRatio * 100) {
CreationIJSP.cpp:142:			return this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:143:		}
CreationIJSP.cpp:144:	}
CreationIJSP.cpp:145:  	std::vector<int> permutation, count;
CreationIJSP.cpp:146:	
CreationIJSP.cpp:147:	FuzzyFW::Individual * indiv;
CreationIJSP.cpp:148:
CreationIJSP.cpp:149:	// Convert the problem type
CreationIJSP.cpp:150:	ProblemIJSP * fuzzyProb =
CreationIJSP.cpp:151:		dynamic_cast<ProblemIJSP *>(svars->problem);
CreationIJSP.cpp:152:	if (fuzzyProb == NULL) {
CreationIJSP.cpp:153:		std::string errorMsg = "This enconding function works only with ";
CreationIJSP.cpp:154:		errorMsg += "interval problems.";
CreationIJSP.cpp:155:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:156:	}
CreationIJSP.cpp:157:		
CreationIJSP.cpp:158:	// Find the first task of each job and count remaining time for each job
CreationIJSP.cpp:159:	std::vector<FuzzyFW::Interval> jobRemainingTime(fuzzyProb->getNumberJobs());
CreationIJSP.cpp:160:	std::vector<int> jobOrderByRemainingTime;
CreationIJSP.cpp:161:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
CreationIJSP.cpp:162:    	unsigned int numberOfTasks = fuzzyProb->getNumberTasks(i);
CreationIJSP.cpp:163:		if (numberOfTasks > 0) {
CreationIJSP.cpp:164:			count.push_back(fuzzyProb->getTaskId(i, 0));
CreationIJSP.cpp:165:			//count remaining time for each job
CreationIJSP.cpp:166:			for (unsigned int j = 0; j < numberOfTasks; j++) {
CreationIJSP.cpp:167:				jobRemainingTime[i] += fuzzyProb->getTask(fuzzyProb->getTaskId(i, j))->p;
CreationIJSP.cpp:168:			}
CreationIJSP.cpp:169:			//Order the jobs from higher to lower remaining time
CreationIJSP.cpp:170:			int k = 0;
CreationIJSP.cpp:171:		    while (k < jobOrderByRemainingTime.size() && 
CreationIJSP.cpp:172:				FuzzyFW::FitnessInterval(jobRemainingTime[i], false).isBetterThan(&(FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k]], false)))) {
CreationIJSP.cpp:173:				k++;
CreationIJSP.cpp:174:			}
CreationIJSP.cpp:175:			jobOrderByRemainingTime.insert(jobOrderByRemainingTime.begin()+k,i);
CreationIJSP.cpp:176:		}
CreationIJSP.cpp:177:	}
CreationIJSP.cpp:178:	// Build an array with repetitions
CreationIJSP.cpp:179:	while (count.size() > 0) {
CreationIJSP.cpp:180:		int max = 3 < count.size() ? 3 : count.size();
CreationIJSP.cpp:181:		rand = svars->rng->getInteger(0, max*max - 1);
CreationIJSP.cpp:182:		int k = int(sqrt(rand));
CreationIJSP.cpp:183:
CreationIJSP.cpp:184:		//rand = svars->rng->getInteger(0, count.size()*count.size()-1);
CreationIJSP.cpp:185:		//int k = int(sqrt(rand));
CreationIJSP.cpp:186:		rand = jobOrderByRemainingTime[k];
CreationIJSP.cpp:187:		int taskid = count[rand];
CreationIJSP.cpp:188:		permutation.push_back(taskid);
CreationIJSP.cpp:189:
CreationIJSP.cpp:190:		// Update remaining time for the job
CreationIJSP.cpp:191:		jobRemainingTime[rand] -= fuzzyProb->getTask(count[rand])->p;
CreationIJSP.cpp:192:		// Update order of the jobs from higher to lower remaining time
CreationIJSP.cpp:193:		while (k < jobOrderByRemainingTime.size()-1 &&
CreationIJSP.cpp:194:			FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k]], false).isBetterThan(&(FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k+1]], false)))) {
CreationIJSP.cpp:195:			int aux = jobOrderByRemainingTime[k];
CreationIJSP.cpp:196:			jobOrderByRemainingTime[k] = jobOrderByRemainingTime[k + 1];
CreationIJSP.cpp:197:			jobOrderByRemainingTime[k + 1] = aux;
CreationIJSP.cpp:198:			k++;
CreationIJSP.cpp:199:		}
CreationIJSP.cpp:200:		// Pass to the next task of the job
CreationIJSP.cpp:201:		count[rand] = (*fuzzyProb)[count[rand]]->js;
CreationIJSP.cpp:202:		if (count[rand] < 0) {
CreationIJSP.cpp:203:			for (size_t i = rand + 1; i < count.size(); i++) {
CreationIJSP.cpp:204:				count[i - 1] = count[i];
CreationIJSP.cpp:205:				jobRemainingTime[i - 1] = jobRemainingTime[i];
CreationIJSP.cpp:206:			}
CreationIJSP.cpp:207:			for (size_t i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:208:				if (jobOrderByRemainingTime[i] > rand) {
CreationIJSP.cpp:209:					jobOrderByRemainingTime[i]--;
CreationIJSP.cpp:210:				}
CreationIJSP.cpp:211:			}
CreationIJSP.cpp:212:			jobRemainingTime.pop_back();
CreationIJSP.cpp:213:			jobOrderByRemainingTime.pop_back();
CreationIJSP.cpp:214:			count.pop_back();
CreationIJSP.cpp:215:		}
CreationIJSP.cpp:216:		
CreationIJSP.cpp:217:	}
CreationIJSP.cpp:218:	sgs->buildSchedule(svars, permutation);
CreationIJSP.cpp:219:	indiv = svars->encoder->encode(sgs->getSchedule(), svars);
CreationIJSP.cpp:220:	indiv->updatePhenotype(sgs->getSchedule()->clone());
CreationIJSP.cpp:221:
CreationIJSP.cpp:222:	return indiv;
CreationIJSP.cpp:223:}
