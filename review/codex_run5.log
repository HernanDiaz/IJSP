35:struct Iv {                       // intervalo cerrado [lo, hi]
36:    double lo, hi;
37:    Iv(double a = 0, double b = 0) : lo(a), hi(b) {}
38:    double mid() const { return (lo + hi) / 2.0; }
39:};
40:static Iv operator+(const Iv &a, const Iv &b) { return Iv(a.lo + b.lo, a.hi + b.hi); }
41:static Iv cmax(const Iv &a, const Iv &b) {                    // maximo componentwise
42:    return Iv(std::max(a.lo, b.lo), std::max(a.hi, b.hi));
43:}
44:// a domina a b si ambos extremos de a son <= los de b
45:static bool leq(const Iv &a, const Iv &b) { return a.lo <= b.lo && a.hi <= b.hi; }
47:struct Instancia {
48:    int n = 0, m = 0;                       // trabajos, maquinas
49:    std::vector<std::vector<int> > maq;     // maq[j][k] = maquina de la op k del trabajo j
50:    std::vector<std::vector<Iv> > dur;      // dur[j][k]
51:};
53:static std::string limpia(std::string s) {
54:    while (!s.empty() && (s[s.size()-1] == '\r' || s[s.size()-1] == '\n')) s.erase(s.size()-1);
55:    return s;
56:}
58:static bool leeInstancia(const char *ruta, Instancia &I) {
59:    std::ifstream f(ruta);
60:    if (!f) { fprintf(stderr, "no se puede abrir %s\n", ruta); return false; }
61:    std::string l; int seccion = 0;         // 1=n 2=m 3=secuencia 4=duraciones
62:    std::vector<std::vector<int> > seq;
63:    std::vector<std::vector<Iv> > dus;
64:    while (std::getline(f, l)) {
65:        l = limpia(l);
66:        if (l.find("NUMERO DE TRABAJOS") != std::string::npos) { seccion = 1; continue; }
67:        if (l.find("NUMERO DE RECURSOS") != std::string::npos) { seccion = 2; continue; }
68:        if (l.find("SECUENCIA DE MAQUINAS") != std::string::npos) { seccion = 3; continue; }
69:        if (l.find("DURACIONES") != std::string::npos) { seccion = 4; continue; }
70:        if (l.find("TIEMPOS MAXIMOS") != std::string::npos) { seccion = 0; continue; }
71:        if (l.empty() || l[0] == '/') continue;
72:        if (seccion == 1) { I.n = atoi(l.c_str()); seccion = 0; }
73:        else if (seccion == 2) { I.m = atoi(l.c_str()); seccion = 0; }
74:        else if (seccion == 3) {
75:            std::istringstream is(l); int v; std::vector<int> fila;
76:            while (is >> v) fila.push_back(v);
77:            if (!fila.empty()) seq.push_back(fila);
78:        }
79:        else if (seccion == 4) {
80:            // formato: (a, b) (a, b) ...
81:            std::string t = l;
82:            for (size_t i = 0; i < t.size(); i++) if (t[i]=='('||t[i]==')'||t[i]==',') t[i] = ' ';
83:            std::istringstream is(t); double a, b; std::vector<Iv> fila;
84:            while (is >> a >> b) fila.push_back(Iv(a, b));
85:            if (!fila.empty()) dus.push_back(fila);
86:        }
87:    }
88:    if (I.n <= 0 || I.m <= 0 || (int)seq.size() < I.n || (int)dus.size() < I.n) {
89:        fprintf(stderr, "instancia mal formada: n=%d m=%d seq=%zu dur=%zu\n",
90:                I.n, I.m, seq.size(), dus.size());
91:        return false;
92:    }
93:    seq.resize(I.n); dus.resize(I.n);
94:    I.maq = seq; I.dur = dus;
95:    for (int j = 0; j < I.n; j++)
96:        if ((int)I.maq[j].size() != I.m || (int)I.dur[j].size() != I.m) {
97:            fprintf(stderr, "trabajo %d: %zu maquinas, %zu duraciones (esperado %d)\n",
98:                    j, I.maq[j].size(), I.dur[j].size(), I.m);
99:            return false;
100:        }
101:    return true;
102:}
104:// Decodifica una secuencia de IDs de tarea y devuelve el makespan intervalar.
105:// modoInsercion = false -> semiactivo (append); true -> activo (insercion en huecos)
106:static long g_inserciones = 0;   // cuantas veces el SGS activo llega a rellenar un hueco
107:static long g_desordenes = 0, g_tareas = 0;   // diagnostico de recodificacion lamarckiana
108:static double g_ultimoInicio = -1e18;
109:static bool decodifica(const Instancia &I, const std::vector<int> &sec,
110:                       bool modoInsercion, Iv &makespan, std::string &err) {
111:    const int N = I.n * I.m;
112:    if ((int)sec.size() != N) { err = "longitud de la secuencia incorrecta"; return false; }
114:    g_ultimoInicio = -1e18;
115:    std::vector<int> hechas(I.n, 0);                  // ops ya colocadas de cada trabajo
116:    std::vector<Iv> finTrabajo(I.n, Iv(0,0));         // fin de la ultima op colocada
117:    // ocupacion por maquina: lista ordenada de (inicio, fin) de las tareas colocadas
118:    std::vector<std::vector<std::pair<Iv,Iv> > > ocup(I.m);
120:    for (size_t p = 0; p < sec.size(); p++) {
121:        int id = sec[p];
122:        if (id < 0 || id >= N) { err = "id de tarea fuera de rango"; return false; }
123:        int j = id / I.m, k = id % I.m;
124:        if (k != hechas[j]) { err = "orden de operaciones incoherente dentro de un trabajo"; return false; }
125:        int mq = I.maq[j][k];
126:        if (mq < 0 || mq >= I.m) { err = "maquina fuera de rango"; return false; }
127:        Iv d = I.dur[j][k];
128:        Iv listo = finTrabajo[j];                     // no puede empezar antes
129:        Iv ini, fin;
130:        bool colocada = false;
132:        if (modoInsercion) {
133:            // primer hueco de la maquina donde quepa respetando la precedencia
134:            std::vector<std::pair<Iv,Iv> > &oc = ocup[mq];
135:            const size_t nOc = oc.size();             // tamano FIJO: oc cambia al insertar
136:            Iv libre(0,0);
137:            for (size_t q = 0; q < nOc && !colocada; q++) {
138:                Iv arranque = cmax(libre, listo);
139:                Iv candFin = arranque + d;
140:                if (leq(candFin, oc[q].first)) {      // cabe antes de la tarea q
141:                    ini = arranque; fin = candFin; colocada = true; g_inserciones++;
142:                    oc.insert(oc.begin() + q, std::make_pair(ini, fin));
143:                }
144:                libre = oc[q + (colocada ? 1 : 0)].second;
145:            }
146:            if (!colocada) {                          // al final de la maquina
147:                Iv arranque = cmax(libre, listo);
148:                ini = arranque; fin = arranque + d; colocada = true;
149:                oc.push_back(std::make_pair(ini, fin));
150:            }
151:        }
152:        if (!colocada) {                               // append: detras de todo
153:            std::vector<std::pair<Iv,Iv> > &oc = ocup[mq];
154:            Iv ultima = oc.empty() ? Iv(0,0) : oc.back().second;
155:            ini = cmax(ultima, listo);
156:            fin = ini + d;
157:            oc.push_back(std::make_pair(ini, fin));
158:        }
159:        // DIAGNOSTICO: ¿viene el cromosoma recodificado desde un schedule real?
160:        // Si el algoritmo es lamarckiano, la secuencia almacenada es el orden en
161:        // que las tareas se ejecutaron, luego los inicios deben salir no
162:        // decrecientes al decodificar. Un solo descenso indica que la secuencia
163:        // NO es una recodificacion del schedule.
164:        if (ini.lo + 1e-9 < g_ultimoInicio) g_desordenes++;
165:        g_ultimoInicio = ini.lo;
166:        g_tareas++;
168:        finTrabajo[j] = fin;
169:        hechas[j]++;
170:    }
171:    for (int j = 0; j < I.n; j++)
172:        if (hechas[j] != I.m) { err = "algun trabajo no completo"; return false; }
174:    makespan = Iv(0,0);
175:    for (int j = 0; j < I.n; j++) makespan = cmax(makespan, finTrabajo[j]);
176:    return true;
177:}
179:int main(int argc, char **argv) {
180:    if (argc < 3) {
181:        fprintf(stderr, "uso: %s <instancia.txt> <Sols.csv> [append|insertion]\n", argv[0]);
182:        return 2;
183:    }
184:    bool insercion = (argc < 4) || (strcmp(argv[3], "append") != 0);
186:    Instancia I;
187:    if (!leeInstancia(argv[1], I)) return 2;
189:    std::ifstream f(argv[2]);
190:    if (!f) { fprintf(stderr, "no se puede abrir %s\n", argv[2]); return 2; }
191:    std::string l;
192:    std::getline(f, l);                                // cabecera
193:    int nruns = 0, disc = 0; double maxdif = 0;
194:    printf("%-5s %20s %20s %10s\n", "run", "reportado E[Cmax]", "recomputado", "dif");
195:    while (std::getline(f, l)) {
196:        l = limpia(l);
197:        if (l.empty()) continue;
198:        size_t p1 = l.find(';'); if (p1 == std::string::npos) continue;
199:        size_t p2 = l.find(';', p1 + 1); if (p2 == std::string::npos) continue;
200:        int run = atoi(l.substr(0, p1).c_str());
201:        std::string sol = l.substr(p1 + 1, p2 - p1 - 1);
202:        std::string obj = l.substr(p2 + 1);
203:        // objetivo "(a, b)"
204:        for (size_t i = 0; i < obj.size(); i++) if (obj[i]=='('||obj[i]==')'||obj[i]==',') obj[i]=' ';
205:        double oa = 0, ob = 0; { std::istringstream is(obj); is >> oa >> ob; }
206:        std::vector<int> sec; { std::istringstream is(sol); int v; while (is >> v) sec.push_back(v); }
208:        Iv mk; std::string err;
209:        if (!decodifica(I, sec, insercion, mk, err)) {
210:            printf("%-5d  ERROR: %s\n", run, err.c_str());
211:            disc++; nruns++;
212:            continue;
213:        }
214:        double rep = (oa + ob) / 2.0, rec = mk.mid(), dif = rec - rep;
215:        if (dif < 0) dif = -dif;
216:        if (dif > 1e-6) { disc++; if (dif > maxdif) maxdif = dif; }
217:        printf("%-5d %20.1f %20.1f %+10.2f\n", run, rep, rec, rec - rep);
218:        nruns++;
219:    }
220:    printf("\nmodo: %s | runs verificados: %d | discrepancias: %d | maxDif E[Cmax]: %g\n",
221:           insercion ? "insertion" : "append", nruns, disc, maxdif);
222:    if (insercion)
223:        printf("huecos rellenados por el SGS activo: %ld en %ld tareas (%.4f%%)\n",
224:               g_inserciones, g_tareas,
225:               g_tareas ? 100.0 * g_inserciones / (double)g_tareas : 0.0);
226:    printf("orden de la secuencia vs inicios decodificados: %ld descensos en %ld tareas (%.4f%%)\n",
227:           g_desordenes, g_tareas, g_tareas ? 100.0 * g_desordenes / (double)g_tareas : 0.0);
228:    printf("  (0 descensos = la secuencia es una recodificacion del schedule ejecutado)\n");
229:    printf("%s\n", disc == 0 ? "OK: el makespan reportado se reproduce exactamente."
230:                             : "ATENCION: el makespan reportado NO coincide.");
231:    return disc == 0 ? 0 : 1;
232:}

