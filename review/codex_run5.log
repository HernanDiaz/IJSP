CreationIJSP.cpp:737:FuzzyFW::Individual * CreationSCTFIntervalMkSchedule::createIndividual(
CreationIJSP.cpp:738:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:739:	int rand;
CreationIJSP.cpp:740:	if (this->randomRatio > 0) {
CreationIJSP.cpp:741:		rand = svars->rng->getInteger(0, 100);
CreationIJSP.cpp:742:		if (rand <= this->randomRatio * 100) {
CreationIJSP.cpp:743:			return this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:744:		}
CreationIJSP.cpp:745:	}
CreationIJSP.cpp:746:	std::vector<int> permutation, count;
CreationIJSP.cpp:747:
CreationIJSP.cpp:748:	FuzzyFW::Individual * indiv;
CreationIJSP.cpp:749:
CreationIJSP.cpp:750:	// Convert the problem type
CreationIJSP.cpp:751:	ProblemIJSP * fuzzyProb =
CreationIJSP.cpp:752:		dynamic_cast<ProblemIJSP *>(svars->problem);
CreationIJSP.cpp:753:	if (fuzzyProb == NULL) {
CreationIJSP.cpp:754:		std::string errorMsg = "This enconding function works only with ";
CreationIJSP.cpp:755:		errorMsg += "interval problems.";
CreationIJSP.cpp:756:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:757:	}
CreationIJSP.cpp:758:	std::vector<FuzzyFW::Interval> mMkspan(fuzzyProb->getNumberMachines());
CreationIJSP.cpp:759:	std::vector<FuzzyFW::Interval> jMkspan(fuzzyProb->getNumberJobs());
CreationIJSP.cpp:760:
CreationIJSP.cpp:761:	// Find the first task of each job and count remaining time for each job
CreationIJSP.cpp:762:	std::vector<FuzzyFW::Interval> jobRemainingTime(fuzzyProb->getNumberJobs());
CreationIJSP.cpp:763:	std::vector<int> jobOrderByRemainingTime;
CreationIJSP.cpp:764:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
CreationIJSP.cpp:765:		unsigned int numberOfTasks = fuzzyProb->getNumberTasks(i);
CreationIJSP.cpp:766:		if (numberOfTasks > 0) {
CreationIJSP.cpp:767:			count.push_back(fuzzyProb->getTaskId(i, 0));
CreationIJSP.cpp:768:			//count remaining time for each job
CreationIJSP.cpp:769:			for (unsigned int j = 0; j < numberOfTasks; j++) {
CreationIJSP.cpp:770:				jobRemainingTime[i] += fuzzyProb->getTask(fuzzyProb->getTaskId(i, j))->p;
CreationIJSP.cpp:771:			}
CreationIJSP.cpp:772:			//Order the jobs from higher to lower remaining time
CreationIJSP.cpp:773:			int k = 0;
CreationIJSP.cpp:774:			while (k < jobOrderByRemainingTime.size() &&
CreationIJSP.cpp:775:				FuzzyFW::FitnessInterval(jobRemainingTime[i], false).isBetterThan(&(FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k]], false)))) {
CreationIJSP.cpp:776:				k++;
CreationIJSP.cpp:777:			}
CreationIJSP.cpp:778:			jobOrderByRemainingTime.insert(jobOrderByRemainingTime.begin() + k, i);
CreationIJSP.cpp:779:		}
CreationIJSP.cpp:780:	}
CreationIJSP.cpp:781:	// Build an array with repetitions
CreationIJSP.cpp:782:	while (count.size() > 0) {
CreationIJSP.cpp:783:		int max = 3 < count.size() ? 3 : count.size();
CreationIJSP.cpp:784:		rand = svars->rng->getInteger(0, max*max - 1);
CreationIJSP.cpp:785:		int k = int(sqrt(rand));
CreationIJSP.cpp:786:
CreationIJSP.cpp:787:		//rand = svars->rng->getInteger(0, count.size()*count.size() - 1);
CreationIJSP.cpp:788:		//int k = int(sqrt(rand)); 
CreationIJSP.cpp:789:		rand = jobOrderByRemainingTime[k];
CreationIJSP.cpp:790:		int taskid = count[rand];
CreationIJSP.cpp:791:		permutation.push_back(taskid);
CreationIJSP.cpp:792:
CreationIJSP.cpp:793:		// Update remaining time for the job
CreationIJSP.cpp:794:		jobRemainingTime[rand] -= fuzzyProb->getTask(taskid)->p;
CreationIJSP.cpp:795:
CreationIJSP.cpp:796:		// Update machine and job makespan.
CreationIJSP.cpp:797:		const IJSP::TaskIJSP * task = fuzzyProb->getTask(taskid);
CreationIJSP.cpp:798:		FuzzyFW::Interval localMaxMkspan = maximum(mMkspan[task->machine], jMkspan[task->job], FuzzyFW::Interval::M_COMPONENT) + task->p;
CreationIJSP.cpp:799:		mMkspan[task->machine] = localMaxMkspan;
CreationIJSP.cpp:800:		jMkspan[task->job] = localMaxMkspan;
CreationIJSP.cpp:801:
CreationIJSP.cpp:802:
CreationIJSP.cpp:803:		// Update order of the jobs from higher to lower remaining time
CreationIJSP.cpp:804:		while (k < jobOrderByRemainingTime.size() - 1 &&
CreationIJSP.cpp:805:			FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k]] + jMkspan[jobOrderByRemainingTime[k]], false)
CreationIJSP.cpp:806:			.isBetterThan(&(FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k + 1]] + jMkspan[jobOrderByRemainingTime[k + 1]], false)))) {
CreationIJSP.cpp:807:			int aux = jobOrderByRemainingTime[k];
CreationIJSP.cpp:808:			jobOrderByRemainingTime[k] = jobOrderByRemainingTime[k + 1];
CreationIJSP.cpp:809:			jobOrderByRemainingTime[k + 1] = aux;
CreationIJSP.cpp:810:			k++;
CreationIJSP.cpp:811:		}
CreationIJSP.cpp:812:
CreationIJSP.cpp:813:		// Pass to the next task of the job
CreationIJSP.cpp:814:		count[rand] = (*fuzzyProb)[count[rand]]->js;
CreationIJSP.cpp:815:		if (count[rand] < 0) {
CreationIJSP.cpp:816:			for (size_t i = rand + 1; i < count.size(); i++) {
CreationIJSP.cpp:817:				count[i - 1] = count[i];
CreationIJSP.cpp:818:				jobRemainingTime[i - 1] = jobRemainingTime[i];
CreationIJSP.cpp:819:			}
CreationIJSP.cpp:820:			for (size_t i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:821:				if (jobOrderByRemainingTime[i] > rand) {
CreationIJSP.cpp:822:					jobOrderByRemainingTime[i]--;
CreationIJSP.cpp:823:				}
CreationIJSP.cpp:824:			}
CreationIJSP.cpp:825:			jobRemainingTime.pop_back();
CreationIJSP.cpp:826:			//jobOrderByRemainingTime.pop_back();
CreationIJSP.cpp:827:			jobOrderByRemainingTime.erase(jobOrderByRemainingTime.begin() + k);
CreationIJSP.cpp:828:			jMkspan.erase(jMkspan.begin() + k);
CreationIJSP.cpp:829:			mMkspan.erase(mMkspan.begin() + k);
CreationIJSP.cpp:830:			count.pop_back();
CreationIJSP.cpp:831:		}
CreationIJSP.cpp:832:
CreationIJSP.cpp:833:	}
CreationIJSP.cpp:834:	sgs->buildSchedule(svars, permutation);
CreationIJSP.cpp:835:	indiv = svars->encoder->encode(sgs->getSchedule(), svars);
CreationIJSP.cpp:836:	indiv->updatePhenotype(sgs->getSchedule()->clone());
CreationIJSP.cpp:837:
CreationIJSP.cpp:838:	return indiv;
CreationIJSP.cpp:839:}
