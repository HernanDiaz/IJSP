CreationIJSP.cpp:1322:void CreationSeededSchedule::setup(FuzzyFW::ParameterDB *parameters) {
CreationIJSP.cpp:1323:	Creation::setup(parameters);
CreationIJSP.cpp:1324:
CreationIJSP.cpp:1325:	// SGS para decodificar (igual que la creacion aleatoria)
CreationIJSP.cpp:1326:	std::string sgsType = parameters->getStringLower(this->sgsLabel);
CreationIJSP.cpp:1327:	if (sgsType.length() == 0) {
CreationIJSP.cpp:1328:		std::string errorMsg = "SGS not found. Please, specify a SGS to use";
CreationIJSP.cpp:1329:		errorMsg += " during the evaluation of individuals";
CreationIJSP.cpp:1330:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:1331:	}
CreationIJSP.cpp:1332:	this->sgs = IJSPClassRegister::getSGSObject(sgsType);
CreationIJSP.cpp:1333:	if (this->sgs == NULL) {
CreationIJSP.cpp:1334:		std::string errorMsg = "The introduced SGS is not";
CreationIJSP.cpp:1335:		errorMsg += " recognised: \'" + sgsType + "\'";
CreationIJSP.cpp:1336:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:1337:	}
CreationIJSP.cpp:1338:	this->sgs->setup(parameters);
CreationIJSP.cpp:1339:	this->randomSchedule.setup(parameters);
CreationIJSP.cpp:1340:
CreationIJSP.cpp:1341:	// Parametros de siembra
CreationIJSP.cpp:1342:	this->seedCount = (unsigned int)parameters->getInteger(CREATION_SEED_COUNT, 0);
CreationIJSP.cpp:1343:	this->popSize = (unsigned int)parameters->getInteger(CREATION_POPULATION_SIZE, 0);
CreationIJSP.cpp:1344:	// Indice global de la primera ejecucion de este proceso (0 si no se indica,
CreationIJSP.cpp:1345:	// que reproduce el comportamiento anterior para una corrida no troceada).
CreationIJSP.cpp:1346:	this->seedOffset = (unsigned int)parameters->getInteger(CREATION_SEED_OFFSET, 0);
CreationIJSP.cpp:1347:
CreationIJSP.cpp:1348:	std::string poolPath = parameters->getString(CREATION_SEED_POOL);
CreationIJSP.cpp:1349:	if (poolPath.length() == 0) {
CreationIJSP.cpp:1350:		throw new IJSPException("Creation",
CreationIJSP.cpp:1351:			"Parametro \'" + std::string(CREATION_SEED_POOL) + "\' no encontrado para creation=ijsp.seeded");
CreationIJSP.cpp:1352:	}
CreationIJSP.cpp:1353:
CreationIJSP.cpp:1354:	std::ifstream in(poolPath.c_str());
CreationIJSP.cpp:1355:	if (!in.is_open()) {
CreationIJSP.cpp:1356:		throw new IJSPException("Creation",
CreationIJSP.cpp:1357:			"No se pudo abrir el pool de siembra: \'" + poolPath + "\'");
CreationIJSP.cpp:1358:	}
CreationIJSP.cpp:1359:	this->seedJobs.clear();
CreationIJSP.cpp:1360:	std::string line;
CreationIJSP.cpp:1361:	while (std::getline(in, line)) {
CreationIJSP.cpp:1362:		if (line.empty()) continue;
CreationIJSP.cpp:1363:		size_t sc = line.find(';');
CreationIJSP.cpp:1364:		std::string permPart = (sc == std::string::npos) ? line : line.substr(0, sc);
CreationIJSP.cpp:1365:		std::vector<int> jobs;
CreationIJSP.cpp:1366:		std::stringstream ss(permPart);
CreationIJSP.cpp:1367:		int v;
CreationIJSP.cpp:1368:		while (ss >> v) jobs.push_back(v);
CreationIJSP.cpp:1369:		if (!jobs.empty()) this->seedJobs.push_back(jobs);
CreationIJSP.cpp:1370:	}
CreationIJSP.cpp:1371:	in.close();
CreationIJSP.cpp:1372:
CreationIJSP.cpp:1373:	if (this->seedJobs.empty()) {
CreationIJSP.cpp:1374:		throw new IJSPException("Creation",
