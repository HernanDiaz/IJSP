CreationIJSP.cpp:1037:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:1038:	}
CreationIJSP.cpp:1039:	std::vector<FuzzyFW::Interval> mMkspan(fuzzyProb->getNumberMachines());
CreationIJSP.cpp:1040:	std::vector<FuzzyFW::Interval> jMkspan(fuzzyProb->getNumberJobs());
CreationIJSP.cpp:1041:
CreationIJSP.cpp:1042:	// Find the first task of each job and count remaining time for each job
CreationIJSP.cpp:1043:	std::vector<int> jobOrderByRemainingTime(fuzzyProb->getNumberJobs());
CreationIJSP.cpp:1044:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
CreationIJSP.cpp:1045:		unsigned int numberOfTasks = fuzzyProb->getNumberTasks(i);
CreationIJSP.cpp:1046:		if (numberOfTasks > 0) {
CreationIJSP.cpp:1047:			count.push_back(fuzzyProb->getTaskId(i, 0));
CreationIJSP.cpp:1048:		}
CreationIJSP.cpp:1049:		jobOrderByRemainingTime[i] = i;
CreationIJSP.cpp:1050:	}
CreationIJSP.cpp:1051:	// Build an array with repetitions
CreationIJSP.cpp:1052:
CreationIJSP.cpp:1053:	while (count.size() > 0) {
CreationIJSP.cpp:1054:		//Seleccionar aleatorio al principio
CreationIJSP.cpp:1055:		int max = 3 < count.size() ? 3 : count.size();
CreationIJSP.cpp:1056:		//rand = svars->rng->getInteger(0, count.size()*count.size() - 1);
CreationIJSP.cpp:1057:		//int k = count.size() - int(sqrt(rand)) - 1;
CreationIJSP.cpp:1058:		rand = svars->rng->getInteger(0, max*max - 1);
CreationIJSP.cpp:1059:		int k = max - int(sqrt(rand)) - 1;
CreationIJSP.cpp:1060:
CreationIJSP.cpp:1061:		rand = jobOrderByRemainingTime[k];
CreationIJSP.cpp:1062:		/*std::cout << "jobOrderByRemainingTime" << std::endl;
CreationIJSP.cpp:1063:		for (int i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:1064:				std::cout << jobOrderByRemainingTime[i] << " ";
CreationIJSP.cpp:1065:		}
CreationIJSP.cpp:1066:		std::cout << std::endl;
CreationIJSP.cpp:1067:		std::cout << "rand= " << rand << std::endl;*/
CreationIJSP.cpp:1068:		int taskid = count[rand];
CreationIJSP.cpp:1069:		permutation.push_back(taskid);
CreationIJSP.cpp:1070:		/*std::cout <<" count.size = "<< count.size() << std::endl;
CreationIJSP.cpp:1071:	    std::cout << "Count= " << std::endl;
CreationIJSP.cpp:1072:	    for (int i = 0; i < count.size(); i++) {
CreationIJSP.cpp:1073:	    	std::cout << count[i] << " ";
CreationIJSP.cpp:1074:	    }
CreationIJSP.cpp:1075:	    std::cout << std::endl;*/
CreationIJSP.cpp:1076:
CreationIJSP.cpp:1077:		// Update machine and job makespan.
CreationIJSP.cpp:1078:		const IJSP::TaskIJSP * task = fuzzyProb->getTask(taskid);
