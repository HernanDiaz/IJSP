EvaluationIJSP.cpp:43:void EvaluationIJSP_Makespan::setup(FuzzyFW::ParameterDB *parameters) {
EvaluationIJSP.cpp:44:	Evaluation::setup(parameters);
EvaluationIJSP.cpp:45:
EvaluationIJSP.cpp:46:	std::string compareName, maxName;
EvaluationIJSP.cpp:47:
EvaluationIJSP.cpp:48:	// Load maximum type parameter
EvaluationIJSP.cpp:49:	maxName = parameters->getString(this->maximumLabel);
EvaluationIJSP.cpp:50:	if (maxName.length() == 0) {
EvaluationIJSP.cpp:51:		std::string errorMsg = this->maximumLabel + " parameter not found.";
EvaluationIJSP.cpp:52:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:53:	}
EvaluationIJSP.cpp:54:	this->intervalMaximum = FuzzyFW::Interval::getMaximum(maxName);
EvaluationIJSP.cpp:55:	if (this->intervalMaximum == FuzzyFW::Interval::M_Err) {
EvaluationIJSP.cpp:56:		std::string errorMsg = "Invalid value for parameter ";
EvaluationIJSP.cpp:57:		errorMsg += "\'" + this->maximumLabel + "\': \'";
EvaluationIJSP.cpp:58:		errorMsg += maxName + "\'";
EvaluationIJSP.cpp:59:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:60:	}
EvaluationIJSP.cpp:61:
EvaluationIJSP.cpp:62:	// Load comparison strategy parameter
EvaluationIJSP.cpp:63:	compareName = parameters->getString(this->compareLabel);
EvaluationIJSP.cpp:64:	if (compareName.length() == 0) {
EvaluationIJSP.cpp:65:		std::string errorMsg = this->compareLabel + " parameter not found.";
EvaluationIJSP.cpp:66:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:67:	}
EvaluationIJSP.cpp:68:	this->intervalCompare = FuzzyFW::Interval::getComparison(compareName);
EvaluationIJSP.cpp:69:	if (this->intervalCompare == FuzzyFW::Interval::C_Err) {
EvaluationIJSP.cpp:70:		std::string errorMsg = "Invalid value for parameter ";
EvaluationIJSP.cpp:71:		errorMsg += "\'" + this->compareLabel + "\': \'";
EvaluationIJSP.cpp:72:		errorMsg += compareName + "\'";
EvaluationIJSP.cpp:73:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:74:	}
EvaluationIJSP.cpp:75:	FuzzyFW::FitnessInterval::FitnessCompareStrategy = this->intervalCompare;
EvaluationIJSP.cpp:76:}
