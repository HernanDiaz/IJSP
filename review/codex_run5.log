CreationIJSP.cpp:501:		rand = jobOrderByRemainingTime[k]; //renombrar rand para jobId en esta linea
CreationIJSP.cpp:502:		int taskid = count[rand];
CreationIJSP.cpp:503:		permutation.push_back(taskid);
CreationIJSP.cpp:504:
CreationIJSP.cpp:505:		// Update remaining time for the job
CreationIJSP.cpp:506:		jobRemainingTime[rand] -= fuzzyProb->getTask(count[rand])->p;
CreationIJSP.cpp:507:		// Update order of the jobs from higher to lower remaining time
CreationIJSP.cpp:508:		while (k < jobOrderByRemainingTime.size() - 1 &&
