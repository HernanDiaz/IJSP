CreationIJSP.cpp:1080:		mMkspan[task->machine] = localMaxMkspan;
CreationIJSP.cpp:1081:		jMkspan[task->job] = localMaxMkspan;
CreationIJSP.cpp:1082:
CreationIJSP.cpp:1083:		//Order from better to worst
CreationIJSP.cpp:1084:		while (k < jobOrderByRemainingTime.size() - 1 &&
CreationIJSP.cpp:1085:			FuzzyFW::FitnessInterval(jMkspan[jobOrderByRemainingTime[k]], false)
CreationIJSP.cpp:1086:			.isWorseThan(&(FuzzyFW::FitnessInterval(jMkspan[jobOrderByRemainingTime[k + 1]], false)))) {
CreationIJSP.cpp:1087:			int aux = jobOrderByRemainingTime[k];
CreationIJSP.cpp:1088:			jobOrderByRemainingTime[k] = jobOrderByRemainingTime[k + 1];
CreationIJSP.cpp:1089:			jobOrderByRemainingTime[k + 1] = aux;
CreationIJSP.cpp:1090:			k++;
CreationIJSP.cpp:1091:		}
CreationIJSP.cpp:1092:
CreationIJSP.cpp:1093:		/*std::cout << "jobOrderByRemainingTime ordenado" << std::endl;
CreationIJSP.cpp:1094:		for (int i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:1095:			std::cout << jobOrderByRemainingTime[i] << " ";
CreationIJSP.cpp:1096:		}
CreationIJSP.cpp:1097:		std::cout << std::endl;*/
CreationIJSP.cpp:1098:
CreationIJSP.cpp:1099:		// Pass to the next task of the job
CreationIJSP.cpp:1100:		count[rand] = (*fuzzyProb)[count[rand]]->js;
CreationIJSP.cpp:1101:		/*std::cout <<"count[rand]= "<< count[rand] << std::endl;
CreationIJSP.cpp:1102:		if (count[rand] > 0) {
CreationIJSP.cpp:1103:			std::cout << (*fuzzyProb)[count[rand]]->js << std::endl;
CreationIJSP.cpp:1104:		}
CreationIJSP.cpp:1105:		else std::cout << "(count[rand] < 0)" << std::endl;*/
CreationIJSP.cpp:1106:
CreationIJSP.cpp:1107:
CreationIJSP.cpp:1108:		if (count[rand] < 0) {
CreationIJSP.cpp:1109:			for (size_t i = rand + 1; i < count.size(); i++) {
CreationIJSP.cpp:1110:				count[i - 1] = count[i];
CreationIJSP.cpp:1111:			}
CreationIJSP.cpp:1112:			for (size_t i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:1113:				if (jobOrderByRemainingTime[i] > rand) {
CreationIJSP.cpp:1114:					jobOrderByRemainingTime[i]--;
CreationIJSP.cpp:1115:				}
CreationIJSP.cpp:1116:			}
CreationIJSP.cpp:1117:			int job = jobOrderByRemainingTime[k];
CreationIJSP.cpp:1118:			//std::cout << "Borrando trabajo " << job << " en la posicicion " << k << std::endl;
CreationIJSP.cpp:1119:			jobOrderByRemainingTime.erase(jobOrderByRemainingTime.begin() + k);
CreationIJSP.cpp:1120:			/*std::cout << "jobOrderByRemainingTime borrado" << std::endl;
CreationIJSP.cpp:1121:			for (int i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:1122:				std::cout << jobOrderByRemainingTime[i] << " ";
