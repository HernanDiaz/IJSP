EvaluationIJSP.cpp:239:FuzzyFW::Objective * EvaluationIJSP_Tardiness::getObjectiveFunction(
EvaluationIJSP.cpp:240:	const FuzzyFW::SharedVarsEvolutionary * const svars,
EvaluationIJSP.cpp:241:	FuzzyFW::Individual *individual) const {
EvaluationIJSP.cpp:242:
EvaluationIJSP.cpp:243:	FuzzyFW::Solution * solution;
EvaluationIJSP.cpp:244:	ScheduleIJSP * schedule;
EvaluationIJSP.cpp:245:	ProblemIJSP *fuzzyProb;
EvaluationIJSP.cpp:246:	const FuzzyFW::TimeWindowLinear* timeWindow;
EvaluationIJSP.cpp:247:	FuzzyFW::Interval tardiness = FuzzyFW::Interval(0, 0);
EvaluationIJSP.cpp:248:
EvaluationIJSP.cpp:249:	// Evaluate the individual to find the phenotype
EvaluationIJSP.cpp:250:	if (individual->isPhenotypeUpdated())
EvaluationIJSP.cpp:251:		solution = individual->getPhenotype();
EvaluationIJSP.cpp:252:	else
EvaluationIJSP.cpp:253:		solution = svars->decoder->decode(individual, svars);
EvaluationIJSP.cpp:254:
EvaluationIJSP.cpp:255:	schedule = dynamic_cast<ScheduleIJSP *>(solution);
EvaluationIJSP.cpp:256:	if (schedule == NULL) {
EvaluationIJSP.cpp:257:		std::string errorMsg = "This evaluation function is valid only ";
EvaluationIJSP.cpp:258:		errorMsg += "for Interval Job Shop Problems.";
EvaluationIJSP.cpp:259:		throw new IJSPException("EvaluationIJSP", errorMsg);
EvaluationIJSP.cpp:260:	}
EvaluationIJSP.cpp:261:
EvaluationIJSP.cpp:262:	fuzzyProb =
EvaluationIJSP.cpp:263:		dynamic_cast<ProblemIJSP *>(svars->problem);
EvaluationIJSP.cpp:264:	if (fuzzyProb == NULL) {
EvaluationIJSP.cpp:265:		std::string errorMsg = "This evaluation function works only with ";
EvaluationIJSP.cpp:266:		errorMsg += "Interval problems.";
EvaluationIJSP.cpp:267:		throw new IJSPException("EvaluationIJSP", errorMsg);
EvaluationIJSP.cpp:268:	}
EvaluationIJSP.cpp:269:
EvaluationIJSP.cpp:270:	// Compute the tardiness
EvaluationIJSP.cpp:271:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
EvaluationIJSP.cpp:272:		timeWindow = dynamic_cast<const FuzzyFW::TimeWindowLinear *>(fuzzyProb->getTimeWindow(i));
EvaluationIJSP.cpp:273:		if (timeWindow == NULL) {
EvaluationIJSP.cpp:274:			std::string errorMsg = "This evaluation function works only with ";
EvaluationIJSP.cpp:275:			errorMsg += "Linear Timewidows.";
EvaluationIJSP.cpp:276:			throw new IJSPException("EvaluationIJSP", errorMsg);
EvaluationIJSP.cpp:277:		}
EvaluationIJSP.cpp:278:
EvaluationIJSP.cpp:279:		tardiness += FuzzyFW::Interval(std::max(0.0, schedule->getCTJob(i).a - timeWindow->d2), std::max(0.0, schedule->getCTJob(i).b - timeWindow->d1));
EvaluationIJSP.cpp:280:	}
EvaluationIJSP.cpp:281:
EvaluationIJSP.cpp:282:	return new FuzzyFW::FitnessInterval(tardiness, false);
EvaluationIJSP.cpp:283:}
