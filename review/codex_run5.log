CreationIJSP.cpp:1380://-----  buildFromJobPerm  ----------------------------------------------------
CreationIJSP.cpp:1381:FuzzyFW::Individual * CreationSeededSchedule::buildFromJobPerm(
CreationIJSP.cpp:1382:	const std::vector<int> &jobs,
CreationIJSP.cpp:1383:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:1384:
CreationIJSP.cpp:1385:	ProblemIJSP * fuzzyProb = dynamic_cast<ProblemIJSP *>(svars->problem);
CreationIJSP.cpp:1386:	if (fuzzyProb == NULL) {
CreationIJSP.cpp:1387:		std::string errorMsg = "This creation works only with interval problems.";
CreationIJSP.cpp:1388:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:1389:	}
CreationIJSP.cpp:1390:
CreationIJSP.cpp:1391:	// Convertir secuencia de trabajos (1-based) -> permutacion de task-ids internos
CreationIJSP.cpp:1392:	unsigned int nJobs = fuzzyProb->getNumberJobs();
CreationIJSP.cpp:1393:	std::vector<int> occ(nJobs, 0), taskPerm;
CreationIJSP.cpp:1394:	taskPerm.reserve(jobs.size());
CreationIJSP.cpp:1395:	for (size_t i = 0; i < jobs.size(); i++) {
CreationIJSP.cpp:1396:		int job0 = jobs[i] - 1;
CreationIJSP.cpp:1397:		if (job0 < 0 || job0 >= (int)nJobs) {
CreationIJSP.cpp:1398:			throw new IJSPException("Creation",
CreationIJSP.cpp:1399:				"Numero de trabajo fuera de rango en el pool: " + valueToString(jobs[i]));
CreationIJSP.cpp:1400:		}
CreationIJSP.cpp:1401:		int tid = fuzzyProb->getTaskId(job0, occ[job0]);
CreationIJSP.cpp:1402:		if (tid < 0) {
CreationIJSP.cpp:1403:			throw new IJSPException("Creation",
CreationIJSP.cpp:1404:				"Ocurrencia de trabajo invalida en el pool (trabajo " + valueToString(jobs[i]) + ")");
CreationIJSP.cpp:1405:		}
CreationIJSP.cpp:1406:		occ[job0]++;
CreationIJSP.cpp:1407:		taskPerm.push_back(tid);
CreationIJSP.cpp:1408:	}
CreationIJSP.cpp:1409:
CreationIJSP.cpp:1410:	// Misma genesis que la creacion aleatoria, pero con la permutacion dada
CreationIJSP.cpp:1411:	this->sgs->buildSchedule(svars, taskPerm);
CreationIJSP.cpp:1412:	FuzzyFW::Individual * indiv = svars->encoder->encode(this->sgs->getSchedule(), svars);
CreationIJSP.cpp:1413:	indiv->updatePhenotype(this->sgs->getSchedule()->clone());
CreationIJSP.cpp:1414:	return indiv;
CreationIJSP.cpp:1415:}
