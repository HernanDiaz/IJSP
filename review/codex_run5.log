EvaluationIJSP.cpp:124://----- Evaluate  -------------------------------------------------------------
EvaluationIJSP.cpp:125:FuzzyFW::Fitness * EvaluationIJSP_Makespan::evaluate(
EvaluationIJSP.cpp:126:	const FuzzyFW::SharedVarsEvolutionary * const svars,
EvaluationIJSP.cpp:127:	FuzzyFW::Individual *individual) const {
EvaluationIJSP.cpp:128:
EvaluationIJSP.cpp:129:	FuzzyFW::Solution * solution;
EvaluationIJSP.cpp:130:	ScheduleIJSP * schedule;
EvaluationIJSP.cpp:131:	ProblemIJSP *fuzzyProb;
EvaluationIJSP.cpp:132:	FuzzyFW::Interval makespan = FuzzyFW::Interval(0, 0);
EvaluationIJSP.cpp:133:
EvaluationIJSP.cpp:134:	// Evaluate the individual to find the phenotype
EvaluationIJSP.cpp:135:	if (individual->isPhenotypeUpdated())
EvaluationIJSP.cpp:136:		solution = individual->getPhenotype();
EvaluationIJSP.cpp:137:	else
EvaluationIJSP.cpp:138:		solution = svars->decoder->decode(individual, svars);
EvaluationIJSP.cpp:139:
EvaluationIJSP.cpp:140:	schedule = dynamic_cast<ScheduleIJSP *>(solution);
EvaluationIJSP.cpp:141:	if (schedule == NULL) {
EvaluationIJSP.cpp:142:		std::string errorMsg = "This evaluation function is valid only ";
EvaluationIJSP.cpp:143:		errorMsg += "for Interval Job Shop Problems.";
EvaluationIJSP.cpp:144:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:145:	}
EvaluationIJSP.cpp:146:
EvaluationIJSP.cpp:147:	fuzzyProb =
EvaluationIJSP.cpp:148:		dynamic_cast<ProblemIJSP *>(svars->problem);
EvaluationIJSP.cpp:149:	if (fuzzyProb == NULL) {
EvaluationIJSP.cpp:150:		std::string errorMsg = "This evaluation function works only with ";
EvaluationIJSP.cpp:151:		errorMsg += "Interval problems.";
EvaluationIJSP.cpp:152:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:153:	}
EvaluationIJSP.cpp:154:
EvaluationIJSP.cpp:155:	// Compute the makespan
EvaluationIJSP.cpp:156:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
EvaluationIJSP.cpp:157:		makespan = maximum(makespan, schedule->getCTJob(i), this->intervalMaximum);
EvaluationIJSP.cpp:158:	}
EvaluationIJSP.cpp:159:
EvaluationIJSP.cpp:160:	if (this->lamarckism)
EvaluationIJSP.cpp:161:		svars->encoder->encode(schedule, individual, svars);
EvaluationIJSP.cpp:162:	if (!individual->isPhenotypeUpdated())
EvaluationIJSP.cpp:163:		individual->updatePhenotype(schedule->clone());
EvaluationIJSP.cpp:164: 	return new FuzzyFW::FitnessInterval(makespan, false);
EvaluationIJSP.cpp:165:}
