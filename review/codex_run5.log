CreationIJSP.cpp:482:			for (unsigned int j = 0; j < numberOfTasks; j++) {
CreationIJSP.cpp:483:				jobRemainingTime[i] += fuzzyProb->getTask(fuzzyProb->getTaskId(i, j))->p;
CreationIJSP.cpp:484:			}
