Interval.cpp:276:	//=============================================================================
Interval.cpp:277:	//		METHODS
Interval.cpp:278:	//=============================================================================
Interval.cpp:279:	//====  Maximum/minimim methods  ==============================================
Interval.cpp:280:	Interval maximum(const Interval & x, const Interval & y, const Interval::Maximum mt) {
Interval.cpp:281:		Interval sol;
Interval.cpp:282:		switch (mt) {
Interval.cpp:283:
Interval.cpp:284:		case Interval::M_COMPONENT:
Interval.cpp:285:			sol.a = std::max(x.a, y.a);
Interval.cpp:286:			sol.b = std::max(x.b, y.b);
Interval.cpp:287:			break;
Interval.cpp:288:
Interval.cpp:289:		case Interval::M_EV:
Interval.cpp:290:			if (x.isGreaterThan(y, Interval::C_EV))
Interval.cpp:291:				sol = x;
Interval.cpp:292:			else sol = y;
Interval.cpp:293:			break;
Interval.cpp:294:
Interval.cpp:295:		case Interval::M_SAKAWA:
Interval.cpp:296:			if (x.isGreaterThan(y, Interval::C_SAKAWA))
Interval.cpp:297:				sol = x;
Interval.cpp:298:			else sol = y;
Interval.cpp:299:			break;
Interval.cpp:300:
Interval.cpp:301:		case Interval::M_JIANG:
Interval.cpp:302:			if (x.isGreaterThan(y, Interval::C_JIANG))
Interval.cpp:303:				sol = x;
Interval.cpp:304:			else sol = y;
Interval.cpp:305:			break;
Interval.cpp:306:		}
Interval.cpp:307:		return sol;
Interval.cpp:308:	}
Interval.cpp:309:
Interval.cpp:310:	Interval minimum(const Interval & x, const Interval & y, const Interval::Maximum mt) {
Interval.cpp:311:		Interval sol;
Interval.cpp:312:		switch (mt) {
Interval.cpp:313:
Interval.cpp:314:		case Interval::M_COMPONENT:
Interval.cpp:315:			sol.a = std::min(x.a, y.a);
Interval.cpp:316:			sol.b = std::min(x.b, y.b);
Interval.cpp:317:			break;
Interval.cpp:318:
Interval.cpp:319:		case Interval::M_EV:
Interval.cpp:320:			if (x.isLesserThan(y, Interval::C_EV))
Interval.cpp:321:				sol = x;
Interval.cpp:322:			else sol = y;
Interval.cpp:323:			break;
Interval.cpp:324:
Interval.cpp:325:		case Interval::M_SAKAWA:
Interval.cpp:326:			if (x.isLesserThan(y, Interval::C_SAKAWA))
Interval.cpp:327:				sol = x;
Interval.cpp:328:			else sol = y;
Interval.cpp:329:			break;
Interval.cpp:330:
Interval.cpp:331:		case Interval::M_JIANG:
Interval.cpp:332:			if (x.isLesserThan(y, Interval::C_JIANG))
Interval.cpp:333:				sol = x;
Interval.cpp:334:			else sol = y;
Interval.cpp:335:			break;
Interval.cpp:336:		}
Interval.cpp:337:		return sol;
Interval.cpp:338:	}
Interval.cpp:339:
Interval.cpp:340:
Interval.cpp:341:
Interval.cpp:342:	//====  Function expectedValue  ===============================================
Interval.cpp:343:	double Interval::expectedValue() const {
Interval.cpp:344:		return (this->a + this->b) / 2.0;
Interval.cpp:345:	}
Interval.cpp:346:
Interval.cpp:347:
Interval.cpp:348:
Interval.cpp:349:	//====  Membership function  ==================================================
Interval.cpp:350:	//TODO repasar esto
Interval.cpp:351:	double Interval::membership(const double r) const {
Interval.cpp:352:		double pivot = (this->a + this->b) / 2;
Interval.cpp:353:		if (compareDouble(r, this->a) <= 0
Interval.cpp:354:			|| compareDouble(r, this->b) >= 0)
Interval.cpp:355:			return 0.0;
Interval.cpp:356:		if (compareDouble(r, pivot) <= 0)
Interval.cpp:357:			return (r - this->a) / (pivot - this->a);
Interval.cpp:358:		return (r - this->b) / (pivot - this->b);
Interval.cpp:359:	}
Interval.cpp:360:
