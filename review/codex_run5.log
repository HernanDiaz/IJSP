CreationIJSP.cpp:488:				FuzzyFW::FitnessInterval(jobRemainingTime[i], false).isBetterThan(&(FuzzyFW::FitnessInterval(jobRemainingTime[jobOrderByRemainingTime[k]], false)))) {
CreationIJSP.cpp:489:				k++;
CreationIJSP.cpp:490:			}
CreationIJSP.cpp:491:			jobOrderByRemainingTime.insert(jobOrderByRemainingTime.begin() + k, i);
CreationIJSP.cpp:492:		}
CreationIJSP.cpp:493:	}
CreationIJSP.cpp:494:	// Build an array with repetitions
