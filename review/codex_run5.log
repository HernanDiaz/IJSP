CreationIJSP.cpp:639:		
CreationIJSP.cpp:640:		// Pass to the next task of the job
CreationIJSP.cpp:641:		
CreationIJSP.cpp:642:		//std::cout <<" count.size = "<< count.size() << std::endl;
CreationIJSP.cpp:643:		//std::cout << "Count= " << std::endl;
CreationIJSP.cpp:644:		//for (int i = 0; i < count.size(); i++) {
CreationIJSP.cpp:645:		//	std::cout << count[i] << " ";
CreationIJSP.cpp:646:		//}
CreationIJSP.cpp:647:		//std::cout << std::endl;
CreationIJSP.cpp:648:		
CreationIJSP.cpp:649:		//std::cout <<"count[rand]= "<< count[rand] << std::endl;
CreationIJSP.cpp:650:		//std::cout << (*fuzzyProb)[count[rand]]->js << std::endl;
CreationIJSP.cpp:651:		count[rand] = (*fuzzyProb)[count[rand]]->js;
CreationIJSP.cpp:652:		if (count[rand] < 0) {
CreationIJSP.cpp:653:			for (size_t i = rand + 1; i < count.size(); i++) {
CreationIJSP.cpp:654:				count[i - 1] = count[i];
CreationIJSP.cpp:655:				nextTaskTime[i - 1] = nextTaskTime[i];
CreationIJSP.cpp:656:			}
CreationIJSP.cpp:657:			for (size_t i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:658:				if (jobOrderByRemainingTime[i] > rand) {
CreationIJSP.cpp:659:					jobOrderByRemainingTime[i]--;
CreationIJSP.cpp:660:				}
CreationIJSP.cpp:661:			}
CreationIJSP.cpp:662:			nextTaskTime.pop_back();
CreationIJSP.cpp:663:			jobOrderByRemainingTime.erase(jobOrderByRemainingTime.begin() + k);
CreationIJSP.cpp:664:			count.pop_back();
CreationIJSP.cpp:665:		}
CreationIJSP.cpp:666:		else {
CreationIJSP.cpp:667:			// Update next task processing time
CreationIJSP.cpp:668:			nextTaskTime[rand] = (*fuzzyProb)[count[rand]]->p;
CreationIJSP.cpp:669:			// Update order of the jobs from higher to lower remaining time
CreationIJSP.cpp:670:			int job = jobOrderByRemainingTime[k];
CreationIJSP.cpp:671:			//std::cout << "Borrando trabajo " << job <<" en la posicicion "<<k<<std::endl;
CreationIJSP.cpp:672:			jobOrderByRemainingTime.erase(jobOrderByRemainingTime.begin()+k);
CreationIJSP.cpp:673:			//std::cout << "jobOrderByRemainingTime borrado" << std::endl;
CreationIJSP.cpp:674:			//for (int i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:675:			//	std::cout << jobOrderByRemainingTime[i] << " ";
CreationIJSP.cpp:676:			//}
CreationIJSP.cpp:677:			//std::cout << std::endl;
CreationIJSP.cpp:678:			//Order the jobs from higher to lower first task time
CreationIJSP.cpp:679:			int l = 0;
CreationIJSP.cpp:680:			while (l < jobOrderByRemainingTime.size() &&
CreationIJSP.cpp:681:				FuzzyFW::FitnessInterval(nextTaskTime[job], false).isBetterThan(&(FuzzyFW::FitnessInterval(nextTaskTime[jobOrderByRemainingTime[l]], false)))) {
CreationIJSP.cpp:682:				l++;
CreationIJSP.cpp:683:			}
CreationIJSP.cpp:684:			jobOrderByRemainingTime.insert(jobOrderByRemainingTime.begin() + l, job);
CreationIJSP.cpp:685:			//std::cout << "jobOrderByRemainingTime insertado" << std::endl;
CreationIJSP.cpp:686:			//for (int i = 0; i < jobOrderByRemainingTime.size(); i++) {
CreationIJSP.cpp:687:			//	std::cout << jobOrderByRemainingTime[i] << " ";
CreationIJSP.cpp:688:			//}
CreationIJSP.cpp:689:			//std::cout << std::endl;
CreationIJSP.cpp:690:		}
CreationIJSP.cpp:691:
CreationIJSP.cpp:692:	}
CreationIJSP.cpp:693:	sgs->buildSchedule(svars, permutation);
CreationIJSP.cpp:694:	indiv = svars->encoder->encode(sgs->getSchedule(), svars);
CreationIJSP.cpp:695:	indiv->updatePhenotype(sgs->getSchedule()->clone());
CreationIJSP.cpp:696:
CreationIJSP.cpp:697:	return indiv;
CreationIJSP.cpp:698:}
