CreationIJSP.h:1040:	//
CreationIJSP.h:1041:	//	Class CreationSeededSchedule
CreationIJSP.h:1042:	//
CreationIJSP.h:1043:	//=============================================================================
CreationIJSP.h:1044:	/**
CreationIJSP.h:1045:	 * Siembra la poblacion inicial con permutaciones de un pool (formato
CreationIJSP.h:1046:	 * "j1 j2 ... jN;[lower,upper]", trabajos 1-based) y rellena el resto aleatorio.
CreationIJSP.h:1047:	 *
CreationIJSP.h:1048:	 * Solo siembra en la creacion de la poblacion COMPLETA (popSize == population.size);
CreationIJSP.h:1049:	 * cualquier llamada parcial (abejas scout) se crea totalmente aleatoria, por lo que
CreationIJSP.h:1050:	 * el contador no se corrompe durante la evolucion.
CreationIJSP.h:1051:	 *
CreationIJSP.h:1052:	 * Asignacion de bloques por run (segun INSTRUCCIONES_PILOTO_TS.md): para el run r
CreationIJSP.h:1053:	 * con k = creation.seed.count sembrados, se toman las lineas
CreationIJSP.h:1054:	 * [(r*k) mod L, (r*k+k) mod L) con envoltura circular (L = tamano del pool).
CreationIJSP.h:1055:	 * runCounter se incrementa en cada creacion de poblacion completa.
CreationIJSP.h:1056:	 *
CreationIJSP.h:1057:	 * @author hdiaz (siembra RL)
CreationIJSP.h:1058:	 */
CreationIJSP.h:1059:	class CreationSeededSchedule : public FuzzyFW::Creation {
CreationIJSP.h:1060:	protected:
CreationIJSP.h:1061:		const std::string sgsLabel;
CreationIJSP.h:1062:		SGS_IJSP * sgs;
CreationIJSP.h:1063:		CreationRandomSchedule randomSchedule;   // para el relleno aleatorio y los scouts
CreationIJSP.h:1064:		unsigned int seedCount;                  // k sembrados por poblacion completa
CreationIJSP.h:1065:		unsigned int popSize;                    // tamano de la poblacion completa
CreationIJSP.h:1066:		std::vector< std::vector<int> > seedJobs;// secuencias de trabajos (1-based) del pool
CreationIJSP.h:1067:		mutable unsigned int runCounter;         // +1 por cada poblacion completa creada
CreationIJSP.h:1068:		unsigned int seedOffset;                 // indice global de la 1a ejecucion del proceso
CreationIJSP.h:1069:
CreationIJSP.h:1070:	public:
CreationIJSP.h:1071:		explicit CreationSeededSchedule(FuzzyFW::ParameterDB *parameters = NULL)
CreationIJSP.h:1072:			: sgsLabel(CREATION_SGS), sgs(NULL), Creation(parameters),
CreationIJSP.h:1073:			  seedCount(0), popSize(0), runCounter(0), seedOffset(0) { }
CreationIJSP.h:1074:
CreationIJSP.h:1075:		CreationSeededSchedule(const CreationSeededSchedule &source)
CreationIJSP.h:1076:			: Creation(source), sgsLabel(CREATION_SGS), sgs(NULL),
CreationIJSP.h:1077:			  randomSchedule(source.randomSchedule), seedCount(source.seedCount),
CreationIJSP.h:1078:			  popSize(source.popSize), seedJobs(source.seedJobs), runCounter(0),
CreationIJSP.h:1079:			  seedOffset(source.seedOffset) { }
CreationIJSP.h:1080:
CreationIJSP.h:1081:		virtual void setup(FuzzyFW::ParameterDB *parameters);
CreationIJSP.h:1082:
CreationIJSP.h:1083:		virtual Creation * clone() const {
CreationIJSP.h:1084:			return new CreationSeededSchedule(*this);
CreationIJSP.h:1085:		}
CreationIJSP.h:1086:
CreationIJSP.h:1087:		virtual ~CreationSeededSchedule() { }
CreationIJSP.h:1088:
CreationIJSP.h:1089:		virtual FuzzyFW::Individual * createIndividual(
CreationIJSP.h:1090:			const FuzzyFW::SharedVarsEvolutionary *svars) const;
CreationIJSP.h:1091:
CreationIJSP.h:1092:		virtual FuzzyFW::Population * createPopulation(
CreationIJSP.h:1093:			const unsigned int popSize,
CreationIJSP.h:1094:			const FuzzyFW::SharedVarsEvolutionary *svars) const;
CreationIJSP.h:1095:
CreationIJSP.h:1096:		virtual std::vector<std::string> getName() const {
CreationIJSP.h:1097:			std::vector<std::string> setup;
CreationIJSP.h:1098:			std::vector<std::string> sgsName = this->sgs->getName();
CreationIJSP.h:1099:			setup.push_back("Seeded");
CreationIJSP.h:1100:			setup.push_back(";SeedCount:;" + valueToString(this->seedCount));
CreationIJSP.h:1101:			setup.push_back(";PoolLines:;" + valueToString((int)this->seedJobs.size()));
CreationIJSP.h:1102:			setup.push_back(";SGS:;" + sgsName[0]);
CreationIJSP.h:1103:			for (size_t i = 1; i < sgsName.size(); i++)
CreationIJSP.h:1104:				setup.push_back(";" + sgsName[i]);
CreationIJSP.h:1105:			return setup;
CreationIJSP.h:1106:		}
CreationIJSP.h:1107:
CreationIJSP.h:1108:	protected:
CreationIJSP.h:1109:		// Construye un individuo a partir de una secuencia de trabajos (1-based)
CreationIJSP.h:1110:		FuzzyFW::Individual * buildFromJobPerm(
CreationIJSP.h:1111:			const std::vector<int> &jobs,
CreationIJSP.h:1112:			const FuzzyFW::SharedVarsEvolutionary *svars) const;
CreationIJSP.h:1113:	};
CreationIJSP.h:1114:}
