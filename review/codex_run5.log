Creation.cpp:22:	const SharedVarsEvolutionary *svars) const {
Creation.cpp:23:	Population * population = new Population();
Creation.cpp:24:	Individual *indiv;
Creation.cpp:25:
Creation.cpp:26:	for (unsigned int i = 0; i < popSize; i++) {
Creation.cpp:27:		indiv = this->createIndividual(svars);
Creation.cpp:28:		indiv->id = i;
Creation.cpp:29:		population->addIndividual(indiv);
Creation.cpp:30:	}
Creation.cpp:31:	return population;
Creation.cpp:32:}
