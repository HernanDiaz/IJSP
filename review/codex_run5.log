CreationIJSP.cpp:1033:		dynamic_cast<ProblemIJSP *>(svars->problem);
CreationIJSP.cpp:1034:	if (fuzzyProb == NULL) {
CreationIJSP.cpp:1035:		std::string errorMsg = "This enconding function works only with ";
