Interval.cpp:267:	//====  Equality (one component)  =============================================
Interval.cpp:268:	bool Interval::EqualComponent(const Interval t, const unsigned int component) const {
Interval.cpp:269:		if (component == 1) return (compareDouble(this->a, t.a) == 0);
Interval.cpp:270:		if (component == 2) return (compareDouble(this->b, t.b) == 0);
Interval.cpp:271:		return false;
Interval.cpp:272:	}
