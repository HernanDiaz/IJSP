CreationIJSP.cpp:23:void CreationRandomSchedule::setup(FuzzyFW::ParameterDB *parameters) {
CreationIJSP.cpp:24:	Creation::setup(parameters);
CreationIJSP.cpp:25:
CreationIJSP.cpp:26:	// Loads the SGS type to create
CreationIJSP.cpp:27:	std::string sgsType = parameters->getStringLower(this->sgsLabel);
CreationIJSP.cpp:28:	if (sgsType.length() == 0) {
CreationIJSP.cpp:29:		std::string errorMsg = "SGS not found. Please, specify a SGS to use";
CreationIJSP.cpp:30:		errorMsg += " during the evaluation of individuals";
CreationIJSP.cpp:31:		throw new IJSPException("Evaluation", errorMsg);
CreationIJSP.cpp:32:	}
CreationIJSP.cpp:33:	this->sgs = IJSPClassRegister::getSGSObject(sgsType);
CreationIJSP.cpp:34:	if (this->sgs == NULL) {
CreationIJSP.cpp:35:		std::string errorMsg = "The introduced SGS is not";
CreationIJSP.cpp:36:		errorMsg += " recognised: \'" + sgsType + "\'";
CreationIJSP.cpp:37:		throw new IJSPException("Evaluation", errorMsg);
CreationIJSP.cpp:38:	}
CreationIJSP.cpp:39:	this->sgs->setup(parameters);
CreationIJSP.cpp:40:}
