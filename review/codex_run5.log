CreationIJSP.cpp:47://-----  create Individual  ---------------------------------------------------
CreationIJSP.cpp:48:FuzzyFW::Individual * CreationRandomSchedule::createIndividual(
CreationIJSP.cpp:49:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:50:
CreationIJSP.cpp:51:	std::vector<int> permutation, count;
CreationIJSP.cpp:52:	int rand;
CreationIJSP.cpp:53:	FuzzyFW::Individual * indiv;
CreationIJSP.cpp:54:
CreationIJSP.cpp:55:	// Convert the problem type
CreationIJSP.cpp:56:	ProblemIJSP * fuzzyProb =
CreationIJSP.cpp:57:		dynamic_cast<ProblemIJSP *>(svars->problem);
CreationIJSP.cpp:58:	if (fuzzyProb == NULL) {
CreationIJSP.cpp:59:		std::string errorMsg = "This enconding function works only with ";
CreationIJSP.cpp:60:		errorMsg += "interval problems.";
CreationIJSP.cpp:61:		throw new IJSPException("Creation", errorMsg);
CreationIJSP.cpp:62:	}
CreationIJSP.cpp:63:
CreationIJSP.cpp:64:	// Find the first task of each job
CreationIJSP.cpp:65:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++)
CreationIJSP.cpp:66:		if (fuzzyProb->getNumberTasks(i) > 0)
CreationIJSP.cpp:67:			count.push_back(fuzzyProb->getTaskId(i, 0));
CreationIJSP.cpp:68:
CreationIJSP.cpp:69:	// Build an array with repetitions
CreationIJSP.cpp:70:	while (count.size() > 0) {
CreationIJSP.cpp:71:		rand = svars->rng->getInteger(0, count.size() - 1);
CreationIJSP.cpp:72:		permutation.push_back(count[rand]);
CreationIJSP.cpp:73:
CreationIJSP.cpp:74:		// Pass to the next task of the job
CreationIJSP.cpp:75:		count[rand] = (*fuzzyProb)[count[rand]]->js;
CreationIJSP.cpp:76:		if (count[rand] < 0) {
CreationIJSP.cpp:77:			for (size_t i = rand + 1; i < count.size(); i++)
CreationIJSP.cpp:78:				count[i - 1] = count[i];
CreationIJSP.cpp:79:			count.pop_back();
CreationIJSP.cpp:80:		}
CreationIJSP.cpp:81:	}
CreationIJSP.cpp:82:
CreationIJSP.cpp:83:	sgs->buildSchedule(svars, permutation);
CreationIJSP.cpp:84:	indiv = svars->encoder->encode(sgs->getSchedule(), svars);
CreationIJSP.cpp:85:	indiv->updatePhenotype(sgs->getSchedule()->clone());
CreationIJSP.cpp:86:
CreationIJSP.cpp:87:	return indiv;
CreationIJSP.cpp:88:}
