Interval.cpp:101:	//=============================================================================
Interval.cpp:102:	//		CONSTRUCTORS / INITIALIZERS
Interval.cpp:103:	//=============================================================================
Interval.cpp:104:	//====  Default constructor  ==================================================
Interval.cpp:105:	Interval::Interval() {
Interval.cpp:106:		a = b = 0;
Interval.cpp:107:	}
Interval.cpp:108:
Interval.cpp:109:
Interval.cpp:110:	//====  Main Constructor  =====================================================
Interval.cpp:111:	Interval::Interval(double a1, double a2) {
Interval.cpp:112:		this->a = a1;
Interval.cpp:113:		this->b = a2;
Interval.cpp:114:	}
Interval.cpp:115:
Interval.cpp:116:
Interval.cpp:117:	//====  Copy constructor  =====================================================
Interval.cpp:118:	Interval::Interval(const Interval & source) {
Interval.cpp:119:		this->a = source.a;
Interval.cpp:120:		this->b = source.b;
Interval.cpp:121:	}
Interval.cpp:122:	
Interval.cpp:123:
Interval.cpp:124:	//=============================================================================
Interval.cpp:125:	//		OPERATORS
Interval.cpp:126:	//=============================================================================
Interval.cpp:127:	//====  Addition/substraction component by component  =========================
Interval.cpp:128:	Interval Interval::operator+(const Interval &t) const {
Interval.cpp:129:		return Interval(this->a + t.a, this->b + t.b);
Interval.cpp:130:	}
Interval.cpp:131:
Interval.cpp:132:	Interval Interval::operator-(const Interval &t) const {
Interval.cpp:133:		return Interval(this->a - t.a, this->b - t.b);
Interval.cpp:134:	}
Interval.cpp:135:	
Interval.cpp:136:	//====  Asignment overload  ===================================================
Interval.cpp:137:	Interval & Interval::operator=(const Interval &t) {
Interval.cpp:138:		this->a = t.a;
Interval.cpp:139:		this->b = t.b;
Interval.cpp:140:		return *this;
Interval.cpp:141:	}
Interval.cpp:142:
Interval.cpp:143:	//====  Adition/Substraction + assignment  ====================================
Interval.cpp:144:	Interval & Interval::operator+=(const Interval &t) {
Interval.cpp:145:		this->a += t.a;
Interval.cpp:146:		this->b += t.b;
Interval.cpp:147:		return *this;
Interval.cpp:148:	}
Interval.cpp:149:	Interval & Interval::operator-=(const Interval &t) {
Interval.cpp:150:		this->a -= t.a;
Interval.cpp:151:		this->b -= t.b;
Interval.cpp:152:		return *this;
Interval.cpp:153:	}
Interval.cpp:154:
Interval.cpp:155:	//=============================================================================
Interval.cpp:156:	//		COMPARATORS
Interval.cpp:157:	//=============================================================================
Interval.cpp:158:	//====  Equality  =============================================================
Interval.cpp:159:	bool Interval::isEqualTo(const Interval t, const Compare cp) const {
Interval.cpp:160:		switch (cp) {
Interval.cpp:161:		case C_JIANG:
Interval.cpp:162:			// A = pdB iff P(A>=B) = 0.5
Interval.cpp:163:			return this->Lei2011Formula(t) == 0.5;
Interval.cpp:164:
Interval.cpp:165:		case C_COMPONENT:
Interval.cpp:166:		case C_LEX1:
Interval.cpp:167:		case C_LEX2:
Interval.cpp:168:			return (compareDouble(this->a, t.a) == 0
Interval.cpp:169:				&& compareDouble(this->b, t.b) == 0);
Interval.cpp:170:
Interval.cpp:171:		case C_EV:
Interval.cpp:172:			return (compareDouble(this->expectedValue(), t.expectedValue()) == 0);
Interval.cpp:173:
Interval.cpp:174:		case C_SAKAWA:
Interval.cpp:175:			return (compareDouble(this->expectedValue(), t.expectedValue()) == 0)
Interval.cpp:176:				&& (compareDouble(this->b - this->a, t.b - t.a) == 0);
Interval.cpp:177:		case C_YX:
Interval.cpp:178:			return (compareDouble(this->a+this->b, t.a+t.b) == 0)
Interval.cpp:179:				&& (compareDouble(this->b - this->a, t.b - t.a) == 0);
Interval.cpp:180:
Interval.cpp:181:		}
Interval.cpp:182:		throw new FuzzyFWException("Interval", "Comparison method unknown");
Interval.cpp:183:	}
Interval.cpp:184:
Interval.cpp:185:
Interval.cpp:186:	//====  Greater than  =========================================================
Interval.cpp:187:	bool Interval::isGreaterThan(const Interval t, const Compare cp) const {
Interval.cpp:188:		switch (cp) {
Interval.cpp:189:		case C_JIANG:
Interval.cpp:190:			//A > pdB iff P(A<=B) <0.5
Interval.cpp:191:			return this->Lei2011Formula(t) < 0.5;
Interval.cpp:192:
Interval.cpp:193:		case C_COMPONENT:
Interval.cpp:194:			return (compareDouble(this->a, t.a) > 0
Interval.cpp:195:				&& compareDouble(this->b, t.b) > 0);
Interval.cpp:196:
Interval.cpp:197:		case C_EV:
Interval.cpp:198:			return (compareDouble(this->expectedValue(), t.expectedValue()) > 0);
Interval.cpp:199:
Interval.cpp:200:		case C_SAKAWA:
Interval.cpp:201:			if (compareDouble(this->expectedValue(), t.expectedValue()) > 0)
Interval.cpp:202:				return true;
Interval.cpp:203:			return (compareDouble(this->expectedValue(), t.expectedValue()) == 0)
Interval.cpp:204:				&& (compareDouble(this->b - this->a, t.b - t.a) > 0);
Interval.cpp:205:		case C_LEX1: 
Interval.cpp:206:			return !(compareDouble(this->a, t.a) < 0 || ((compareDouble(this->a, t.a) == 0) && (compareDouble(this->b, t.b) <= 0)));
Interval.cpp:207:
Interval.cpp:208:		case C_LEX2:
Interval.cpp:209:			return !(compareDouble(this->b, t.b) < 0 || ((compareDouble(this->b, t.b) == 0) && (compareDouble(this->a, t.a) <= 0)));
Interval.cpp:210:			
Interval.cpp:211:		case C_YX: return !(compareDouble(this->a + this->b, t.a + t.b) < 0
Interval.cpp:212:			|| ((compareDouble(this->a + this->b, t.a + t.b) == 0) && (compareDouble(this->b - this->a, t.b - t.a) <= 0)));
Interval.cpp:213:
Interval.cpp:214:		}
Interval.cpp:215:		throw new FuzzyFWException("Interval", "Comparison method unknown");
Interval.cpp:216:	}
Interval.cpp:217:
Interval.cpp:218:
Interval.cpp:219:	//====  Greater or equal to  ==================================================
Interval.cpp:220:	bool Interval::isGreaterEqualTo(const Interval t, const Compare cp) const {
Interval.cpp:221:		switch (cp) {
Interval.cpp:222:
Interval.cpp:223:		case C_JIANG:
Interval.cpp:224:			//A > pdB iff P(A>=B) < 0.5 && A = pdB iff P(A>=B) = 0.5
Interval.cpp:225:			return this->Lei2011Formula(t) <= 0.5;
Interval.cpp:226:			
Interval.cpp:227:		case C_COMPONENT:
Interval.cpp:228:			return (compareDouble(this->a, t.a) >= 0
Interval.cpp:229:				&& compareDouble(this->b, t.b) >= 0);
Interval.cpp:230:
Interval.cpp:231:		case C_EV:
Interval.cpp:232:			return (compareDouble(this->expectedValue(), t.expectedValue()) >= 0);
Interval.cpp:233:
Interval.cpp:234:		case C_SAKAWA:
Interval.cpp:235:			if (compareDouble(this->expectedValue(), t.expectedValue()) > 0)
Interval.cpp:236:				return true;
Interval.cpp:237:			return (compareDouble(this->expectedValue(), t.expectedValue()) == 0)
Interval.cpp:238:				&& (compareDouble(this->b - this->a, t.b - t.a) >= 0);
Interval.cpp:239:
Interval.cpp:240:		case C_LEX1: return !(compareDouble(this->a, t.a) < 0
Interval.cpp:241:			|| ((compareDouble(this->a, t.a) == 0) && (compareDouble(this->b, t.b) < 0)));
Interval.cpp:242:			
Interval.cpp:243:		case C_LEX2:return !(compareDouble(this->b, t.b) < 0
Interval.cpp:244:			|| ((compareDouble(this->b, t.b) == 0) && (compareDouble(this->a, t.a) < 0)));
Interval.cpp:245:
Interval.cpp:246:		case C_YX: return !(compareDouble(this->a+this->b, t.a+t.b) < 0
Interval.cpp:247:			|| ((compareDouble(this->a + this->b, t.a + t.b) == 0) && (compareDouble(this->b-this->a, t.b-t.a) < 0)));
Interval.cpp:248:
Interval.cpp:249:		}
Interval.cpp:250:		throw new FuzzyFWException("Interval", "Comparison method unknown");
Interval.cpp:251:	}
Interval.cpp:252:
Interval.cpp:253:
Interval.cpp:254:	//====  Lesser than  ==========================================================
Interval.cpp:255:	bool Interval::isLesserThan(const Interval t, const Compare cp) const {
Interval.cpp:256:		return !isGreaterEqualTo(t, cp);
Interval.cpp:257:	}
Interval.cpp:258:
Interval.cpp:259:
Interval.cpp:260:	//====  Lesser or equal to  ===================================================
Interval.cpp:261:	bool Interval::isLesserEqualTo(const Interval t, const Compare cp) const {
Interval.cpp:262:		return !isGreaterThan(t, cp);
Interval.cpp:263:	}
