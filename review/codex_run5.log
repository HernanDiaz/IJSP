Interval.cpp:399:	//====  Input Operator  =======================================================
Interval.cpp:400:	std::ifstream & operator >> (std::ifstream & is, Interval & t)
Interval.cpp:401:	{
Interval.cpp:402:		char c;
Interval.cpp:403:		double d;
Interval.cpp:404:		//Load data from triangular fuzzy problems
Interval.cpp:405:		//is >> c >> t.a >> c >> d >> c >> t.b >> c;
Interval.cpp:406:		//Load data from interval problems
Interval.cpp:407:		is >> c >> t.a >> c >> t.b >> c;
Interval.cpp:408:
Interval.cpp:409:		/*
Interval.cpp:410:		t.a = t.a * 10;
Interval.cpp:411:		t.b = t.b * 10;
Interval.cpp:412:		*/
Interval.cpp:413:		
Interval.cpp:414:		//CRISP Intervals -1
Interval.cpp:415:		/*
Interval.cpp:416:		t.a = (t.a + t.b) / 2;
Interval.cpp:417:		t.b = t.a;
Interval.cpp:418:		*/
Interval.cpp:419:		/*
Interval.cpp:420:		//0.2
Interval.cpp:421:		double diff = t.b - t.a;
Interval.cpp:422:		t.a -= diff * 0.1;
Interval.cpp:423:		t.b += diff * 0.1;
Interval.cpp:424:		*/
Interval.cpp:425:		/*
Interval.cpp:426:		//0.4
Interval.cpp:427:		double diff = t.b - t.a;
Interval.cpp:428:		t.a -= diff * 0.2;
Interval.cpp:429:		t.b += diff * 0.2;
Interval.cpp:430:		*/
Interval.cpp:431:
Interval.cpp:432:		if (t.a < 0) {
Interval.cpp:433:			t.a = 0;
Interval.cpp:434:		}
Interval.cpp:435:		
Interval.cpp:436:		return is;
Interval.cpp:437:	}
Interval.cpp:438:
Interval.cpp:439:	//====  Output Operator  ======================================================
Interval.cpp:440:	std::ostream & operator << (std::ostream & os, const Interval & t)
Interval.cpp:441:	{
Interval.cpp:442:		os << "(" << t.a << ", " << t.b << ")";
Interval.cpp:443:		return os;
Interval.cpp:444:	}
