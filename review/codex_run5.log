Interval.cpp:362:	//====  Funcion toString  =====================================================
Interval.cpp:363:	std::string Interval::toString() const {
Interval.cpp:364:		return "(" + valueToString(this->a) + ", " + valueToString(this->b) + ")";
Interval.cpp:365:	}
Interval.cpp:366:
Interval.cpp:367:	double Interval::Lei2011Formula(const Interval & t) const
Interval.cpp:368:	{
Interval.cpp:369:		//i) Al >= Br
Interval.cpp:370:		if (compareDouble(this->a, t.b) >= 0) return 0;
Interval.cpp:371:		//vi) Ar <= Bl
Interval.cpp:372:		if (compareDouble(this->b, t.a) <= 0) return 1;
Interval.cpp:373:		else {
Interval.cpp:374:			double longA = this->b - this->a;
Interval.cpp:375:			double longB = t.b - t.a;
Interval.cpp:376:
Interval.cpp:377:			//ii) Bl <= Al < Br <= Ar
Interval.cpp:378:
Interval.cpp:379:			if (compareDouble(t.a, this->a) <= 0) {
Interval.cpp:380:				if (compareDouble(t.b, this->b) <= 0)
Interval.cpp:381:					return (0.5* ((t.b - this->a) / longA)*((t.b - this->a) / longB));
Interval.cpp:382:				//v) Bl <= Al < Ar < Br
Interval.cpp:383:				return (((t.b - this->b) / longB) + 0.5 * longA / longB);
Interval.cpp:384:			}
Interval.cpp:385:			//iv) Al < Bl <= Ar < Br
Interval.cpp:386:			if (compareDouble(this->b, t.b) < 0)
Interval.cpp:387:				return ((t.a - this->a) / longA) + (((this->b - t.a) / longA)*((t.b - this->b) / longB))
Interval.cpp:388:				+ 0.5*((this->b - t.a) / longA)*((this->b - t.a) / longB);
Interval.cpp:389:			//iii) Al < Bl < Br <= Ar
Interval.cpp:390:			return (((t.a - this->a) / longA) + 0.5 * longB / longA);
Interval.cpp:391:		}
Interval.cpp:392:	}
