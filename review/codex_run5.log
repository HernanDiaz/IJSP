CreationIJSP.cpp:107:	if (sgsType.length() == 0) {
CreationIJSP.cpp:108:		std::string errorMsg = "SGS not found. Please, specify a SGS to use";
CreationIJSP.cpp:109:		errorMsg += " during the evaluation of individuals";
