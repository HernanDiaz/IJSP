CreationIJSP.cpp:1419:FuzzyFW::Individual * CreationSeededSchedule::createIndividual(
CreationIJSP.cpp:1420:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:1421:	return this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:1422:}
CreationIJSP.cpp:1423:
CreationIJSP.cpp:1424:
CreationIJSP.cpp:1425://-----  create Population  ---------------------------------------------------
CreationIJSP.cpp:1426:FuzzyFW::Population * CreationSeededSchedule::createPopulation(
CreationIJSP.cpp:1427:	const unsigned int reqSize,
CreationIJSP.cpp:1428:	const FuzzyFW::SharedVarsEvolutionary *svars) const {
CreationIJSP.cpp:1429:
CreationIJSP.cpp:1430:	// Llamadas parciales (abejas scout) o siembra desactivada -> todo aleatorio
CreationIJSP.cpp:1431:	if (reqSize != this->popSize || this->seedCount == 0 || this->seedJobs.empty()) {
CreationIJSP.cpp:1432:		return FuzzyFW::Creation::createPopulation(reqSize, svars);
CreationIJSP.cpp:1433:	}
CreationIJSP.cpp:1434:
CreationIJSP.cpp:1435:	FuzzyFW::Population * population = new FuzzyFW::Population();
CreationIJSP.cpp:1436:	unsigned int L = (unsigned int)this->seedJobs.size();
CreationIJSP.cpp:1437:	unsigned int nSeed = (this->seedCount < reqSize) ? this->seedCount : reqSize;
CreationIJSP.cpp:1438:	// El bloque depende del indice GLOBAL de ejecucion, no del contador local del
CreationIJSP.cpp:1439:	// proceso: asi 30 ejecuciones seguidas y 6 procesos de 5 asignan las mismas
CreationIJSP.cpp:1440:	// semillas. Sin esto, cada proceso reinicia en 0 y repite los mismos bloques.
CreationIJSP.cpp:1441:	unsigned int globalRun = this->seedOffset + this->runCounter;
CreationIJSP.cpp:1442:	unsigned int blockStart = (globalRun * this->seedCount) % L;
CreationIJSP.cpp:1443:
CreationIJSP.cpp:1444:	for (unsigned int i = 0; i < reqSize; i++) {
CreationIJSP.cpp:1445:		FuzzyFW::Individual * indiv;
CreationIJSP.cpp:1446:		if (i < nSeed) {
CreationIJSP.cpp:1447:			unsigned int idx = (blockStart + i) % L;
CreationIJSP.cpp:1448:			indiv = this->buildFromJobPerm(this->seedJobs[idx], svars);
CreationIJSP.cpp:1449:		} else {
CreationIJSP.cpp:1450:			indiv = this->randomSchedule.createIndividual(svars);
CreationIJSP.cpp:1451:		}
CreationIJSP.cpp:1452:		indiv->id = i;
CreationIJSP.cpp:1453:		population->addIndividual(indiv);
CreationIJSP.cpp:1454:	}
CreationIJSP.cpp:1455:
CreationIJSP.cpp:1456:	this->runCounter++;
CreationIJSP.cpp:1457:	return population;
CreationIJSP.cpp:1458:}
CreationIJSP.cpp:1459:}

