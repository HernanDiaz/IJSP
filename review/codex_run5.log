EvaluationIJSP.cpp:84:FuzzyFW::Objective * EvaluationIJSP_Makespan::getObjectiveFunction(
EvaluationIJSP.cpp:85:	const FuzzyFW::SharedVarsEvolutionary * const svars,
EvaluationIJSP.cpp:86:	FuzzyFW::Individual *individual) const {
EvaluationIJSP.cpp:87:
EvaluationIJSP.cpp:88:	FuzzyFW::Solution * solution;
EvaluationIJSP.cpp:89:	ScheduleIJSP * schedule;
EvaluationIJSP.cpp:90:	ProblemIJSP *fuzzyProb;
EvaluationIJSP.cpp:91:	FuzzyFW::Interval makespan = FuzzyFW::Interval(0, 0);
EvaluationIJSP.cpp:92:
EvaluationIJSP.cpp:93:	// Evaluate the individual to find the phenotype
EvaluationIJSP.cpp:94:	if (individual->isPhenotypeUpdated())
EvaluationIJSP.cpp:95:		solution = individual->getPhenotype();
EvaluationIJSP.cpp:96:	else
EvaluationIJSP.cpp:97:		solution = svars->decoder->decode(individual, svars);
EvaluationIJSP.cpp:98:
EvaluationIJSP.cpp:99:	schedule = dynamic_cast<ScheduleIJSP *>(solution);
EvaluationIJSP.cpp:100:	if (schedule == NULL) {
EvaluationIJSP.cpp:101:		std::string errorMsg = "This evaluation function is valid only ";
EvaluationIJSP.cpp:102:		errorMsg += "for Interval Job Shop Problems.";
EvaluationIJSP.cpp:103:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:104:	}
EvaluationIJSP.cpp:105:
EvaluationIJSP.cpp:106:	fuzzyProb =
EvaluationIJSP.cpp:107:		dynamic_cast<ProblemIJSP *>(svars->problem);
EvaluationIJSP.cpp:108:	if (fuzzyProb == NULL) {
EvaluationIJSP.cpp:109:		std::string errorMsg = "This evaluation function works only with ";
EvaluationIJSP.cpp:110:		errorMsg += "Interval problems.";
EvaluationIJSP.cpp:111:		throw new IJSPException("Evaluation", errorMsg);
EvaluationIJSP.cpp:112:	}
EvaluationIJSP.cpp:113:
EvaluationIJSP.cpp:114:	// Compute the makespan
EvaluationIJSP.cpp:115:	for (unsigned int i = 0; i < fuzzyProb->getNumberJobs(); i++) {
EvaluationIJSP.cpp:116:		makespan = maximum(makespan, schedule->getCTJob(i), this->intervalMaximum);
EvaluationIJSP.cpp:117:	}
EvaluationIJSP.cpp:118:
EvaluationIJSP.cpp:119:	return new FuzzyFW::FitnessInterval(makespan, false);
EvaluationIJSP.cpp:120:}
