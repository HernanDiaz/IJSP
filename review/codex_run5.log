CreationIJSP.cpp:713:
CreationIJSP.cpp:714:	// Loads the SGS type to create
CreationIJSP.cpp:715:	std::string sgsType = parameters->getStringLower(this->sgsLabel);
CreationIJSP.cpp:716:	if (sgsType.length() == 0) {
CreationIJSP.cpp:717:		std::string errorMsg = "SGS not found. Please, specify a SGS to use";
CreationIJSP.cpp:718:		errorMsg += " during the evaluation of individuals";
CreationIJSP.cpp:719:		throw new IJSPException("Evaluation", errorMsg);
CreationIJSP.cpp:720:	}
CreationIJSP.cpp:721:	this->sgs = IJSPClassRegister::getSGSObject(sgsType);
