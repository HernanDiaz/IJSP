CreationIJSP.cpp:511:			jobOrderByRemainingTime[k] = jobOrderByRemainingTime[k + 1];
CreationIJSP.cpp:512:			jobOrderByRemainingTime[k + 1] = aux;
CreationIJSP.cpp:513:			k++;
CreationIJSP.cpp:514:		}
CreationIJSP.cpp:515:		// Pass to the next task of the job
