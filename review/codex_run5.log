SGS_IJSP_Insertion.cpp:24:	//=====  Build schedule  ======================================================
SGS_IJSP_Insertion.cpp:25:	ScheduleIJSP * SGS_IJSP_Insertion::buildSchedule(
SGS_IJSP_Insertion.cpp:26:		const FuzzyFW::SharedVars * svars, std::vector<int> &order) {
SGS_IJSP_Insertion.cpp:27:
SGS_IJSP_Insertion.cpp:28:		if (svars->problem == NULL)
SGS_IJSP_Insertion.cpp:29:			throw new IJSPException("SGS", "Problem instance not created");
SGS_IJSP_Insertion.cpp:30:
SGS_IJSP_Insertion.cpp:31:		ProblemIJSP * fjspProb =
SGS_IJSP_Insertion.cpp:32:			dynamic_cast<ProblemIJSP *>(svars->problem);
SGS_IJSP_Insertion.cpp:33:		if (fjspProb == NULL) {
SGS_IJSP_Insertion.cpp:34:			std::string errorMsg = "This SGS can be only used on Interval Problems.";
SGS_IJSP_Insertion.cpp:35:			throw new IJSPException("SGS", errorMsg);
SGS_IJSP_Insertion.cpp:36:		}
SGS_IJSP_Insertion.cpp:37:
SGS_IJSP_Insertion.cpp:38:		if (this->isCreated)
SGS_IJSP_Insertion.cpp:39:			this->schedule->reset();
SGS_IJSP_Insertion.cpp:40:		else {
SGS_IJSP_Insertion.cpp:41:			this->schedule = new ScheduleIJSP(fjspProb);
SGS_IJSP_Insertion.cpp:42:			this->isCreated = true;
SGS_IJSP_Insertion.cpp:43:		}
SGS_IJSP_Insertion.cpp:44:
SGS_IJSP_Insertion.cpp:45:		for (size_t i = 0; i < order.size(); i++) {
SGS_IJSP_Insertion.cpp:46:			this->scheduleTask((*fjspProb)[order[i]], order[i]);
SGS_IJSP_Insertion.cpp:47:		}
SGS_IJSP_Insertion.cpp:48:		this->schedule->verifyScheduling();
SGS_IJSP_Insertion.cpp:49:
SGS_IJSP_Insertion.cpp:50:		return this->schedule;
SGS_IJSP_Insertion.cpp:51:	}
SGS_IJSP_Insertion.cpp:52:
SGS_IJSP_Insertion.cpp:53:
SGS_IJSP_Insertion.cpp:54:	//=====  Schedule a task  =====================================================
SGS_IJSP_Insertion.cpp:55:	FuzzyFW::Interval SGS_IJSP_Insertion::scheduleTask(const TaskIJSP *task,
SGS_IJSP_Insertion.cpp:56:		const int taskIdx) {
SGS_IJSP_Insertion.cpp:57:
SGS_IJSP_Insertion.cpp:58:		int mp, ms; // Machine predecessor and successor
SGS_IJSP_Insertion.cpp:59:		FuzzyFW::Interval Stime;	// Starting time
SGS_IJSP_Insertion.cpp:60:		FuzzyFW::Interval mtHead, mtPT;
SGS_IJSP_Insertion.cpp:61:		char found;	// Big gap found in the schedule
SGS_IJSP_Insertion.cpp:62:		// Maxims are made component by component
SGS_IJSP_Insertion.cpp:63:		FuzzyFW::Interval::Maximum maxComp = FuzzyFW::Interval::M_COMPONENT;
SGS_IJSP_Insertion.cpp:64:
SGS_IJSP_Insertion.cpp:65:		int mac = task->machine;
SGS_IJSP_Insertion.cpp:66:		int job = task->job;
SGS_IJSP_Insertion.cpp:67:
SGS_IJSP_Insertion.cpp:68:		// Check if this task can be scheduled
SGS_IJSP_Insertion.cpp:69:		if (task->jp != this->schedule->lastTaskJob[job]) {
SGS_IJSP_Insertion.cpp:70:			std::string errorMsg;
SGS_IJSP_Insertion.cpp:71:			errorMsg = "Job precedence constraint is being violated. Scheduling ";
SGS_IJSP_Insertion.cpp:72:			errorMsg += "task " + valueToString(taskIdx) + " after task ";
SGS_IJSP_Insertion.cpp:73:			errorMsg += valueToString(this->schedule->lastTaskJob[job]);
SGS_IJSP_Insertion.cpp:74:			throw new IJSPException("SGS", errorMsg);
SGS_IJSP_Insertion.cpp:75:		}
SGS_IJSP_Insertion.cpp:76:
SGS_IJSP_Insertion.cpp:77:		// If I could schedule the task just after its job predecessor, who
SGS_IJSP_Insertion.cpp:78:		// would be the machine predecessor and successors...
SGS_IJSP_Insertion.cpp:79:		Stime = this->schedule->getCTJob(job);
SGS_IJSP_Insertion.cpp:80:		ms = -1;
SGS_IJSP_Insertion.cpp:81:		mp = this->schedule->lastTaskMachine[mac];
SGS_IJSP_Insertion.cpp:82:		if (mp != -1)
SGS_IJSP_Insertion.cpp:83:			mtHead = this->schedule->taskInfo[mp].head;
SGS_IJSP_Insertion.cpp:84:
SGS_IJSP_Insertion.cpp:85:		while (mp != -1 && mtHead.isGreaterEqualTo(Stime, this->cpComp)) {
SGS_IJSP_Insertion.cpp:86:			ms = mp;
SGS_IJSP_Insertion.cpp:87:			mp = this->schedule->taskInfo[ms].mp;
SGS_IJSP_Insertion.cpp:88:			if (mp != -1)
SGS_IJSP_Insertion.cpp:89:				mtHead = this->schedule->taskInfo[mp].head;
SGS_IJSP_Insertion.cpp:90:		}
SGS_IJSP_Insertion.cpp:91:
SGS_IJSP_Insertion.cpp:92:		// Update the heuristic Starting time that task could take
SGS_IJSP_Insertion.cpp:93:		if (mp != -1) {
SGS_IJSP_Insertion.cpp:94:			mtHead = this->schedule->taskInfo[mp].head;
SGS_IJSP_Insertion.cpp:95:			mtPT = this->schedule->taskInfo[mp].task->p;
SGS_IJSP_Insertion.cpp:96:			Stime = maximum(Stime, mtHead + mtPT, maxComp);
SGS_IJSP_Insertion.cpp:97:		}
SGS_IJSP_Insertion.cpp:98:
SGS_IJSP_Insertion.cpp:99:
SGS_IJSP_Insertion.cpp:100:		// Look for the actual minimum starting time for the task
SGS_IJSP_Insertion.cpp:101:		
SGS_IJSP_Insertion.cpp:102:		found = false;
SGS_IJSP_Insertion.cpp:103:		while (!found && ms != -1) {
SGS_IJSP_Insertion.cpp:104:			mtHead = this->schedule->taskInfo[ms].head;
SGS_IJSP_Insertion.cpp:105:			mtPT = this->schedule->taskInfo[ms].task->p;
SGS_IJSP_Insertion.cpp:106:
SGS_IJSP_Insertion.cpp:107:			if (mtHead.isGreaterEqualTo(Stime + task->p, this->cpComp))
SGS_IJSP_Insertion.cpp:108:				found = true;
SGS_IJSP_Insertion.cpp:109:			else {
SGS_IJSP_Insertion.cpp:110:				mp = ms;
SGS_IJSP_Insertion.cpp:111:				Stime = maximum(Stime, mtHead + mtPT, maxComp);
SGS_IJSP_Insertion.cpp:112:				ms = this->schedule->taskInfo[mp].ms;
SGS_IJSP_Insertion.cpp:113:			}
SGS_IJSP_Insertion.cpp:114:		}
SGS_IJSP_Insertion.cpp:115:
SGS_IJSP_Insertion.cpp:116:		// Update the schedule
SGS_IJSP_Insertion.cpp:117:		this->schedule->addTask(taskIdx, Stime, ms);
SGS_IJSP_Insertion.cpp:118:
SGS_IJSP_Insertion.cpp:119:		// Repair schedule
SGS_IJSP_Insertion.cpp:120:		this->schedule->repairScheduledTimes(taskIdx);
SGS_IJSP_Insertion.cpp:121:
SGS_IJSP_Insertion.cpp:122:		return Stime;
SGS_IJSP_Insertion.cpp:123:	}
SGS_IJSP_Insertion.cpp:124:
SGS_IJSP_Insertion.cpp:125:}
