  psig <- numeric(0); pperm <- numeric(0); filas <- list()
  for (a in seeded) {
    dif <- Tm[, a] - Tm[, "A0"]
    antes <- sum(dif < 0); desp <- sum(dif > 0); emp <- sum(dif == 0)
    # Test de signos CALIBRADO: la hipotesis nula no es 0.5 sino la proporcion
