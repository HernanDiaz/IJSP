CreationIJSP.cpp:1126:			count.pop_back();
CreationIJSP.cpp:1127:		}
CreationIJSP.cpp:1128:
CreationIJSP.cpp:1129:	}
CreationIJSP.cpp:1130:	sgs->buildSchedule(svars, permutation);
CreationIJSP.cpp:1131:	indiv = svars->encoder->encode(sgs->getSchedule(), svars);
