# Within COR_Tabu, exclude data (CSVs) but keep source, figures and scripts
Papers/COR_Tabu/data/

# Word / Office documents
*.docx
*.xlsx

# Dataset zip (lives on Zenodo, too big for GitHub)
Papers/COR_Tabu/IJSP_dataset_2026.zip
Papers/COR_Tabu/IJSP_dataset_2026.zip.preBugfix2

# IPRTS experiments: raw run logs stay local (summaries/aggregates are tracked)
experiments/iprts_2026/results/*/

# Statistical result CSVs from older / unrelated experiments
# (the paper-relevant statistical_results_exp4/ CSVs are kept tracked
#  because they are small (~740 KB) and let the paper's analysis be
#  reproduced without re-running the full study)
experiments/statistical_results_exp7/*.csv
experiments/statistical_results_exp8/*.csv
experiments/statistical_results_exp9/*.csv
